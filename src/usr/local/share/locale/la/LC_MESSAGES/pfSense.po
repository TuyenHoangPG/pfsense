msgstr "ສຳເນົາ MAC ຂອງຂ້ອຍ"

#: src/usr/local/www/services_dhcp_edit.php:481
msgid "MAC address (6 hex octets separated by colons)"
msgstr "ທີ່ຢູ່ MAC (6 hex octets ແຍກດ້ວຍຈໍ້າ)"

