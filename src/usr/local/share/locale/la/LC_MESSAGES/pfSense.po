#: src/usr/local/www/vpn_openvpn_server.php:1394
#, php-format
msgid "Exit or restart OpenVPN after timeout from remote%1$s"
msgstr "ອອກ ຫຼື restart OpenVPN ຫຼັງຈາກໝົດເວລາຈາກຫ່າງໄກ%1$s"

#: src/usr/local/www/vpn_openvpn_client.php:1072
