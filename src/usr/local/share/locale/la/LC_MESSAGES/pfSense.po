msgstr "ອັດຕາ conn src ສູງສຸດ"

#: src/usr/local/www/firewall_rules_edit.php:1649
msgid "/ per how many second(s) (TCP only)"
msgstr "/ ຕໍ່ຈັກວິນາທີ (TCP ເທົ່ານັ້ນ)"

#: src/usr/local/www/firewall_rules_edit.php:1653
