msgid "A valid MAC address must be specified."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ MAC ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/services_dhcp_edit.php:214
msgid "Static ARP is enabled.  An IP address must be specified."
msgstr "Static ARP ເປີດใช้งานຢູ່. ຕ້ອງລະບຸທີ່ຢູ່ IP."

#: src/usr/local/www/services_dhcp_edit.php:224
msgid "This MAC address or Client identifier already exists."
msgstr "ທີ່ຢູ່ MAC ນີ້ ຫຼືຕົວລະບຸລູກຄ້າແມ່ນມີຢູ່ແລ້ວ."

#: src/usr/local/www/services_dhcp_edit.php:232
#, php-format
msgid "The IP address must not be within the DHCP range for this interface."
msgstr "ທີ່ຢູ່ IP ຕ້ອງບໍ່ຢູ່ໃນຂອບເຂດ DHCP ສຳລັບອິນເຕີເຟດນີ້."

#: src/usr/local/www/services_dhcp_edit.php:237
msgid ""
"The IP address must not be within the range configured on a DHCP pool for "
"this interface."
msgstr ""
"ທີ່ຢູ່ IP ຕ້ອງບໍ່ຢູ່ໃນຂອບເຂດທີ່ຕັ້ງຄ່າໄວ້ໃນສະນຸກເກີ DHCP ສຳລັບອິນເຕີເຟດນີ້."

#: src/usr/local/www/services_dhcp_edit.php:245
#, php-format
msgid "The IP address must lie in the %s subnet."
msgstr "ທີ່ຢູ່ IP ຕ້ອງຢູ່ໃນ subnet %s."

#: src/usr/local/www/services_dhcp_edit.php:249
#, php-format
msgid "The IP address cannot be the %s network address."
msgstr "ທີ່ຢູ່ IP ບໍ່ສາມາດເປັນທີ່ຢູ່ເຄືອຂ່າຍ %s ໄດ້."

#: src/usr/local/www/services_dhcp_edit.php:253
#, php-format
msgid "The IP address cannot be the %s broadcast address."
msgstr "ທີ່ຢູ່ IP ບໍ່ສາມາດເປັນທີ່ຢູ່ອອກອາກາດ %s ໄດ້."

#: src/usr/local/www/services_dhcp_edit.php:258
msgid "A valid IPv4 address must be specified for the gateway."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv4 ທີ່ຖືກຕ້ອງສຳລັບ gateway."

#: src/usr/local/www/services_dhcp_edit.php:261
msgid ""
"A valid IPv4 address must be specified for the primary/secondary WINS "
"servers."
msgstr ""
"ຕ້ອງລະບຸທີ່ຢູ່ IPv4 ທີ່ຖືກຕ້ອງສຳລັບເຊີບເວີ WINS ຫຼັກ/ຮອງ."

#: src/usr/local/www/services_dhcp_edit.php:275
msgid "A valid IPV4 address must be specified for each of the DNS servers."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv4 ທີ່ຖືກຕ້ອງສຳລັບເຊີບເວີ DNS ແຕ່ລະອັນ."

#: src/usr/local/www/services_dhcp_edit.php:323
msgid ""
"A valid IPv4 address, hostname or URL must be specified for the TFTP server."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv4, ຊື່ໂຮສ ຫຼື URL ທີ່ຖືກຕ້ອງສຳລັບເຊີບເວີ TFTP."

#: src/usr/local/www/services_dhcp_edit.php:326
msgid "A valid IPv4 address must be specified for the network boot server."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv4 ທີ່ຖືກຕ້ອງສຳລັບເຊີບເວີ network boot."

#: src/usr/local/www/services_dhcp_edit.php:329
msgid "A valid MAC address must be specified for use with static ARP."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ MAC ທີ່ຖືກຕ້ອງສຳລັບໃຊ້ກັບ static ARP."

#: src/usr/local/www/services_dhcp_edit.php:332
msgid "A valid IPv4 address must be specified for use with static ARP."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv4 ທີ່ຖືກຕ້ອງສຳລັບໃຊ້ກັບ static ARP."

#: src/usr/local/www/services_dhcp_edit.php:445
#: src/usr/local/www/services_dhcpv6_edit.php:187
