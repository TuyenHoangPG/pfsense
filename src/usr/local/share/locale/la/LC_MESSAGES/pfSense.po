msgid "*Server address"
msgstr "*ທີ່ຢູ່ເຊີບເວີ."


#: src/usr/local/www/vpn_l2tp.php:253
#, php-format
msgid ""
"Enter the IP address the L2TP server should give to clients for use as their "
