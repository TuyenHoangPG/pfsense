#: src/usr/local/www/vpn_ipsec_mobile.php:220
msgid "A valid value for 'DNS Default Domain' must be specified."
msgstr "ຕ້ອງລະບຸຄ່າທີ່ຖືກຕ້ອງສຳລັບ 'DNS Default Domain'."

#: src/usr/local/www/vpn_ipsec_mobile.php:230
msgid "A valid split DNS domain list must be specified."
msgstr "ຕ້ອງລະບຸລາຍຊື່ໂດເມນ Split DNS ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/vpn_ipsec_mobile.php:240
msgid ""
"At least one DNS server must be specified to enable the DNS Server option."
msgstr "ຕ້ອງລະບຸ DNS Server ຢ່າງໜ້ອຍໜຶ່ງເພື່ອເປີດໃຊ້ງານຕົວເລືອກ DNS Server."

#: src/usr/local/www/vpn_ipsec_mobile.php:244
msgid "A valid IP address for 'DNS Server #1' must be specified."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ທີ່ຖືກຕ້ອງສຳລັບ 'DNS Server #1'."

#: src/usr/local/www/vpn_ipsec_mobile.php:248
msgid "A valid IP address for 'DNS Server #2' must be specified."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ທີ່ຖືກຕ້ອງສຳລັບ 'DNS Server #2'."

#: src/usr/local/www/vpn_ipsec_mobile.php:252
msgid "A valid IP address for 'DNS Server #3' must be specified."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ທີ່ຖືກຕ້ອງສຳລັບ 'DNS Server #3'."


#: src/usr/local/www/vpn_ipsec_mobile.php:256
msgid "A valid IP address for 'DNS Server #4' must be specified."
msgstr "ຕ້ອງກຳນົດທີ່ຢູ່ IP ທີ່ຖືກຕ້ອງສໍາລັບ 'DNS Server #4'"

#: src/usr/local/www/vpn_ipsec_mobile.php:262
msgid ""
"At least one WINS server must be specified to enable the DNS Server option."
