#: src/usr/local/www/interfaces_bridge_edit.php:143
msgid "Member Interfaces"
msgstr "ອິນເຕີເຟສສະມາຊິກ"

#: src/usr/local/www/interfaces_bridge_edit.php:148
msgid "Maxage needs to be an integer between 6 and 40."
msgstr "Maxage ຕ້ອງເປັນຈຳນວນເຕັມລະຫວ່າງ 6 ແລະ 40."

#: src/usr/local/www/interfaces_bridge_edit.php:151
msgid "Maxaddr needs to be an integer."
msgstr "Maxaddr ຕ້ອງເປັນຈຳນວນເຕັມ."

#: src/usr/local/www/interfaces_bridge_edit.php:154
msgid "Timeout needs to be an integer."
msgstr "Timeout ຕ້ອງເປັນຈຳນວນເຕັມ."

#: src/usr/local/www/interfaces_bridge_edit.php:157
msgid "Forward Delay needs to be an integer between 4 and 30."
msgstr "Forward Delay ຕ້ອງເປັນຈຳນວນເຕັມລະຫວ່າງ 4 ແລະ 30."

#: src/usr/local/www/interfaces_bridge_edit.php:160
msgid "Hello time for STP needs to be an integer between 1 and 2."
msgstr "ເວລາ Hello ສຳລັບ STP ຕ້ອງເປັນຈຳນວນເຕັມລະຫວ່າງ 1 ແລະ 2."

#: src/usr/local/www/interfaces_bridge_edit.php:163
msgid "Priority for STP needs to be an integer between 0 and 61440."
msgstr "ຄວາມສຳຄັນສຳລັບ STP ຕ້ອງເປັນຈຳນວນເຕັມລະຫວ່າງ 0 ແລະ 61440."

#: src/usr/local/www/interfaces_bridge_edit.php:166
msgid "Transmit Hold Count for STP needs to be an integer between 1 and 10."
msgstr "Transmit Hold Count ສຳລັບ STP ຕ້ອງເປັນຈຳນວນເຕັມລະຫວ່າງ 1 ແລະ 10."

#: src/usr/local/www/interfaces_bridge_edit.php:170
#, php-format
msgid ""
"%s interface priority for STP needs to be an integer between 0 and 240."
msgstr "ຄວາມສຳຄັນຂອງອິນເຕີເຟສ %s ສຳລັບ STP ຕ້ອງເປັນຈຳນວນເຕັມລະຫວ່າງ 0 ແລະ 240."

#: src/usr/local/www/interfaces_bridge_edit.php:178
#, php-format
msgid ""
"%s interface path cost for STP needs to be an integer between 1 and "
"200000000."
msgstr "ຄ່າໃຊ້ຈ່າຍເສັ້ນທາງອິນເຕີເຟສ %s ສຳລັບ STP ຕ້ອງເປັນຈຳນວນເຕັມລະຫວ່າງ 1 ແລະ 200000000."

#: src/usr/local/www/interfaces_bridge_edit.php:184
msgid "At least one member interface must be selected for a bridge."
msgstr "ຕ້ອງເລືອກອິນເຕີເຟສສະມາຊິກຢ່າງໜ້ອຍໜຶ່ງອິນເຕີເຟສສຳລັບບຣິດຈ໌."

#: src/usr/local/www/interfaces_bridge_edit.php:191
#, php-format
msgid ""
"The interface (%s) is part of the Captive Portal and cannot be part of the "
"bridge. Remove the interface to continue."
msgstr "ອິນເຕີເຟສ (%s) ເປັນສ່ວນໜຶ່ງຂອງ Captive Portal ແລະບໍ່ສາມາດເປັນສ່ວນໜຶ່ງຂອງບຣິດຈ໌ໄດ້. ລຶບອິນເຕີເຟສເພື່ອສືບຕໍ່."

#: src/usr/local/www/interfaces_bridge_edit.php:202
#, php-format
msgid ""
"Sticky interface (%s) is not part of the bridge. Remove the sticky interface "
"to continue."
msgstr "ອິນເຕີເຟສສະຕິກກີ້ (%s) ບໍ່ໄດ້ເປັນສ່ວນໜຶ່ງຂອງບຣິດຈ໌. ລຶບອິນເຕີເຟສສະຕິກກີ້ເພື່ອສືບຕໍ່."

#: src/usr/local/www/interfaces_bridge_edit.php:210
#, php-format
msgid ""
"Private interface (%s) is not part of the bridge. Remove the private "
"interface to continue."
msgstr "ອິນເຕີເຟສສ່ວນຕົວ (%s) ບໍ່ໄດ້ເປັນສ່ວນໜຶ່ງຂອງບຣິດຈ໌. ລຶບອິນເຕີເຟສສ່ວນຕົວເພື່ອສືບຕໍ່."

#: src/usr/local/www/interfaces_bridge_edit.php:218
#, php-format
msgid ""
"STP interface (%s) is not part of the bridge. Remove the STP interface to "
"continue."
msgstr "ອິນເຕີເຟສ STP (%s) ບໍ່ໄດ້ເປັນສ່ວນໜຶ່ງຂອງບຣິດຈ໌. ລຶບອິນເຕີເຟສ STP ເພື່ອສືບຕໍ່."

#: src/usr/local/www/interfaces_bridge_edit.php:222
#, php-format
msgid "STP interface (%s) must not be a pseudo-interface or a VLAN interface."
msgstr "ອິນເຕີເຟສ STP (%s) ຕ້ອງບໍ່ແມ່ນອິນເຕີເຟສປອມ ຫຼືອິນເຕີເຟສ VLAN."

#: src/usr/local/www/interfaces_bridge_edit.php:233
#, php-format
msgid ""
"Edge interface (%s) is not part of the bridge. Remove the edge interface to "
"continue."
msgstr "ອິນເຕີເຟສ Edge (%s) ບໍ່ໄດ້ເປັນສ່ວນໜຶ່ງຂອງບຣິດຈ໌. ລຶບອິນເຕີເຟສ Edge ເພື່ອສືບຕໍ່."

#: src/usr/local/www/interfaces_bridge_edit.php:241
#, php-format
msgid ""
"Auto Edge interface (%s) is not part of the bridge. Remove the auto edge "
"interface to continue."
msgstr "ອິນເຕີເຟສ Auto Edge (%s) ບໍ່ໄດ້ເປັນສ່ວນໜຶ່ງຂອງບຣິດຈ໌. ລຶບອິນເຕີເຟສ Auto Edge ເພື່ອສືບຕໍ່."

#: src/usr/local/www/interfaces_bridge_edit.php:249
#, php-format
msgid ""
"PTP interface (%s) is not part of the bridge. Remove the PTP interface to "
"continue."
msgstr "ອິນເຕີເຟສ PTP (%s) ບໍ່ໄດ້ເປັນສ່ວນໜຶ່ງຂອງບຣິດຈ໌. ລຶບອິນເຕີເຟສ PTP ເພື່ອສືບຕໍ່."

#: src/usr/local/www/interfaces_bridge_edit.php:257
#, php-format
msgid ""
"Auto PTP interface (%s) is not part of the bridge. Remove the auto PTP "
"interface to continue."
msgstr "ອິນເຕີເຟສ Auto PTP (%s) ບໍ່ໄດ້ເປັນສ່ວນໜຶ່ງຂອງບຣິດຈ໌. ລຶບອິນເຕີເຟສ Auto PTP ເພື່ອສືບຕໍ່."

#: src/usr/local/www/interfaces_bridge_edit.php:265
msgid "A member interface passed does not exist in configuration"
msgstr "ອິນເຕີເຟສສະມາຊິກທີ່ຜ່ານມາບໍ່ມີຢູ່ໃນການຕັ້ງຄ່າ"

#: src/usr/local/www/interfaces_bridge_edit.php:268
msgid "A bridge interface cannot be a member of a bridge."
msgstr "ອິນເຕີເຟສບຣິດຈ໌ບໍ່ສາມາດເປັນສະມາຊິກຂອງບຣິດຈ໌ໄດ້."

#: src/usr/local/www/interfaces_bridge_edit.php:272
msgid "Bridging a wireless interface is only possible in hostap mode."
msgstr "ການບຣິດຈ໌ອິນເຕີເຟສໄຮ້ສາຍແມ່ນເປັນໄປໄດ້ພຽງແຕ່ໃນໂໝດ hostap ເທົ່ານັ້ນ."

#: src/usr/local/www/interfaces_bridge_edit.php:275
#, php-format
msgid ""
"Span interface (%s) cannot be part of the bridge. Remove the span interface "
"from bridge members to continue."
msgstr "ອິນເຕີເຟສ Span (%s) ບໍ່ສາມາດເປັນສ່ວນໜຶ່ງຂອງບຣິດຈ໌ໄດ້. ລຶບອິນເຕີເຟສ Span ອອກຈາກສະມາຊິກບຣິດຈ໌ເພື່ອສືບຕໍ່."

#: src/usr/local/www/interfaces_bridge_edit.php:284
#, php-format
msgid ""
"%s is part of another bridge. Remove the interface from bridge members to "
"continue."
msgstr "%s ເປັນສ່ວນໜຶ່ງຂອງບຣິດຈ໌ອື່ນ. ລຶບອິນເຕີເຟສອອກຈາກສະມາຊິກບຣິດຈ໌ເພື່ອສືບຕໍ່."

#: src/usr/local/www/interfaces_bridge_edit.php:415
msgid "Bridge Configuration"
msgstr "ການຕັ້ງຄ່າບຣິດຈ໌"

#: src/usr/local/www/interfaces_bridge_edit.php:421
msgid "*Member Interfaces"
msgstr "*ອິນເຕີເຟສສະມາຊິກ"

#: src/usr/local/www/interfaces_bridge_edit.php:425
msgid "Interfaces participating in the bridge."
msgstr "ອິນເຕີເຟສທີ່ເຂົ້າຮ່ວມໃນບຣິດຈ໌."

#: src/usr/local/www/interfaces_bridge_edit.php:445
#: src/usr/local/www/firewall_rules_edit.php:1542
#: src/usr/local/www/firewall_rules_edit.php:1548
#: src/usr/local/www/vpn_ipsec_phase1.php:1046 src/etc/inc/shaper.inc:4497
#: src/etc/inc/shaper.inc:4928
msgid "Advanced Options"
msgstr "ຕົວເລືອກຂັ້ນສູງ"

#: src/usr/local/www/interfaces_bridge_edit.php:457
msgid "Cache Size"
msgstr "ຂະໜາດແຄສ"

#: src/usr/local/www/interfaces_bridge_edit.php:460
msgid "Set the size of the bridge address cache. The default is 2000 entries."
msgstr "ຕັ້ງຂະໜາດຂອງແຄສທີ່ຢູ່ບຣິດຈ໌. ຄ່າເລີ່ມຕົ້ນແມ່ນ 2000 ລາຍການ."

#: src/usr/local/www/interfaces_bridge_edit.php:464
msgid "Cache expire time"
msgstr "ເວລາໝົດອາຍຸແຄສ"

#: src/usr/local/www/interfaces_bridge_edit.php:467
msgid ""
"Set the timeout of address cache entries to this number of seconds. If "
"seconds is zero, then address cache entries will not be expired. The default "
"is 1200 seconds."
msgstr "ຕັ້ງເວລາໝົດອາຍຸຂອງລາຍການແຄສທີ່ຢູ່ເປັນຈຳນວນວິນາທີນີ້. ຖ້າວິນາທີເປັນສູນ, ລາຍການແຄສທີ່ຢູ່ຈະບໍ່ໝົດອາຍຸ. ຄ່າເລີ່ມຕົ້ນແມ່ນ 1200 ວິນາທີ."

#: src/usr/local/www/interfaces_bridge_edit.php:473
msgid "Span Port"
msgstr "ພອດ Span"

#: src/usr/local/www/interfaces_bridge_edit.php:477
#, php-format
msgid ""
"Add the interface named by interface as a span port on the bridge. Span "
"ports transmit a copy of every frame received by the bridge. This is most "
"useful for snooping a bridged network passively on another host connected to "
"one of the span ports of the bridge. %1$s%2$sThe span interface cannot be "
"part of the bridge member interfaces.%3$s"
msgstr "ເພີ່ມອິນເຕີເຟສທີ່ຕັ້ງຊື່ໂດຍອິນເຕີເຟສເປັນພອດ span ໃນບຣິດຈ໌. ພອດ Span ສົ່ງສຳເນົາຂອງທຸກເຟຣມທີ່ໄດ້ຮັບໂດຍບຣິດຈ໌. ນີ້ແມ່ນມີປະໂຫຍດທີ່ສຸດສຳລັບການສອດແນມເຄືອຂ່າຍທີ່ບຣິດຈ໌ແບບ passive ໃນໂຮສອື່ນທີ່ເຊື່ອມຕໍ່ກັບໜຶ່ງໃນພອດ span ຂອງບຣິດຈ໌. %1$s%2$sອິນເຕີເຟສ span ບໍ່ສາມາດເປັນສ່ວນໜຶ່ງຂອງອິນເຕີເຟສສະມາຊິກບຣິດຈ໌.%3$s"

#: src/usr/local/www/interfaces_bridge_edit.php:485
msgid "Edge Ports"
msgstr "ພອດ Edge"

#: src/usr/local/www/interfaces_bridge_edit.php:489
msgid ""
"Set interface as an edge port. An edge port connects directly to end "
"stations and cannot create bridging loops in the network; this allows it to "
"transition straight to forwarding."
msgstr "ຕັ້ງອິນເຕີເຟສເປັນພອດ edge. ພອດ edge ເຊື່ອມຕໍ່ໂດຍກົງກັບສະຖານີປາຍທາງ ແລະບໍ່ສາມາດສ້າງ loops ບຣິດຈ໌ໃນເຄືອຂ່າຍ; ນີ້ອະນຸຍາດໃຫ້ມັນປ່ຽນໄປຫາການສົ່ງຕໍ່ໂດຍກົງ."

#: src/usr/local/www/interfaces_bridge_edit.php:495
msgid "Auto Edge Ports"
msgstr "ພອດ Auto Edge"

#: src/usr/local/www/interfaces_bridge_edit.php:499
#, php-format
msgid ""
"Allow interface to automatically detect edge status. This is the default for "
"all interfaces added to a bridge.%1$sThis will disable the autoedge status "
"of interfaces. %2$s"
msgstr "ອະນຸຍາດໃຫ້ອິນເຕີເຟສກວດພົບສະຖານະ edge ໂດຍອັດຕະໂນມັດ. ນີ້ແມ່ນຄ່າເລີ່ມຕົ້ນສຳລັບອິນເຕີເຟສທັງໝົດທີ່ເພີ່ມເຂົ້າໃນບຣິດຈ໌.%1$sນີ້ຈະປິດການໃຊ້ງານສະຖານະ autoedge ຂອງອິນເຕີເຟສ. %2$s"

#: src/usr/local/www/interfaces_bridge_edit.php:506
msgid "PTP Ports"
msgstr "ພອດ PTP"

#: src/usr/local/www/interfaces_bridge_edit.php:510
msgid ""
"Set the interface as a point-to-point link. This is required for straight "
"transitions to forwarding and should be enabled on a direct link to another "
"RSTP-capable switch."
msgstr "ຕັ້ງອິນເຕີເຟສເປັນລິ້ງ point-to-point. ນີ້ແມ່ນຕ້ອງການສຳລັບການປ່ຽນໄປຫາການສົ່ງຕໍ່ໂດຍກົງ ແລະຄວນເປີດໃຊ້ງານໃນລິ້ງໂດຍກົງກັບສະວິດທີ່ຮອງຮັບ RSTP ອື່ນ."

#: src/usr/local/www/interfaces_bridge_edit.php:516
msgid "Auto PTP Ports"
msgstr "ພອດ Auto PTP"

#: src/usr/local/www/interfaces_bridge_edit.php:520
#, php-format
msgid ""
"Automatically detect the point-to-point status on interface by checking the "
"full duplex link status. This is the default for interfaces added to the "
"bridge.%1$sThe interfaces selected here will be removed from default "
"autoedge status. %2$s"
msgstr "ກວດພົບສະຖານະ point-to-point ໃນອິນເຕີເຟສໂດຍອັດຕະໂນມັດໂດຍການກວດສອບສະຖານະລິ້ງ duplex ເຕັມ. ນີ້ແມ່ນຄ່າເລີ່ມຕົ້ນສຳລັບອິນເຕີເຟສທີ່ເພີ່ມເຂົ້າໃນບຣິດຈ໌.%1$sອິນເຕີເຟສທີ່ເລືອກຢູ່ທີ່ນີ້ຈະຖືກລຶບອອກຈາກສະຖານະ autoedge ເລີ່ມຕົ້ນ. %2$s"

#: src/usr/local/www/interfaces_bridge_edit.php:527
msgid "Sticky Ports"
msgstr "ພອດ Sticky"

#: src/usr/local/www/interfaces_bridge_edit.php:531
msgid ""
"Mark an interface as a \"sticky\" interface. Dynamically learned address "
"entries are treated as static once entered into the cache. Sticky entries "
"are never aged out of the cache or replaced, even if the address is seen on "
"a different interface."
msgstr "ໝາຍອິນເຕີເຟສເປັນອິນເຕີເຟສ \"sticky\". ລາຍການທີ່ຢູ່ທີ່ຮຽນຮູ້ແບບໄດນາມິກຖືກປະຕິບັດເປັນສະຕາຕິກເມື່ອເຂົ້າໄປໃນແຄສ. ລາຍການ Sticky ບໍ່ເຄີຍໝົດອາຍຸອອກຈາກແຄສ ຫຼືຖືກປ່ຽນແທນ, ເຖິງແມ່ນວ່າທີ່ຢູ່ຈະຖືກເຫັນໃນອິນເຕີເຟສທີ່ແຕກຕ່າງກັນ."

#: src/usr/local/www/interfaces_bridge_edit.php:538
msgid "Private Ports"
msgstr "ພອດສ່ວນຕົວ"

#: src/usr/local/www/interfaces_bridge_edit.php:542
msgid ""
"Mark an interface as a \"private\" interface. A private interface does not "
"forward any traffic to any other port that is also a private interface. "
msgstr "ໝາຍອິນເຕີເຟສເປັນອິນເຕີເຟສ \"ສ່ວນຕົວ\". ອິນເຕີເຟສສ່ວນຕົວບໍ່ສົ່ງຕໍ່ການຈະລາຈອນໃດໆໄປຫາພອດອື່ນໆທີ່ເປັນອິນເຕີເຟສສ່ວນຕົວເຊັ່ນກັນ."

#: src/usr/local/www/interfaces_bridge_edit.php:546
msgid "Enable IPv6 auto linklocal"
msgstr "ເປີດໃຊ້ງານ IPv6 auto linklocal"

#: src/usr/local/www/interfaces_bridge_edit.php:549
msgid ""
"When enabled, the AUTO_LINKLOCAL flag is set on the bridge interface and "
"cleared on every member interface. This is required when the bridge "
"interface is used for stateless autoconfiguration. "
msgstr "ເມື່ອເປີດໃຊ້ງານ, ແຟລັກ AUTO_LINKLOCAL ຖືກຕັ້ງໃນອິນເຕີເຟສບຣິດຈ໌ ແລະລຶບລ້າງໃນທຸກອິນເຕີເຟສສະມາຊິກ. ນີ້ແມ່ນຕ້ອງການເມື່ອອິນເຕີເຟສບຣິດຈ໌ຖືກໃຊ້ສຳລັບການຕັ້ງຄ່າອັດຕະໂນມັດແບບບໍ່ມີສະຖານະ."

#: src/usr/local/www/interfaces_bridge_edit.php:555
msgid "Enable RSTP/STP"
msgstr "ເປີດໃຊ້ງານ RSTP/STP"

#: src/usr/local/www/interfaces_bridge_edit.php:562
msgid "RSTP/STP"
msgstr "RSTP/STP"

#: src/usr/local/www/interfaces_bridge_edit.php:571
msgid "Protocol used for spanning tree."
msgstr "ໂປຣໂຕຄອນທີ່ໃຊ້ສຳລັບ spanning tree."

#: src/usr/local/www/interfaces_bridge_edit.php:577
msgid "STP Interfaces"
msgstr "ອິນເຕີເຟສ STP"

#: src/usr/local/www/interfaces_bridge_edit.php:581
msgid ""
"Enable Spanning Tree Protocol on interface. The if_bridge(4) driver has "
"support for the IEEE 802.1D Spanning Tree Protocol (STP). STP is used to "
"detect and remove loops in a network topology."
msgstr "ເປີດໃຊ້ງານ Spanning Tree Protocol ໃນອິນເຕີເຟສ. ໄດຣເວີ if_bridge(4) ຮອງຮັບ IEEE 802.1D Spanning Tree Protocol (STP). STP ຖືກໃຊ້ເພື່ອກວດພົບ ແລະລຶບ loops ໃນ topology ເຄືອຂ່າຍ."

#: src/usr/local/www/interfaces_bridge_edit.php:586
msgid "Valid time"
msgstr "ເວລາທີ່ຖືກຕ້ອງ"

#: src/usr/local/www/interfaces_bridge_edit.php:590
msgid ""
"Set the time that a Spanning Tree Protocol configuration is valid. The "
"default is 20 seconds. The minimum is 6 seconds and the maximum is 40 "
"seconds."
msgstr "ຕັ້ງເວລາທີ່ການຕັ້ງຄ່າ Spanning Tree Protocol ຖືກຕ້ອງ. ຄ່າເລີ່ມຕົ້ນແມ່ນ 20 ວິນາທີ. ຄ່າຕ່ຳສຸດແມ່ນ 6 ວິນາທີ ແລະຄ່າສູງສຸດແມ່ນ 40 ວິນາທີ."

#: src/usr/local/www/interfaces_bridge_edit.php:594
msgid "Forward time"
msgstr "ເວລາສົ່ງຕໍ່"

#: src/usr/local/www/interfaces_bridge_edit.php:598
msgid ""
"Set the time that must pass before an interface begins forwarding packets "
"when Spanning Tree is enabled. The default is 15 seconds. The minimum is 4 "
"seconds and the maximum is 30 seconds. "
msgstr "ຕັ້ງເວລາທີ່ຕ້ອງຜ່ານໄປກ່ອນທີ່ອິນເຕີເຟສຈະເລີ່ມສົ່ງຕໍ່ແພັກເກັດເມື່ອ Spanning Tree ຖືກເປີດໃຊ້ງານ. ຄ່າເລີ່ມຕົ້ນແມ່ນ 15 ວິນາທີ. ຄ່າຕ່ຳສຸດແມ່ນ 4 ວິນາທີ ແລະຄ່າສູງສຸດແມ່ນ 30 ວິນາທີ."

#: src/usr/local/www/interfaces_bridge_edit.php:602
msgid "Hello time"
msgstr "ເວລາ Hello"

#: src/usr/local/www/interfaces_bridge_edit.php:606
msgid ""
"Set the time in seconds between broadcasting of Spanning Tree Protocol "
"configuration messages. The hello time may only be changed when operating in "
"legacy STP mode. The default is 2 seconds. The minimum is 1 second and the "
"maximum is 2 seconds."
msgstr "ຕັ້ງເວລາເປັນວິນາທີລະຫວ່າງການກະຈາຍສຽງຂໍ້ຄວາມການຕັ້ງຄ່າ Spanning Tree Protocol. ເວລາ hello ອາດຈະຖືກປ່ຽນແປງເມື່ອໃຊ້ງານໃນໂໝດ STP ແບບເກົ່າເທົ່ານັ້ນ. ຄ່າເລີ່ມຕົ້ນແມ່ນ 2 ວິນາທີ. ຄ່າຕ່ຳສຸດແມ່ນ 1 ວິນາທີ ແລະຄ່າສູງສຸດແມ່ນ 2 ວິນາທີ."

#: src/usr/local/www/interfaces_bridge_edit.php:611
#: src/usr/local/www/interfaces_vlan.php:98
#: src/usr/local/www/system_gateway_groups.php:131 src/etc/inc/shaper.inc:1812
msgid "Priority"
msgstr "ຄວາມສຳຄັນ"

#: src/usr/local/www/interfaces_bridge_edit.php:615
msgid ""
"Set the bridge priority for Spanning Tree. The default is 32768. The minimum "
"is 0 and the maximum is 61440. "
msgstr "ຕັ້ງຄວາມສຳຄັນຂອງບຣິດຈ໌ສຳລັບ Spanning Tree. ຄ່າເລີ່ມຕົ້ນແມ່ນ 32768. ຄ່າຕ່ຳສຸດແມ່ນ 0 ແລະຄ່າສູງສຸດແມ່ນ 61440."

#: src/usr/local/www/interfaces_bridge_edit.php:619
msgid "Hold Count"
msgstr "ນັບຖື"

#: src/usr/local/www/interfaces_bridge_edit.php:623
msgid ""
"Set the transmit hold count for Spanning Tree. This is the number of packets "
"transmitted before being rate limited. The default is 6. The minimum is 1 "
"and the maximum is 10."
msgstr "ຕັ້ງຈຳນວນການສົ່ງຕໍ່ຖືສຳລັບ Spanning Tree. ນີ້ແມ່ນຈຳນວນແພັກເກັດທີ່ສົ່ງຕໍ່ກ່ອນທີ່ຈະຖືກຈຳກັດອັດຕາ. ຄ່າເລີ່ມຕົ້ນແມ່ນ 6. ຄ່າຕ່ຳສຸດແມ່ນ 1 ແລະຄ່າສູງສຸດແມ່ນ 10."

#: src/usr/local/www/interfaces_bridge_edit.php:628
msgid " Priority"
msgstr " ຄວາມສຳຄັນ"

#: src/usr/local/www/interfaces_bridge_edit.php:632
msgid ""
"Set the Spanning Tree priority of interface to value. The default is 128. "
"The minimum is 0 and the maximum is 240. Increments of 16."
msgstr "ຕັ້ງຄວາມສຳຄັນ Spanning Tree ຂອງອິນເຕີເຟສເປັນຄ່າ. ຄ່າເລີ່ມຕົ້ນແມ່ນ 128. ຄ່າຕ່ຳສຸດແມ່ນ 0 ແລະຄ່າສູງສຸດແມ່ນ 240. ເພີ່ມຂຶ້ນເທື່ອລະ 16."

#: src/usr/local/www/interfaces_bridge_edit.php:639
msgid " Path cost"
msgstr " ຄ່າໃຊ້ຈ່າຍເສັ້ນທາງ"

#: src/usr/local/www/interfaces_bridge_edit.php:643
msgid ""
"Set the Spanning Tree path cost of interface to value. The default is "
"calculated from the link speed. To change a previously selected path cost "
"back to automatic, set the cost to 0. The minimum is 1 and the maximum is "
"200000000."
msgstr "ຕັ້ງຄ່າໃຊ້ຈ່າຍເສັ້ນທາງ Spanning Tree ຂອງອິນເຕີເຟສເປັນຄ່າ. ຄ່າເລີ່ມຕົ້ນແມ່ນຄຳນວນຈາກຄວາມໄວລິ້ງ. ເພື່ອປ່ຽນຄ່າໃຊ້ຈ່າຍເສັ້ນທາງທີ່ເລືອກໄວ້ກ່ອນໜ້ານີ້ກັບຄືນເປັນອັດຕະໂນມັດ, ຕັ້ງຄ່າໃຊ້ຈ່າຍເປັນ 0. ຄ່າຕ່ຳສຸດແມ່ນ 1 ແລະຄ່າສູງສຸດແມ່ນ 200000000."

