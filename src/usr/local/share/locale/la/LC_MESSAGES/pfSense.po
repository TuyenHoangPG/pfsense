msgid "This IPv4 address conflicts with a Static Route."
msgstr ""
"ທີ່ຢູ່ IPv4 ນີ້ຂັດແຍ່ງກັບເສັ້ນທາງສະຖິດ."

#: src/usr/local/www/interfaces.php:814
#: src/usr/local/www/services_dhcpv6_edit.php:113
msgid "A valid IPv6 address must be specified."
msgstr ""
"ຕ້ອງລະບຸທີ່ຢູ່ IPv6 ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:817
msgid "IPv6 link local addresses cannot be configured as an interface IP."
msgstr ""
"ທີ່ຢູ່ IPv6 link local ບໍ່ສາມາດຕັ້ງຄ່າເປັນ IP ອິນເຕີເຟດໄດ້."

#: src/usr/local/www/interfaces.php:821
#, php-format
msgid "IPv6 address %s is being used by or overlaps with:"
msgstr ""
"ທີ່ຢູ່ IPv6 %s ກໍາລັງຖືກໃຊ້ໂດຍ ຫຼືທັບຊ້ອນກັບ:"

#: src/usr/local/www/interfaces.php:831
msgid "This IPv6 address conflicts with a Static Route."
msgstr ""
"ທີ່ຢູ່ IPv6 ນີ້ຂັດແຍ່ງກັບເສັ້ນທາງສະຖິດ."

#: src/usr/local/www/interfaces.php:839 src/usr/local/www/interfaces.php:842
msgid "A valid subnet bit count must be specified."
msgstr ""
"ຕ້ອງລະບຸຈໍານວນບິດ subnet ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:845
msgid "A valid alias IP address must be specified."
msgstr ""
"ຕ້ອງລະບຸທີ່ຢູ່ IP ນາມສະກຸນທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:848
msgid "A valid alias subnet bit count must be specified."
msgstr ""
"ຕ້ອງລະບຸຈໍານວນບິດ subnet ນາມສະກຸນທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:851
msgid "An invalid IP address was detected in the 'Reject leases from' field."
msgstr ""
"ກວດພົບທີ່ຢູ່ IP ທີ່ບໍ່ຖືກຕ້ອງໃນຊ່ອງ 'ປະຕິເສດການເຊົ່າຈາກ'."

#: src/usr/local/www/interfaces.php:863
msgid "A valid IPv4 gateway must be specified."
msgstr ""
"ຕ້ອງລະບຸ gateway IPv4 ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:875
msgid "A valid IPv6 gateway must be specified."
msgstr ""
"ຕ້ອງລະບຸ gateway IPv6 ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:880
msgid "The service name may not contain quote characters."
msgstr ""
"ຊື່ບໍລິການອາດຈະບໍ່ມີຕົວອັກສອນອ້າງອີງ."

#: src/usr/local/www/interfaces.php:883
msgid "The Host-Uniq value can only be hexadecimal or letters and numbers."
msgstr ""
"ຄ່າ Host-Uniq ສາມາດເປັນເລກຖານສິບຫົກ ຫຼືຕົວອັກສອນ ແລະຕົວເລກເທົ່ານັ້ນ."

#: src/usr/local/www/interfaces.php:900
msgid "A valid PPTP local IP address must be specified."
msgstr ""
"ຕ້ອງລະບຸທີ່ຢູ່ IP PPTP ທ້ອງຖິ່ນທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:903
msgid "A valid PPTP subnet bit count must be specified."
msgstr ""
"ຕ້ອງລະບຸຈໍານວນບິດ subnet PPTP ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:906
msgid "A valid PPTP remote IP address must be specified."
msgstr ""
"ຕ້ອງລະບຸທີ່ຢູ່ IP PPTP ຫ່າງໄກສອກຫຼີກທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:946
msgid "The MTU of a VLAN cannot be greater than that of its parent interface."
msgstr ""
"MTU ຂອງ VLAN ບໍ່ສາມາດໃຫຍ່ກວ່າຂອງອິນເຕີເຟດຫຼັກຂອງມັນ."

#: src/usr/local/www/interfaces.php:962
#, php-format
msgid "Interface %s (VLAN) has MTU set to a larger value."
msgstr ""
"ອິນເຕີເຟດ %s (VLAN) ມີ MTU ຕັ້ງເປັນຄ່າທີ່ໃຫຍ່ກວ່າ."

#: src/usr/local/www/interfaces.php:969
msgid "The MSS must be an integer between 576 and 65535 bytes."
msgstr ""
"MSS ຕ້ອງເປັນຈຳນວນເຕັມລະຫວ່າງ 576 ຫາ 65535 ໄບຕ໌."

#: src/usr/local/www/interfaces.php:981
msgid "A specific channel, not auto, must be selected for Access Point mode."
msgstr ""
"ຕ້ອງເລືອກຊ່ອງສະເພາະ, ບໍ່ແມ່ນອັດຕະໂນມັດ, ສໍາລັບໂໝດຈຸດເຂົ້າເຖິງ."

#: src/usr/local/www/interfaces.php:985
msgid "Channel width selection is only supported by 802.11n standards."
msgstr ""
"ການເລືອກຄວາມກວ້າງຂອງຊ່ອງແມ່ນຮອງຮັບໂດຍມາດຕະຖານ 802.11n ເທົ່ານັ້ນ."

#: src/usr/local/www/interfaces.php:989
msgid "802.11n standards require enabling WME."
msgstr ""
"ມາດຕະຖານ 802.11n ຕ້ອງການເປີດໃຊ້ WME."

#: src/usr/local/www/interfaces.php:995
#, php-format
msgid "Unable to use %s channel width with channel %s."
msgstr ""
"ບໍ່ສາມາດໃຊ້ຄວາມກວ້າງຊ່ອງ %s ກັບຊ່ອງ %s ໄດ້."

#: src/usr/local/www/interfaces.php:1001
msgid "Key Rotation must be an integer between 1 and 9999."
msgstr ""
"ການໝູນວຽນລະຫັດຕ້ອງເປັນຈຳນວນເຕັມລະຫວ່າງ 1 ຫາ 9999."

#: src/usr/local/www/interfaces.php:1004
msgid "Master Key Regeneration must be an integer between 1 and 9999."
msgstr ""
"ການສ້າງລະຫັດຫຼັກຄືນໃໝ່ຕ້ອງເປັນຈຳນວນເຕັມລະຫວ່າງ 1 ຫາ 9999."

#: src/usr/local/www/interfaces.php:1008
msgid "Master Key Regeneration must be greater than Key Rotation."
msgstr ""
"ການສ້າງລະຫັດຫຼັກຄືນໃໝ່ຕ້ອງຫຼາຍກວ່າການໝູນວຽນລະຫັດ."

#: src/usr/local/www/interfaces.php:1013
msgid "802.1X Authentication Server must be an IP or hostname."
msgstr ""
"ເຊີບເວີກວດສອບຄວາມຖືກຕ້ອງ 802.1X ຕ້ອງເປັນ IP ຫຼືຊື່ໂຮສ."

#: src/usr/local/www/interfaces.php:1018
msgid "Secondary 802.1X Authentication Server must be an IP or hostname."
msgstr ""
"ເຊີບເວີກວດສອບຄວາມຖືກຕ້ອງ 802.1X ຮອງ ຕ້ອງເປັນ IP ຫຼືຊື່ໂຮສ."

#: src/usr/local/www/interfaces.php:1023
msgid ""
"802.1X Authentication Server Port must be a valid port number (1-65535)."
msgstr ""
"ພອດເຊີບເວີກວດສອບຄວາມຖືກຕ້ອງ 802.1X ຕ້ອງເປັນໝາຍເລກພອດທີ່ຖືກຕ້ອງ (1-65535)."

#: src/usr/local/www/interfaces.php:1028
msgid ""
"Secondary 802.1X Authentication Server Port must be a valid port number (1-"
"65535)."
msgstr ""
"ພອດເຊີບເວີກວດສອບຄວາມຖືກຕ້ອງ 802.1X ຮອງ ຕ້ອງເປັນໝາຍເລກພອດທີ່ຖືກຕ້ອງ (1-65535)."

#: src/usr/local/www/interfaces.php:1033
msgid "Invalid channel specified."
msgstr ""
"ລະບຸຊ່ອງທີ່ບໍ່ຖືກຕ້ອງ."

#: src/usr/local/www/interfaces.php:1036
msgid "Channel must be between 0-255."
msgstr ""
"ຊ່ອງຕ້ອງຢູ່ລະຫວ່າງ 0-255."

#: src/usr/local/www/interfaces.php:1041
msgid "Distance must be an integer."
msgstr ""
"ໄລຍະຫ່າງຕ້ອງເປັນຈຳນວນເຕັມ."

#: src/usr/local/www/interfaces.php:1045
msgid "Channel selected is not valid for 802.11a or 802.11na."
msgstr ""
"ຊ່ອງທີ່ເລືອກບໍ່ຖືກຕ້ອງສໍາລັບ 802.11a ຫຼື 802.11na."

#: src/usr/local/www/interfaces.php:1050
msgid "Channel selected is not valid for 802.11b or 802.11g."
msgstr ""
"ຊ່ອງທີ່ເລືອກບໍ່ຖືກຕ້ອງສໍາລັບ 802.11b ຫຼື 802.11g."

#: src/usr/local/www/interfaces.php:1054
msgid "Invalid option chosen for OFDM Protection Mode"
msgstr ""
"ເລືອກຕົວເລືອກທີ່ບໍ່ຖືກຕ້ອງສໍາລັບໂໝດປ້ອງກັນ OFDM"

#: src/usr/local/www/interfaces.php:1060
msgid "The WPA passphrase must be between 8 and 63 characters long."
msgstr ""
"ລະຫັດຜ່ານ WPA ຕ້ອງມີຄວາມຍາວລະຫວ່າງ 8 ຫາ 63 ຕົວອັກສອນ."

#: src/usr/local/www/interfaces.php:1066
msgid "A WPA Passphrase must be specified when WPA PSK is enabled."
msgstr ""
"ຕ້ອງລະບຸ WPA Passphrase ເມື່ອເປີດໃຊ້ WPA PSK."

#: src/usr/local/www/interfaces.php:1071
msgid ""
"An Inner Authentication Identity must be specified when PEAP/TTLS "
"authentication method is selected."
msgstr ""
"ຕ້ອງລະບຸຕົວຕົນການກວດສອບພາຍໃນເມື່ອເລືອກວິທີການກວດສອບ PEAP/TTLS."

#: src/usr/local/www/interfaces.php:1075
msgid ""
"An Inner Authentication Passphrase must be specified when PEAP/TTLS "
"authentication method is selected."
msgstr ""
"ຕ້ອງລະບຸລະຫັດຜ່ານການກວດສອບພາຍໃນເມື່ອເລືອກວິທີການກວດສອບ PEAP/TTLS."

#: src/usr/local/www/interfaces.php:1083
msgid "PPP Password and confirmed password must match!"
msgstr ""
"ລະຫັດຜ່ານ PPP ແລະລະຫັດຜ່ານທີ່ຢືນຢັນຕ້ອງກົງກັນ!"

#: src/usr/local/www/interfaces.php:1087
msgid "PPPoE Password and confirmed password must match!"
msgstr ""
"ລະຫັດຜ່ານ PPPoE ແລະລະຫັດຜ່ານທີ່ຢືນຢັນຕ້ອງກົງກັນ!"

#: src/usr/local/www/interfaces.php:1091
msgid "PTPP Password and confirmed password must match!"
msgstr ""
"ລະຫັດຜ່ານ PTPP ແລະລະຫັດຜ່ານທີ່ຢືນຢັນຕ້ອງກົງກັນ!"

#: src/usr/local/www/interfaces.php:1842
#, php-format
msgid ""
"Unable to change mode to %s. The maximum number of wireless clones supported "
"in this mode may have been reached."
msgstr ""
"ບໍ່ສາມາດປ່ຽນໂໝດເປັນ %s ໄດ້. ຈຳນວນສູງສຸດຂອງໂຄນໄຮ້ສາຍທີ່ຮອງຮັບໃນໂໝດນີ້ອາດຈະຮອດແລ້ວ."

#: src/usr/local/www/interfaces.php:1872
msgid "Static IPv4"
msgstr ""
"IPv4 ສະຖິດ"

#: src/usr/local/www/interfaces.php:1875
msgid "Static IPv6"
msgstr ""
"IPv6 ສະຖິດ"

#: src/usr/local/www/interfaces.php:1875
msgid "DHCP6"
msgstr ""
"DHCP6"

#: src/usr/local/www/interfaces.php:1875
msgid "SLAAC"
msgstr ""
"SLAAC"

#: src/usr/local/www/interfaces.php:1875
msgid "6rd Tunnel"
msgstr ""
"ອຸໂມງ 6rd"

#: src/usr/local/www/interfaces.php:1875
msgid "6to4 Tunnel"
msgstr ""
"ອຸໂມງ 6to4"

#: src/usr/local/www/interfaces.php:1875
msgid "Track Interface"
msgstr ""
"ຕິດຕາມອິນເຕີເຟດ"

#: src/usr/local/www/interfaces.php:1884
msgid "Default (no preference, typically autoselect)"
msgstr ""
"ຄ່າເລີ່ມຕົ້ນ (ບໍ່ມີຄວາມມັກ, ປົກກະຕິແລ້ວ autoselect)"

#: src/usr/local/www/interfaces.php:1885
msgid "------- Media Supported by this interface -------"
msgstr ""
"------- ສື່ທີ່ຮອງຮັບໂດຍອິນເຕີເຟດນີ້ -------"

#: src/usr/local/www/interfaces.php:1928
#, php-format
msgid "The %s configuration has been changed."
msgstr ""
"ການຕັ້ງຄ່າ %s ໄດ້ຖືກປ່ຽນແປງແລ້ວ."

#: src/usr/local/www/interfaces.php:1929
msgid "The changes must be applied to take effect."
msgstr ""
"ການປ່ຽນແປງຕ້ອງຖືກນຳໃຊ້ເພື່ອໃຫ້ມີຜົນ."

#: src/usr/local/www/interfaces.php:1930
msgid "Don't forget to adjust the DHCP Server range if needed after applying."
msgstr ""
"ຢ່າລືມປັບຂອບເຂດເຊີບເວີ DHCP ຖ້າຈໍາເປັນຫຼັງຈາກນຳໃຊ້."

#: src/usr/local/www/interfaces.php:1939
msgid "General Configuration"
msgstr ""
"ການຕັ້ງຄ່າທົ່ວໄປ"

#: src/usr/local/www/interfaces.php:1951
msgid "*Description"
msgstr ""
"*ຄຳອະທິບາຍ"

#: src/usr/local/www/interfaces.php:1954
msgid "Enter a description (name) for the interface here."
msgstr ""
"ປ້ອນຄຳອະທິບາຍ (ຊື່) ສໍາລັບອິນເຕີເຟດຢູ່ທີ່ນີ້."

#: src/usr/local/www/interfaces.php:1959
msgid "IPv4 Configuration Type"
msgstr ""
"ປະເພດການຕັ້ງຄ່າ IPv4"

#: src/usr/local/www/interfaces.php:1965
msgid "IPv6 Configuration Type"
msgstr ""
"ປະເພດການຕັ້ງຄ່າ IPv6"

#: src/usr/local/www/interfaces.php:1971
msgid "IPv4/IPv6 Configuration"
msgstr ""
"ການຕັ້ງຄ່າ IPv4/IPv6"

#: src/usr/local/www/interfaces.php:1999
msgid ""
"The MAC address of a VLAN interface must be set on its parent interface"
msgstr ""
"ທີ່ຢູ່ MAC ຂອງອິນເຕີເຟດ VLAN ຕ້ອງຖືກຕັ້ງຢູ່ໃນອິນເຕີເຟດຫຼັກຂອງມັນ"

#: src/usr/local/www/interfaces.php:2002
#, php-format
msgid ""
"This field can be used to modify (\"spoof\") the MAC address of this "
"interface.%sEnter a MAC address in the following format: xx:xx:xx:xx:xx:xx "
"or leave blank."
msgstr ""
"ຊ່ອງຂໍ້ມູນນີ້ສາມາດໃຊ້ເພື່ອດັດແປງ (\"spoof\") ທີ່ຢູ່ MAC ຂອງອິນເຕີເຟດນີ້.%sປ້ອນທີ່ຢູ່ MAC ໃນຮູບແບບຕໍ່ໄປນີ້: xx:xx:xx:xx:xx:xx ຫຼືປ່ອຍຫວ່າງໄວ້."

#: src/usr/local/www/interfaces.php:2020
msgid "MSS"
msgstr ""
"MSS"

#: src/usr/local/www/interfaces.php:2023
msgid ""
"If a value is entered in this field, then MSS clamping for TCP connections "
"to the value entered above minus 40 for IPv4 (TCP/IPv4 header size) and "
"minus 60 for IPv6 (TCP/IPv6 header size) will be in effect."
msgstr ""
"ຖ້າປ້ອນຄ່າໃນຊ່ອງຂໍ້ມູນນີ້, ຫຼັງຈາກນັ້ນ MSS clamping ສໍາລັບການເຊື່ອມຕໍ່ TCP ກັບຄ່າທີ່ປ້ອນຂ້າງເທິງລົບ 40 ສໍາລັບ IPv4 (ຂະໜາດສ່ວນຫົວ TCP/IPv4) ແລະລົບ 60 ສໍາລັບ IPv6 (ຂະໜາດສ່ວນຫົວ TCP/IPv6) ຈະມີຜົນ."

#: src/usr/local/www/interfaces.php:2029
msgid "Speed and Duplex"
msgstr ""
"ຄວາມໄວ ແລະ Duplex"

#: src/usr/local/www/interfaces.php:2032
#, php-format
msgid ""
