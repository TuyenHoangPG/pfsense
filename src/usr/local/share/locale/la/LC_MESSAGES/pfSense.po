msgstr "ເຕືອນ: ຕ້ອງມີຊື່ເປັນພາລາເມັດຕໍ່ try_lock() function."

#: src/etc/inc/util.inc:1104
#, php-format
msgid "The %1$s name must be less than 32 characters long, may not consist of only numbers, may not consist of only underscores, and may only contain the following characters: %2$s"
msgstr "ຊື່ %1$s ຕ້ອງມີຄວາມຍາວນ້ອຍກວ່າ 32 ຕົວອັກສອນ, ບໍ່ສາມາດປະກອບດ້ວຍແຕ່ເລກ, ບໍ່ສາມາດປະກອບດ້ວຍແຕ່ສັນຍາລັກ, ແລະບໍ່ສາມາດປະກອບດ້ວຍອັກສອນຕໍ່ໄປນີ້ເທົ່ານັ້ນ: %2$s"

#: src/etc/inc/util.inc:1111
#, php-format
msgid "The %1$s name must not be either of the reserved words %2$s or %3$s."
msgstr "ຊື່ %1$s ຕ້ອງບໍ່ເປັນຫນຶ່ງໃນຄຳສຳລັບ %2$s ຫຼື %3$s."

#: src/etc/inc/util.inc:1118
#, php-format
msgid "The %1$s name must not be an IP protocol name such as TCP, UDP, ICMP etc."
msgstr "ຊື່ %1$s ຕ້ອງບໍ່ເປັນຊື່ໂປໂຕຄໍ່ IP ເຊັ່ນ TCP, UDP, ICMP ເປັນຕົ້ນ."

#: src/etc/inc/util.inc:1125
#, php-format
msgid "The %1$s name must not be a well-known or registered TCP or UDP port name such as ssh, smtp, pop3, tftp, http, openvpn etc."
msgstr "ຊື່ %1$s ຕ້ອງບໍ່ເປັນຊື່ TCP ຫຼື UDP port ທີ່ຮູ້ຈັກດີເຊັ່ນ ssh, smtp, pop3, tftp, http, openvpn ເປັນຕົ້ນ."

#: src/etc/inc/util.inc:1834
#, php-format
msgid "The command '%1$s' returned exit code '%2$d', the output was '%3$s'"
msgstr "ຄຳສັ່ງ '%1$s' ສົ່ງຄືນລະຫັດ exit code '%2$d', ຜົນລັບແມ່ນ '%3$s'"

#: src/etc/inc/util.inc:3095
#, php-format
msgid "%s must be a valid IPv4 address or alias."
msgstr "%s ຕ້ອງເປັນທີ່ຢູ່ IPv4 ທີ່ຖືກຕ້ອງ ຫຼືຕົວແທນ."

#: src/etc/inc/util.inc:3099
#, php-format
msgid "%s must be a valid IPv4 address."
msgstr "%s ຕ້ອງເປັນທີ່ຢູ່ IPv4 ທີ່ຖືກຕ້ອງ."

#: src/etc/inc/util.inc:3111
#, php-format
msgid "%s must be a valid IPv6 address or alias."
msgstr "%s ຕ້ອງເປັນທີ່ຢູ່ IPv6 ທີ່ຖືກຕ້ອງ ຫຼືຕົວແທນ."

#: src/etc/inc/util.inc:3115
