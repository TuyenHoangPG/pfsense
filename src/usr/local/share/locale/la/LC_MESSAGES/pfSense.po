#: src/usr/local/www/vpn_l2tp.php:85
#: src/usr/local/www/services_pppoe_edit.php:127
msgid "A valid RADIUS server address must be specified."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ເຊີບເວີ RADIUS ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/vpn_l2tp.php:89
msgid "Secret and confirmation must match"
msgstr "ລະຫັດລັບແລະການຢືນຢັນຕ້ອງກົງກັນ."

#: src/usr/local/www/vpn_l2tp.php:93
msgid "RADIUS secret and confirmation must match"
msgstr "ລະຫັດລັບ RADIUS ແລະການຢືນຢັນຕ້ອງກົງກັນ."

#: src/usr/local/www/vpn_l2tp.php:97
msgid "Number of L2TP users must be between 1 and 255"
msgstr "ຈຳນວນຜູ້ໃຊ້ L2TP ຕ້ອງຢູ່ລະຫວ່າງ 1 ຫາ 255."

#: src/usr/local/www/vpn_l2tp.php:103
#: src/usr/local/www/services_pppoe_edit.php:141
msgid "The specified server address lies in the remote subnet."
msgstr "ທີ່ຢູ່ເຊີບເວີທີ່ກຳນົດຢູ່ໃນຊັບເນັດໄກສະໜອງ."

#: src/usr/local/www/vpn_l2tp.php:106
msgid "The specified server address is equal to the LAN interface address."
msgstr "ທີ່ຢູ່ເຊີບເວີທີ່ກຳນົດເທົ່າກັບທີ່ຢູ່ຂອງ LAN interface."

#: src/usr/local/www/vpn_l2tp.php:111
msgid "The field 'Primary L2TP DNS Server' must contain a valid IPv4 address."
msgstr "ຊ່ອງ 'Primary L2TP DNS Server' ຕ້ອງມີທີ່ຢູ່ IPv4 ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/vpn_l2tp.php:114
msgid "The field 'Secondary L2TP DNS Server' must contain a valid IPv4 address."
msgstr "ຊ່ອງ 'Secondary L2TP DNS Server' ຕ້ອງມີທີ່ຢູ່ IPv4 ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/vpn_l2tp.php:117
msgid "The Secondary L2TP DNS Server cannot be set when the Primary L2TP DNS Server is empty."
msgstr "ບໍ່ສາມາດຕັ້ງ 'Secondary L2TP DNS Server' ໄດ້ ຫາກ 'Primary L2TP DNS Server' ແມ່ນວ່າງເປົ່າ."

#: src/usr/local/www/vpn_l2tp.php:126 src/usr/local/www/interfaces.php:930
#, php-format
msgid "The MTU must be between %d and %d bytes."
msgstr "MTU ຕ້ອງຢູ່ລະຫວ່າງ %d ຫາ %d ໄບດ໌."

#: src/usr/local/www/vpn_l2tp.php:192
msgid "L2TP VPN configuration changed."
msgstr "ການຕັ້ງຄ່າ VPN L2TP ໄດ້ຖືກປ່ຽນແປງ."

#: src/usr/local/www/vpn_l2tp.php:220
msgid "Enable L2TP"
msgstr "ເປີດໃຊ້ L2TP."

