msgstr "Synproxy"

#: src/usr/local/www/firewall_rules_edit.php:360
msgid "The IP protocol is not recognized."
msgstr "ໂປຣໂຕຄໍ IP ບໍ່ຖືກຮັບຮູ້."

#: src/usr/local/www/firewall_rules_edit.php:368
msgid "A valid rule type is not selected."
msgstr "ບໍ່ໄດ້ເລືອກປະເພດກົດລະບຽບທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/firewall_rules_edit.php:388
#: src/usr/local/www/firewall_rules_edit.php:400
msgid ""
"Gateways can not be assigned in a rule that applies to both IPv4 and IPv6."
msgstr "ເກດເວບໍ່ສາມາດຖືກມອບໝາຍໃນກົດລະບຽບທີ່ໃຊ້ກັບທັງ IPv4 ແລະ IPv6."

#: src/usr/local/www/firewall_rules_edit.php:390
msgid "An IPv4 gateway group can not be assigned in IPv6 rules."
msgstr "ກຸ່ມເກດເວ IPv4 ບໍ່ສາມາດຖືກມອບໝາຍໃນກົດລະບຽບ IPv6."

#: src/usr/local/www/firewall_rules_edit.php:392
msgid "An IPv6 gateway group can not be assigned in IPv4 rules."
msgstr "ກຸ່ມເກດເວ IPv6 ບໍ່ສາມາດຖືກມອບໝາຍໃນກົດລະບຽບ IPv4."

#: src/usr/local/www/firewall_rules_edit.php:403
msgid "An IPv4 gateway can not be assigned in IPv6 rules."
msgstr "ເກດເວ IPv4 ບໍ່ສາມາດຖືກມອບໝາຍໃນກົດລະບຽບ IPv6."

#: src/usr/local/www/firewall_rules_edit.php:406
msgid "An IPv6 gateway can not be assigned in IPv4 rules."
msgstr "ເກດເວ IPv6 ບໍ່ສາມາດຖືກມອບໝາຍໃນກົດລະບຽບ IPv4."

#: src/usr/local/www/firewall_rules_edit.php:412
msgid "The '\\' character is not allowed in the Description field."
msgstr "ຕົວອັກສອນ '\\' ບໍ່ໄດ້ຮັບອະນຸຍາດໃນຊ່ອງຄຳອະທິບາຍ."

#: src/usr/local/www/firewall_rules_edit.php:507
#, php-format
msgid "%s is only valid with protocol TCP."
msgstr "%s ຖືກຕ້ອງກັບໂປຣໂຕຄໍ TCP ເທົ່ານັ້ນ."

#: src/usr/local/www/firewall_rules_edit.php:510
#, php-format
msgid "%s is only valid if the gateway is set to 'default'."
msgstr "%s ຖືກຕ້ອງເມື່ອເກດເວຖືກຕັ້ງເປັນ 'default' ເທົ່ານັ້ນ."

#: src/usr/local/www/firewall_rules_edit.php:517
#: src/usr/local/www/firewall_nat_out_edit.php:155
msgid "Source bit count"
msgstr "ຈຳນວນບິດຕົ້ນທາງ"

#: src/usr/local/www/firewall_rules_edit.php:522
#: src/usr/local/www/firewall_nat_out_edit.php:155
msgid "Destination bit count"
msgstr "ຈຳນວນບິດປາຍທາງ"

#: src/usr/local/www/firewall_rules_edit.php:529
msgid "Invert match cannot be selected with 'any'."
msgstr "Invert match ບໍ່ສາມາດຖືກເລືອກກັບ 'any' ໄດ້."

#: src/usr/local/www/firewall_rules_edit.php:533
msgid "Invert tagged match cannot be selected without any tags."
msgstr "Invert tagged match ບໍ່ສາມາດຖືກເລືອກໄດ້ໂດຍບໍ່ມີແທັກໃດໆ."

#: src/usr/local/www/firewall_rules_edit.php:546
#: src/etc/inc/web/firewall_nat.inc:342
#, php-format
msgid ""
"%s is not a valid start source port. It must be a port alias or integer "
"between 1 and 65535."
msgstr "%s ບໍ່ແມ່ນພອດຕົ້ນທາງເລີ່ມຕົ້ນທີ່ຖືກຕ້ອງ. ມັນຕ້ອງເປັນ alias ພອດ ຫຼືຈຳນວນເຕັມລະຫວ່າງ 1 ແລະ 65535."

#: src/usr/local/www/firewall_rules_edit.php:549
#: src/etc/inc/web/firewall_nat.inc:345
#, php-format
msgid ""
"%s is not a valid end source port. It must be a port alias or integer "
"between 1 and 65535."
msgstr "%s ບໍ່ແມ່ນພອດຕົ້ນທາງສິ້ນສຸດທີ່ຖືກຕ້ອງ. ມັນຕ້ອງເປັນ alias ພອດ ຫຼືຈຳນວນເຕັມລະຫວ່າງ 1 ແລະ 65535."

#: src/usr/local/www/firewall_rules_edit.php:552
#: src/etc/inc/web/firewall_nat.inc:348
#, php-format
msgid ""
"%s is not a valid start destination port. It must be a port alias or integer "
"between 1 and 65535."
msgstr "%s ບໍ່ແມ່ນພອດປາຍທາງເລີ່ມຕົ້ນທີ່ຖືກຕ້ອງ. ມັນຕ້ອງເປັນ alias ພອດ ຫຼືຈຳນວນເຕັມລະຫວ່າງ 1 ແລະ 65535."

#: src/usr/local/www/firewall_rules_edit.php:555
#: src/etc/inc/web/firewall_nat.inc:351
#, php-format
msgid ""
"%s is not a valid end destination port. It must be a port alias or integer "
"between 1 and 65535."
msgstr "%s ບໍ່ແມ່ນພອດປາຍທາງສິ້ນສຸດທີ່ຖືກຕ້ອງ. ມັນຕ້ອງເປັນ alias ພອດ ຫຼືຈຳນວນເຕັມລະຫວ່າງ 1 ແລະ 65535."

#: src/usr/local/www/firewall_rules_edit.php:596
#: src/usr/local/www/firewall_rules_edit.php:601
msgid "Alias entries must be a single host or alias."
msgstr "ລາຍການ alias ຕ້ອງເປັນໂຮສດຽວ ຫຼື alias."

#: src/usr/local/www/firewall_rules_edit.php:607
#: src/etc/inc/web/firewall_nat.inc:366
#, php-format
msgid "%s is not a valid source IP address or alias."
msgstr "%s ບໍ່ແມ່ນທີ່ຢູ່ IP ຕົ້ນທາງ ຫຼື alias ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/firewall_rules_edit.php:610
#: src/usr/local/www/firewall_nat_out_edit.php:204
#: src/etc/inc/web/firewall_nat.inc:376
msgid "A valid source bit count must be specified."
msgstr "ຕ້ອງລະບຸຈຳນວນບິດຕົ້ນທາງທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/firewall_rules_edit.php:615
#: src/etc/inc/web/firewall_nat.inc:382
#, php-format
msgid "%s is not a valid destination IP address or alias."
msgstr "%s ບໍ່ແມ່ນທີ່ຢູ່ IP ປາຍທາງ ຫຼື alias ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/firewall_rules_edit.php:623
msgid ""
"The source and destination IP addresses must have the same family (IPv4 / "
"IPv6)."
msgstr "ທີ່ຢູ່ IP ຕົ້ນທາງ ແລະປາຍທາງຕ້ອງມີຄອບຄົວດຽວກັນ (IPv4 / IPv6)."

#: src/usr/local/www/firewall_rules_edit.php:627
msgid "IPv6 addresses cannot be used in IPv4 rules (except within an alias)."
msgstr "ທີ່ຢູ່ IPv6 ບໍ່ສາມາດໃຊ້ໃນກົດລະບຽບ IPv4 (ຍົກເວັ້ນພາຍໃນ alias)."

#: src/usr/local/www/firewall_rules_edit.php:630
msgid "IPv4 addresses can not be used in IPv6 rules (except within an alias)."
msgstr "ທີ່ຢູ່ IPv4 ບໍ່ສາມາດໃຊ້ໃນກົດລະບຽບ IPv6 (ຍົກເວັ້ນພາຍໃນ alias)."

#: src/usr/local/www/firewall_rules_edit.php:634
msgid ""
"IPv4 and IPv6 addresses can not be used in rules that apply to both IPv4 and "
"IPv6 (except within an alias)."
msgstr "ທີ່ຢູ່ IPv4 ແລະ IPv6 ບໍ່ສາມາດໃຊ້ໃນກົດລະບຽບທີ່ໃຊ້ກັບທັງ IPv4 ແລະ IPv6 (ຍົກເວັ້ນພາຍໃນ alias)."

#: src/usr/local/www/firewall_rules_edit.php:651
msgid "OS detection is only valid with protocol TCP."
msgstr "ການກວດຫາ OS ຖືກຕ້ອງກັບໂປຣໂຕຄໍ TCP ເທົ່ານັ້ນ."

#: src/usr/local/www/firewall_rules_edit.php:654
msgid "Invalid OS detection selection. Please select a valid OS."
msgstr "ການເລືອກການກວດຫາ OS ບໍ່ຖືກຕ້ອງ. ກະລຸນາເລືອກ OS ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/firewall_rules_edit.php:662
msgid "ICMP types expected to be a list if present, but is not."
msgstr "ປະເພດ ICMP ຄາດວ່າຈະເປັນລາຍການຖ້າມີ, ແຕ່ບໍ່ແມ່ນ."

#: src/usr/local/www/firewall_rules_edit.php:681
#, php-format
msgid "Invalid ICMP subtype: %s can not be used with %s."
msgstr "ປະເພດຍ່ອຍ ICMP ບໍ່ຖືກຕ້ອງ: %s ບໍ່ສາມາດໃຊ້ກັບ %s."

#: src/usr/local/www/firewall_rules_edit.php:690
msgid "A queue must be selected when an acknowledge queue is also selected."
msgstr "ຕ້ອງເລືອກຄິວເມື່ອເລືອກຄິວ acknowledge ໄວ້ເຊັ່ນກັນ."

#: src/usr/local/www/firewall_rules_edit.php:692
msgid "Acknowledge queue and Queue cannot be the same."
msgstr "ຄິວ Acknowledge ແລະຄິວບໍ່ສາມາດເປັນອັນດຽວກັນໄດ້."

#: src/usr/local/www/firewall_rules_edit.php:696
msgid ""
"Limiters can not be used in Floating rules without choosing a direction."
msgstr "ຕົວຈຳກັດບໍ່ສາມາດໃຊ້ໃນກົດລະບຽບ Floating ໂດຍບໍ່ເລືອກທິດທາງ."

#: src/usr/local/www/firewall_rules_edit.php:699
msgid ""
"Gateways can not be used in Floating rules without choosing a direction."
msgstr "ເກດເວບໍ່ສາມາດໃຊ້ໃນກົດລະບຽບ Floating ໂດຍບໍ່ເລືອກທິດທາງ."

#: src/usr/local/www/firewall_rules_edit.php:703
msgid ""
"A queue must be selected for the In direction before selecting one for Out "
"too."
msgstr "ຕ້ອງເລືອກຄິວສຳລັບທິດທາງ In ກ່ອນທີ່ຈະເລືອກອັນໜຶ່ງສຳລັບ Out ເຊັ່ນກັນ."

#: src/usr/local/www/firewall_rules_edit.php:705
msgid "In and Out Queue cannot be the same."
msgstr "ຄິວ In ແລະ Out ບໍ່ສາມາດເປັນອັນດຽວກັນໄດ້."

#: src/usr/local/www/firewall_rules_edit.php:707
#: src/usr/local/www/firewall_rules_edit.php:709
msgid ""
"A queue and a virtual interface cannot be selected for IN and Out. Both must "
"be from the same type."
msgstr "ຄິວ ແລະອິນເຕີເຟສສະເໝືອນບໍ່ສາມາດຖືກເລືອກສຳລັບ IN ແລະ Out. ທັງສອງຕ້ອງມາຈາກປະເພດດຽວກັນ."

#: src/usr/local/www/firewall_rules_edit.php:712
msgid ""
"Please select a gateway, normally the interface selected gateway, so the "
"limiters work correctly"
msgstr "ກະລຸນາເລືອກເກດເວ, ໂດຍປົກກະຕິເກດເວທີ່ເລືອກຂອງອິນເຕີເຟສ, ເພື່ອໃຫ້ຕົວຈຳກັດເຮັດວຽກຢ່າງຖືກຕ້ອງ"

#: src/usr/local/www/firewall_rules_edit.php:716
msgid "ID must be an integer"
msgstr "ID ຕ້ອງເປັນຈຳນວນເຕັມ"

#: src/usr/local/www/firewall_rules_edit.php:721
msgid ""
"The maximum number of established connections per host (advanced option) can "
"only be specified for TCP protocol."
msgstr "ຈຳນວນສູງສຸດຂອງການເຊື່ອມຕໍ່ທີ່ສ້າງຕັ້ງຂຶ້ນຕໍ່ໂຮສ (ຕົວເລືອກຂັ້ນສູງ) ສາມາດລະບຸໄດ້ສຳລັບໂປຣໂຕຄໍ TCP ເທົ່ານັ້ນ."

#: src/usr/local/www/firewall_rules_edit.php:724
msgid ""
"The maximum new connections per host / per second(s) (advanced option) can "
"only be specified for TCP protocol."
msgstr "ຈຳນວນການເຊື່ອມຕໍ່ໃໝ່ສູງສຸດຕໍ່ໂຮສ / ຕໍ່ວິນາທີ (ຕົວເລືອກຂັ້ນສູງ) ສາມາດລະບຸໄດ້ສຳລັບໂປຣໂຕຄໍ TCP ເທົ່ານັ້ນ."

#: src/usr/local/www/firewall_rules_edit.php:730
msgid ""
"The maximum state entries (advanced option) can only be specified for Pass "
"type rules."
msgstr "ຈຳນວນລາຍການສະຖານະສູງສຸດ (ຕົວເລືອກຂັ້ນສູງ) ສາມາດລະບຸໄດ້ສຳລັບກົດລະບຽບປະເພດ Pass ເທົ່ານັ້ນ."

#: src/usr/local/www/firewall_rules_edit.php:733
msgid ""
"The maximum number of unique source hosts (advanced option) can only be "
"specified for Pass type rules."
