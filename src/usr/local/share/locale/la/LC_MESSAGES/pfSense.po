#: src/etc/inc/shaper.inc:4450 src/etc/inc/shaper.inc:4896
msgid "Queue Management Algorithm"
msgstr "ອັງຄານການຄຸ້ມຄອງຄິວ"

#: src/etc/inc/shaper.inc:4455
msgid "Active queue management (AQM) is the intelligent drop of network packets inside the limiter, when it becomes full or gets close to becoming full, with the goal of reducing network congestion."
msgstr "ການຄຸ້ມຄອງຄິວ Active (AQM) ແມ່ນການປ່ອຍເປັນ packets ໃນຄິວຂອງຕົວຈຳກັດນີ້, ເມື່ອມັນເຕັມຫຼືເອົາເທິງການເຕັມ, ເພື່ອປ້ອງກັນ network congestion."

#: src/etc/inc/shaper.inc:4462 src/etc/inc/shaper.inc:4908
msgid "Specifies the queue management algorithm parameters."
msgstr "ລະບຸຄ່າພາລາເມັດຂອງອັງຄານການຄຸ້ມຄອງຄິວ."

#: src/etc/inc/shaper.inc:4466
msgid "Scheduler"
msgstr "ເຄື່ອງຈັດລຽງ"

#: src/etc/inc/shaper.inc:4471
msgid "The scheduler manages the sequence of network packets in the limiter's queue."
msgstr "ເຄື່ອງຈັດລຽງຈັດການລຳດັບຂອງ packets ເຄື່ອຂ່າຍໃນຄິວຂອງຕົວຈຳກັດ."

#: src/etc/inc/shaper.inc:4476
msgid "Specifies the scheduler parameters."
msgstr "ລະບຸຄ່າພາລາເມັດຂອງເຄື່ອງຈັດລຽງ."

#: src/etc/inc/shaper.inc:4480 src/etc/inc/shaper.inc:4912
msgid "Queue length"
msgstr "ຄວາມຍາວຂອງຄິວ"

#: src/etc/inc/shaper.inc:4483
msgid "Specifies the length of the limiter's queue, which the scheduler and AQM are responsible for. This field may be left empty."
msgstr "ລະບຸຄວາມຍາວຂອງຄິວຂອງຕົວຈຳກັດ, ເຊິ່ງ scheduler ແລະ AQM ມີຄວາມຮັບຜິດຊອບ. ຟີວນີ້ສາມາດປ່ອຍໃຫ້ຫວ່າງໄດ້."

#: src/etc/inc/shaper.inc:4488 src/etc/inc/shaper.inc:4919
msgid "ECN"
msgstr "ECN"

#: src/etc/inc/shaper.inc:4492 src/etc/inc/shaper.inc:4923
msgid "ECN sets a reserved TCP flag when the queue is nearing or exceeding capacity. Not all AQMs or schedulers support this."
msgstr "ECN ຕັ້ງ flag TCP ສຳຮອງເມື່ອຄິວກຳລັງໄກ້ຮອດຫຼືເກີນຂະໜາດ. ບໍ່ເບິ່ງການສະໜັບສະໜູນເຫຼົ່ານີ້ໃນ AQMs ຫຼື scheduler ທັງໝົດ."

#: src/etc/inc/shaper.inc:4504
msgid "In most cases, zero (0) should specified here (or leave the field empty)."
msgstr "ໃນຫຼາຍກໍລະນີ, ຄວນລະບຸເປັນເລກສູນ (0) ທີ່ນີ້ (ຫຼືປ່ອຍໃຫ້ຫວ່າງໄດ້)."

#: src/etc/inc/shaper.inc:4508 src/etc/inc/shaper.inc:4941
msgid "Packet Loss Rate"
msgstr "ອັດຕາການສູນເສຍ Packet"

#: src/etc/inc/shaper.inc:4512
msgid "In most cases, zero (0) should be specified here (or leave the field empty). A value of 0.001 means one packet in 1000 gets dropped."
msgstr "ໃນຫຼາຍກໍລະນີ, ຄວນລະບຸເປັນເລກສູນ (0) ທີ່ນີ້ (ຫຼືປ່ອຍໃຫ້ຫວ່າງໄດ້). ຄ່າ 0.001 ໝາຍຄວາມວ່າແພັກເກັດໜຶ່ງໃນ 1000 ຈະຖືກປ່ອຍເສັຽ."

#: src/etc/inc/shaper.inc:4517 src/etc/inc/shaper.inc:4950
msgid "Bucket size (slots)"
msgstr "ຂະໜາດກະຕ່າ (slots)"

#: src/etc/inc/shaper.inc:4520
msgid "In most cases, this field should be left empty. It increases the hash size set."
msgstr "ໃນຫຼາຍກໍລະນີ, ຟີວນີ້ຄວນປ່ອຍໃຫ້ຫວ່າງໄດ້. ມັນເພີ່ມຂະໜາດ hash."

#: src/etc/inc/shaper.inc:4643
msgid "Explicit Congestion Notification is selected, but "
msgstr "ການແຈ້ງຢືນຢັນແບບເປັນຂໍ້ມູນຖືກເລືອກແລ້ວ, ແຕ່ "

#: src/etc/inc/shaper.inc:4649
msgid "Weight must be an integer between 1 and 100."
msgstr "ນໍ້າໜັກຕ້ອງເປັນເລກທັງໝົດລະຫວ່າງ 1 ຫາ 100."

#: src/etc/inc/shaper.inc:4857
msgid "If \"source\" or \"destination\" slots is chosen a dynamic queue with the bandwidth, delay, packet loss and queue size given above will be created for each source/destination IP address encountered, respectively. This makes it possible to easily specify bandwidth limits per host or subnet, usually capped by the bandwidth of the parent limiter."
msgstr "ຖ້າ \"source\" ຫຼື \"destination\" slots ເຖິງຖືກເລືອກແຕ່ລະ IP ທີ່ທຳອິດ, ຄິວປະຈຳເຊິ່ງມີ bandwidth, delay, packet loss ແລະຂະໜາດຄິວທີ່ກ່າວມາຂ້າງເທິງນີ້ຈະເປັນໃບສະບຽງຂອງເປົ້າຫມາຍແຕ່ລະ IP. ເຮັດໃຫ້ສາມາດລະບຸ bandwidth limits ຂອງໂຮສຕ໌ຫຼື subnet ໃຫ້ໄດ້ງ່າຍເຫຼືອນຳໂດຍ bandwidth ຂອງ parent limiter."

#: src/etc/inc/shaper.inc:4901
msgid "Active queue management (AQM) is the intelligent drop of network packets inside this limiter's queue, when it becomes full or gets close to becoming full, with the goal of reducing network congestion."
msgstr "ການຄຸ້ມຄອງຄິວ Active (AQM) ແມ່ນການປ່ອຍເປັນ packets ໃນຄິວຂອງຕົວຈຳກັດນີ້, ເມື່ອມັນເຕັມຫຼືເອົາເທິງການເຕັມ, ເພື່ອປ້ອງກັນ network congestion."

#: src/etc/inc/shaper.inc:4915
msgid "Specifies the length of this queue, which the AQM is responsible for. This field may be left empty."
msgstr "ລະບຸຄວາມຍາວຂອງຄິວນີ້, ເຊິ່ງ AQM ມີຄວາມຮັບຜິດຊອບ. ຟີວນີ້ສາມາດປ່ອຍໃຫ້ຫວ່າງໄດ້."

#: src/etc/inc/shaper.inc:4936
msgid "For queues under the same parent this specifies the share that a queue gets(values range from 1 to 100), it can be left blank otherwise."
msgstr "ສຳຫຼັບຄິວທີ່ຢູ່ພາຍໃຕ້ຄົນດຽວກັນນີ້ ການນີ້ຈະລະບຸສະຫວນທີ່ຄິວໄດ້(ຄ່າຂອບເຂດຈາກ 1 ຫາ 100), ມິຊະນັ້ນສາມາດປ່ອຍໃຫ້ຫວ່າງໄດ້."

#: src/etc/inc/shaper.inc:4945
msgid "In most cases, zero (0) should be specified here (or leave the field empty). A value of 0.001 means one packet in 1000 gets dropped"
msgstr "ໃນຫຼາຍກໍລະນີ, ຄວນລະບຸເປັນເລກສູນ (0) ທີ່ນີ້ (ຫຼືປ່ອຍໃຫ້ຫວ່າງໄດ້). ຄ່າ 0.001 ໝາຍຄວາມວ່າແພັກເກັດໜຶ່ງໃນ 1000 ຈະຖືກປ່ອຍເສັຽ"

#: src/etc/inc/shaper.inc:4953
msgid "In most cases, this field should be left empty. It increases the hash size set"
msgstr "ໃນຫຼາຍກໍລະນີ, ຟີວນີ້ຄວນປ່ອຍໃຫ້ຫວ່າງໄດ້. ມັນເພີ່ມຂະໜາດ hash"

