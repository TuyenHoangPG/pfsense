#: src/etc/inc/dyndns.class:1838
msgid "Unknown Response:"
msgstr "ຄຳຕອບທີ່ບໍ່ຮູ້ຈັກ:"

#: src/etc/inc/dyndns.class:1844 
#: src/etc/inc/dyndns.class:1862
msgid "Authentication Failed: Username and/or Password was Incorrect."
msgstr "ການກວດສອບລົ້ມເຫຼວ: ຊື່ຜູ້ໃຊ້ແລະ/ຫຼືລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ."

