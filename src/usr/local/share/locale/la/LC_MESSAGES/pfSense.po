#: src/usr/local/www/services_dhcp.php:241
#: src/usr/local/www/services_dhcp_edit.php:164
msgid "The DHCP option must be a number between 1 and 254."
msgstr "ຕົວເລືອກ DHCP ຕ້ອງເປັນຕົວເລກລະຫວ່າງ 1 ຫາ 254."

#: src/usr/local/www/services_dhcp.php:267
msgid ""
"The specified OMAPI port number is invalid. Port number must be between 1024 "
"and 65635."
msgstr ""
"ໝາຍເລກພອດ OMAPI ທີ່ລະບຸບໍ່ຖືກຕ້ອງ. ໝາຍເລກພອດຕ້ອງຢູ່ລະຫວ່າງ 1024 ຫາ 65635."

#: src/usr/local/www/services_dhcp.php:270
msgid ""
"Specified port number for OMAPI is in use. Please choose another port or "
"consider using the default."
msgstr ""
"ໝາຍເລກພອດທີ່ລະບຸສຳລັບ OMAPI ຖືກໃຊ້ແລ້ວ. ກະລຸນາເລືອກພອດອື່ນ ຫຼືພິຈາລະນາໃຊ້ຄ່າເລີ່ມຕົ້ນ."

#: src/usr/local/www/services_dhcp.php:320
msgid "A key is required when OMAPI is enabled (port specified)."
msgstr "ກະແຈແມ່ນຕ້ອງການເມື່ອເປີດใช้งาน OMAPI (ລະບຸພອດ)."

#: src/usr/local/www/services_dhcp.php:327
msgid "Range begin"
msgstr "ຂອບເຂດເລີ່ມຕົ້ນ"

#: src/usr/local/www/services_dhcp.php:327
msgid "Range end"
msgstr "ຂອບເຂດສິ້ນສຸດ"

#: src/usr/local/www/services_dhcp.php:333
msgid ""
"Ignore Denied Clients may not be used when a Failover Peer IP is defined."
msgstr "Ignore Denied Clients ອາດຈະບໍ່ຖືກໃຊ້ເມື່ອໄດ້ກຳນົດ Failover Peer IP."

#: src/usr/local/www/services_dhcp.php:337
msgid "A valid IPv4 address must be specified for range from."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv4 ທີ່ຖືກຕ້ອງສຳລັບຂອບເຂດຈາກ."

#: src/usr/local/www/services_dhcp.php:340
msgid "A valid IPv4 address must be specified for range to."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IPv4 ທີ່ຖືກຕ້ອງສຳລັບຂອບເຂດເຖິງ."

#: src/usr/local/www/services_dhcp.php:346
msgid "A valid IP address must be specified for the gateway."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ທີ່ຖືກຕ້ອງສຳລັບ gateway."

#: src/usr/local/www/services_dhcp.php:349
msgid ""
"A valid IP address must be specified for the primary/secondary WINS servers."
msgstr ""
"ຕ້ອງລະບຸທີ່ຢູ່ IP ທີ່ຖືກຕ້ອງສຳລັບເຊີບເວີ WINS ຫຼັກ/ຮອງ."

#: src/usr/local/www/services_dhcp.php:355
#: src/usr/local/www/services_dhcp_edit.php:268
#, php-format
msgid ""
"The gateway address %s does not lie within the chosen interface's subnet."
msgstr ""
"ທີ່ຢູ່ gateway %s ບໍ່ໄດ້ຢູ່ໃນ subnet ຂອງອິນເຕີເຟດທີ່ເລືອກ."

#: src/usr/local/www/services_dhcp.php:360
msgid "A valid IP address must be specified for each of the DNS servers."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ທີ່ຖືກຕ້ອງສຳລັບເຊີບເວີ DNS ແຕ່ລະອັນ."

#: src/usr/local/www/services_dhcp.php:386
#, php-format
msgid ""
"The Captive Portal zone (%1$s) has Hard Timeout parameter set to a value "
"bigger than Default lease time (%2$s)."
msgstr ""
"ເຂດ Captive Portal (%1$s) ມີພາລາມິເຕີ Hard Timeout ຕັ້ງເປັນຄ່າທີ່ໃຫຍ່ກວ່າ Default lease time (%2$s)."

#: src/usr/local/www/services_dhcp.php:426
msgid ""
"If a mac allow list is specified, it must contain only valid partial MAC "
"addresses."
msgstr ""
"ຖ້າລະບຸລາຍການອະນຸຍາດ mac, ມັນຕ້ອງມີພຽງແຕ່ທີ່ຢູ່ MAC ບາງສ່ວນທີ່ຖືກຕ້ອງເທົ່ານັ້ນ."

#: src/usr/local/www/services_dhcp.php:429
msgid ""
"If a mac deny list is specified, it must contain only valid partial MAC "
"addresses."
msgstr ""
"ຖ້າລະບຸລາຍການປະຕິເສດ mac, ມັນຕ້ອງມີພຽງແຕ່ທີ່ຢູ່ MAC ບາງສ່ວນທີ່ຖືກຕ້ອງເທົ່ານັ້ນ."

#: src/usr/local/www/services_dhcp.php:435
#: src/usr/local/www/services_dhcp_edit.php:317
msgid ""
"A valid IP address or hostname must be specified for the primary/secondary "
"NTP servers."
msgstr ""
"ຕ້ອງລະບຸທີ່ຢູ່ IP ຫຼືຊື່ໂຮສທີ່ຖືກຕ້ອງສຳລັບເຊີບເວີ NTP ຫຼັກ/ຮອງ."

#: src/usr/local/www/services_dhcp.php:441
msgid ""
"A valid IP address, hostname or URL must be specified for the TFTP server."
msgstr ""
"ຕ້ອງລະບຸທີ່ຢູ່ IP, ຊື່ໂຮສ ຫຼື URL ທີ່ຖືກຕ້ອງສຳລັບເຊີບເວີ TFTP."

#: src/usr/local/www/services_dhcp.php:444
msgid "A valid IP address must be specified for the network boot server."
msgstr "ຕ້ອງລະບຸທີ່ຢູ່ IP ທີ່ຖືກຕ້ອງສຳລັບເຊີບເວີ boot ເຄືອຂ່າຍ."

#: src/usr/local/www/services_dhcp.php:448
msgid "The network address cannot be used in the starting subnet range."
msgstr "ທີ່ຢູ່ເຄືອຂ່າຍບໍ່ສາມາດໃຊ້ໃນຂອບເຂດ subnet ເລີ່ມຕົ້ນ."

#: src/usr/local/www/services_dhcp.php:451
msgid "The broadcast address cannot be used in the ending subnet range."
msgstr "ທີ່ຢູ່ broadcast ບໍ່ສາມາດໃຊ້ໃນຂອບເຂດ subnet ສິ້ນສຸດ."

#: src/usr/local/www/services_dhcp.php:459
#, php-format
msgid "The subnet range cannot overlap with virtual IP address %s."
msgstr "ຂອບເຂດ subnet ບໍ່ສາມາດຊ້ຳກັບທີ່ຢູ່ IP ເສມືນ %s."

#: src/usr/local/www/services_dhcp.php:475
msgid ""
"Cannot enable static ARP when there are static map entries without IP "
"addresses. Ensure all static maps have IP addresses and try again."
msgstr ""
"ບໍ່ສາມາດເປີດใช้งาน static ARP ເມື່ອມີລາຍການ static map ທີ່ບໍ່ມີທີ່ຢູ່ IP. ໃຫ້ແນ່ໃຈວ່າແຜນທີ່ static ທັງໝົດມີທີ່ຢູ່ IP ແລະລອງໃໝ່."

#: src/usr/local/www/services_dhcp.php:482
msgid "Text type cannot include quotation marks."
msgstr "ປະເພດຂໍ້ຄວາມບໍ່ສາມາດລວມເອົາເຄື່ອງໝາຍວົງຢືມ."

#: src/usr/local/www/services_dhcp.php:484
msgid ""
"String type must be enclosed in quotes like \"this\" or must be a series of "
"octets specified in hexadecimal, separated by colons, like 01:23:45:67:89:ab:"
"cd:ef"
msgstr ""
"ປະເພດສະຕຣິງຕ້ອງຖືກປິດລ້ອມດ້ວຍວົງຢືມເຊັ່ນ \"this\" ຫຼືຕ້ອງເປັນຊຸດຂອງ octets ທີ່ລະບຸໃນເລກຖານສິບຫົກ, ແຍກດ້ວຍເຄື່ອງໝາຍຈຸດ, ເຊັ່ນ 01:23:45:67:89:ab:cd:ef"

#: src/usr/local/www/services_dhcp.php:486
msgid "Boolean type must be true, false, on, or off."
msgstr "ປະເພດ Boolean ຕ້ອງເປັນ true, false, on, ຫຼື off."

#: src/usr/local/www/services_dhcp.php:488
msgid "Unsigned 8-bit integer type must be a number in the range 0 to 255."
msgstr "ປະເພດຈຳນວນເຕັມ 8-bit ທີ່ບໍ່ມີເຄື່ອງໝາຍຕ້ອງເປັນຕົວເລກໃນຊ່ວງ 0 ຫາ 255."

#: src/usr/local/www/services_dhcp.php:490
msgid "Unsigned 16-bit integer type must be a number in the range 0 to 65535."
msgstr "ປະເພດຈຳນວນເຕັມ 16-bit ທີ່ບໍ່ມີເຄື່ອງໝາຍຕ້ອງເປັນຕົວເລກໃນຊ່ວງ 0 ຫາ 65535."

#: src/usr/local/www/services_dhcp.php:492
msgid ""
"Unsigned 32-bit integer type must be a number in the range 0 to 4294967295."
msgstr ""
"ປະເພດຈຳນວນເຕັມ 32-bit ທີ່ບໍ່ມີເຄື່ອງໝາຍຕ້ອງເປັນຕົວເລກໃນຊ່ວງ 0 ຫາ 4294967295."

#: src/usr/local/www/services_dhcp.php:494
msgid "Signed 8-bit integer type must be a number in the range -128 to 127."
msgstr "ປະເພດຈຳນວນເຕັມ 8-bit ທີ່ມີເຄື່ອງໝາຍຕ້ອງເປັນຕົວເລກໃນຊ່ວງ -128 ຫາ 127."

#: src/usr/local/www/services_dhcp.php:496
msgid ""
"Signed 16-bit integer type must be a number in the range -32768 to 32767."
msgstr ""
"ປະເພດຈຳນວນເຕັມ 16-bit ທີ່ມີເຄື່ອງໝາຍຕ້ອງເປັນຕົວເລກໃນຊ່ວງ -32768 ຫາ 32767."

#: src/usr/local/www/services_dhcp.php:498
msgid ""
"Signed 32-bit integer type must be a number in the range -2147483648 to "
"2147483647."
msgstr ""
"ປະເພດຈຳນວນເຕັມ 32-bit ທີ່ມີເຄື່ອງໝາຍຕ້ອງເປັນຕົວເລກໃນຊ່ວງ -2147483648 ຫາ 2147483647."

#: src/usr/local/www/services_dhcp.php:500
msgid "IP address or host type must be an IP address or host name."
msgstr "ປະເພດທີ່ຢູ່ IP ຫຼືໂຮສຕ້ອງເປັນທີ່ຢູ່ IP ຫຼືຊື່ໂຮສ."

#: src/usr/local/www/services_dhcp.php:534
msgid ""
"DHCP Registration features in the DNS Forwarder are active and require at "
"least one enabled DHCP Server."
msgstr ""
"ຄຸນສົມບັດການລົງທະບຽນ DHCP ໃນ DNS Forwarder ເປີດใช้งานຢູ່ ແລະຕ້ອງການເຊີບເວີ DHCP ທີ່ເປີດใช้งานຢ່າງໜ້ອຍໜຶ່ງອັນ."

#: src/usr/local/www/services_dhcp.php:541
msgid ""
"DHCP Registration features in the DNS Resolver are active and require at "
"least one enabled DHCP Server."
msgstr ""
"ຄຸນສົມບັດການລົງທະບຽນ DHCP ໃນ DNS Resolver ເປີດใช้งานຢູ່ ແລະຕ້ອງການເຊີບເວີ DHCP ທີ່ເປີດใช้งานຢ່າງໜ້ອຍໜຶ່ງອັນ."

#: src/usr/local/www/services_dhcp.php:565
msgid ""
"The specified range must not be within the DHCP range for this interface."
msgstr ""
"ຂອບເຂດທີ່ລະບຸຕ້ອງບໍ່ຢູ່ໃນຂອບເຂດ DHCP ສໍາລັບອິນເຕີເຟດນີ້."

#: src/usr/local/www/services_dhcp.php:578
msgid ""
"The specified range must not be within the range configured on a DHCP pool "
"for this interface."
msgstr ""
"ຂອບເຂດທີ່ລະບຸຕ້ອງບໍ່ຢູ່ໃນຂອບເຂດທີ່ຕັ້ງຄ່າໃນ pool DHCP ສໍາລັບອິນເຕີເຟດນີ້."

#: src/usr/local/www/services_dhcp.php:768
msgid "DHCP Server - Settings changed for interface "
msgstr "ເຊີບເວີ DHCP - ການຕັ້ງຄ່າປ່ຽນແປງສໍາລັບອິນເຕີເຟດ"

#: src/usr/local/www/services_dhcp.php:869
#: src/usr/local/www/status_dhcp_leases.php:333
msgid "Pool Start"
msgstr "Pool ເລີ່ມຕົ້ນ"

#: src/usr/local/www/services_dhcp.php:870
#: src/usr/local/www/status_dhcp_leases.php:334
msgid "Pool End"
msgstr "Pool ສິ້ນສຸດ"

#: src/usr/local/www/services_dhcp.php:891
msgid "Edit pool"
msgstr "ແກ້ໄຂ pool"

#: src/usr/local/www/services_dhcp.php:893
msgid "Delete pool"
msgstr "ລຶບ pool"

#: src/usr/local/www/services_dhcp.php:907
#: src/usr/local/www/services_dhcp_edit.php:445
#: src/usr/local/www/diag_backup.php:84 src/usr/local/www/head.inc:324
msgid "DHCP Server"
msgstr "ເຊີບເວີ DHCP"

#: src/usr/local/www/services_dhcp.php:962
#, php-format
msgid "%1$s has a CIDR mask of %2$s, which does not contain enough addresses."
msgstr "%1$s ມີ CIDR mask ເປັນ %2$s, ເຊິ່ງບໍ່ມີທີ່ຢູ່ພຽງພໍ."

#: src/usr/local/www/services_dhcp.php:964
msgid "This system has no interfaces configured with a static IPv4 address."
msgstr "ລະບົບນີ້ບໍ່ມີອິນເຕີເຟດທີ່ຕັ້ງຄ່າດ້ວຍທີ່ຢູ່ IPv4 ຄົງທີ່."

#: src/usr/local/www/services_dhcp.php:966
msgid ""
"The DHCP Server requires a static IPv4 subnet large enough to serve "
"addresses to clients."
msgstr ""
"ເຊີບເວີ DHCP ຕ້ອງການ subnet IPv4 ຄົງທີ່ຂະໜາດໃຫຍ່ພໍທີ່ຈະໃຫ້ບໍລິການທີ່ຢູ່ແກ່ລູກຄ້າ."

#: src/usr/local/www/services_dhcp.php:975 src/usr/local/www/pkg_edit.php:749
msgid "General Options"
msgstr "ຕົວເລືອກທົ່ວໄປ"

#: src/usr/local/www/services_dhcp.php:982
msgid ""
"DHCP Relay is currently enabled. DHCP Server canot be enabled while the DHCP "
"Relay is enabled on any interface."
msgstr ""
"DHCP Relay ເປີດใช้งานຢູ່. ເຊີບເວີ DHCP ບໍ່ສາມາດເປີດใช้งานໄດ້ໃນຂະນະທີ່ DHCP Relay ເປີດใช้งานຢູ່ໃນອິນເຕີເຟດໃດໆ."

#: src/usr/local/www/services_dhcp.php:989
#, php-format
msgid "Enable DHCP server on %s interface"
msgstr "ເປີດใช้งานເຊີບເວີ DHCP ໃນອິນເຕີເຟດ %s"

#: src/usr/local/www/services_dhcp.php:994
msgid ""
"Editing pool-specific options. To return to the Interface, click its tab "
"above."
msgstr ""
"ກຳລັງແກ້ໄຂຕົວເລືອກສະເພາະ pool. ເພື່ອກັບຄືນໄປທີ່ອິນເຕີເຟດ, ໃຫ້ຄລິກແຖບຂອງມັນຢູ່ດ້ານເທິງ."

#: src/usr/local/www/services_dhcp.php:999
msgid "BOOTP"
msgstr "BOOTP"

#: src/usr/local/www/services_dhcp.php:1006
msgid "Deny unknown clients"
msgstr "ປະຕິເສດລູກຄ້າທີ່ບໍ່ຮູ້ຈັກ"

#: src/usr/local/www/services_dhcp.php:1013
#, php-format
msgid ""
"When set to %3$sAllow all clients%4$s, any DHCP client will get an IP "
"address within this scope/range on this interface. If set to %3$sAllow known "
"clients from any interface%4$s, any DHCP client with a MAC address listed on "
"%1$s%3$sany%4$s%2$s scope(s)/interface(s) will get an IP address. If set to "
"%3$sAllow known clients from only this interface%4$s, only MAC addresses "
"listed below (i.e. for this interface) will get an IP address within this "
"scope/range."
msgstr ""
"ເມື່ອຕັ້ງເປັນ %3$sອະນຸຍາດລູກຄ້າທັງໝົດ%4$s, ລູກຄ້າ DHCP ໃດໆກໍຈະໄດ້ຮັບທີ່ຢູ່ IP ພາຍໃນຂອບເຂດ/ຂອບເຂດນີ້ໃນອິນເຕີເຟດນີ້. ຖ້າຕັ້ງເປັນ %3$sອະນຸຍາດລູກຄ້າທີ່ຮູ້ຈັກຈາກອິນເຕີເຟດໃດໆ%4$s, ລູກຄ້າ DHCP ໃດໆທີ່ມີທີ່ຢູ່ MAC ຢູ່ໃນລາຍຊື່ໃນຂອບເຂດ/ອິນເຕີເຟດ %1$s%3$sໃດໆ%4$s%2$s ຈະໄດ້ຮັບທີ່ຢູ່ IP. ຖ້າຕັ້ງເປັນ %3$sອະນຸຍາດລູກຄ້າທີ່ຮູ້ຈັກຈາກອິນເຕີເຟດນີ້ເທົ່ານັ້ນ%4$s, ມີພຽງແຕ່ທີ່ຢູ່ MAC ທີ່ລະບຸໄວ້ຂ້າງລຸ່ມ (ເຊັ່ນ: ສຳລັບອິນເຕີເຟດນີ້) ເທົ່ານັ້ນທີ່ຈະໄດ້ຮັບທີ່ຢູ່ IP ພາຍໃນຂອບເຂດ/ຂອບເຂດນີ້."

#: src/usr/local/www/services_dhcp.php:1020
msgid "Ignore denied clients"
msgstr "ບໍ່ສົນໃຈລູກຄ້າທີ່ຖືກປະຕິເສດ"

#: src/usr/local/www/services_dhcp.php:1023
msgid ""
"This option is not compatible with failover and cannot be enabled when a "
"Failover Peer IP address is configured."
msgstr ""
"ຕົວເລືອກນີ້ບໍ່ເຂົ້າກັນກັບ failover ແລະບໍ່ສາມາດເປີດใช้งานໄດ້ເມື່ອໄດ້ຕັ້ງຄ່າທີ່ຢູ່ IP Failover Peer."

#: src/usr/local/www/services_dhcp.php:1027
msgid "Ignore client identifiers"
msgstr "ບໍ່ສົນໃຈຕົວລະບຸລູກຄ້າ"

#: src/usr/local/www/services_dhcp.php:1030
msgid ""
"This option may be useful when a client can dual boot using different client "
"identifiers but the same hardware (MAC) address.  Note that the resulting "
"server behavior violates the official DHCP specification."
msgstr ""
"ຕົວເລືອກນີ້ອາດເປັນປະໂຫຍດເມື່ອລູກຄ້າສາມາດ dual boot ໂດຍໃຊ້ຕົວລະບຸລູກຄ້າທີ່ແຕກຕ່າງກັນແຕ່ມີທີ່ຢູ່ຮາດແວ (MAC) ອັນດຽວກັນ. ໝາຍເຫດວ່າພຶດຕິກຳຂອງເຊີບເວີທີ່ເປັນຜົນລະເມີດຂໍ້ກຳນົດ DHCP ຢ່າງເປັນທາງການ."

#: src/usr/local/www/services_dhcp.php:1036
msgid "Pool Description"
msgstr "ຄຳອະທິບາຍ Pool"

#: src/usr/local/www/services_dhcp.php:1056
msgid "In-use DHCP Pool Ranges:"
msgstr "ຂອບເຂດ Pool DHCP ທີ່ໃຊ້ຢູ່:"

#: src/usr/local/www/services_dhcp.php:1069
msgid "Available range"
msgstr "ຂອບເຂດທີ່ມີຢູ່"

#: src/usr/local/www/services_dhcp.php:1094
msgid "Additional Pools"
msgstr "Pool ເພີ່ມເຕີມ"

#: src/usr/local/www/services_dhcp.php:1098
msgid "Add pool"
msgstr "ເພີ່ມ pool"

#: src/usr/local/www/services_dhcp.php:1107
msgid ""
"If additional pools of addresses are needed inside of this subnet outside "
"the above Range, they may be specified here."
msgstr ""
"ຖ້າຕ້ອງການ pool ທີ່ຢູ່ເພີ່ມເຕີມພາຍໃນ subnet ນີ້ຢູ່ນອກຂອບເຂດຂ້າງເທິງ, ພວກມັນອາດຈະຖືກລະບຸຢູ່ທີ່ນີ້."

#: src/usr/local/www/services_dhcp.php:1123
#: src/usr/local/www/vpn_openvpn_csc.php:584
msgid "WINS servers"
msgstr "ເຊີບເວີ WINS"

#: src/usr/local/www/services_dhcp.php:1138
#: src/usr/local/www/status_interfaces.php:183
msgid "DNS servers"
msgstr "ເຊີບເວີ DNS"

#: src/usr/local/www/services_dhcp.php:1141
msgid ""
"Leave blank to use the system default DNS servers: this interface's IP if "
"DNS Forwarder or Resolver is enabled, otherwise the servers configured on "
"the System / General Setup page."
msgstr ""
"ປ່ອຍຫວ່າງໄວ້ເພື່ອໃຊ້ເຊີບເວີ DNS ເລີ່ມຕົ້ນຂອງລະບົບ: IP ຂອງອິນເຕີເຟດນີ້ ຖ້າເປີດใช้งาน DNS Forwarder ຫຼື Resolver, ຖ້າບໍ່ດັ່ງນັ້ນເຊີບເວີທີ່ຕັ້ງຄ່າໃນໜ້າ ລະບົບ / ການຕັ້ງຄ່າທົ່ວໄປ."

#: src/usr/local/www/services_dhcp.php:1147
msgid "OMAPI"
msgstr "OMAPI"

#: src/usr/local/www/services_dhcp.php:1151
msgid "OMAPI Port"
msgstr "ພອດ OMAPI"

#: src/usr/local/www/services_dhcp.php:1155
msgid ""
"Set the port that OMAPI will listen on. The default port is 7911, leave "
"blank to disable.Only the first OMAPI configuration is used."
msgstr ""
"ຕັ້ງຄ່າພອດທີ່ OMAPI ຈະຟັງ. ພອດເລີ່ມຕົ້ນແມ່ນ 7911, ປ່ອຍຫວ່າງໄວ້ເພື່ອປິດใช้งาน. ມີພຽງແຕ່ການຕັ້ງຄ່າ OMAPI ທຳອິດເທົ່ານັ້ນທີ່ຖືກໃຊ້."

#: src/usr/local/www/services_dhcp.php:1158
#: src/usr/local/www/services_dhcp.php:1162
msgid "OMAPI Key"
msgstr "ກະແຈ OMAPI"

#: src/usr/local/www/services_dhcp.php:1166
msgid ""
"Enter a key matching the selected algorithm<br />to secure connections to "
"the OMAPI endpoint."
msgstr ""
"ໃສ່ກະແຈທີ່ກົງກັບອັລກໍຣິທຶມທີ່ເລືອກ<br />ເພື່ອຮັກສາຄວາມປອດໄພການເຊື່ອມຕໍ່ກັບຈຸດສິ້ນສຸດ OMAPI."

#: src/usr/local/www/services_dhcp.php:1173
msgid "Generate a new key based<br />on the selected algorithm."
msgstr "ສ້າງກະແຈໃໝ່ໂດຍອີງ<br />ໃສ່ອັລກໍຣິທຶມທີ່ເລືອກ."

#: src/usr/local/www/services_dhcp.php:1179
msgid "Key Algorithm"
msgstr "ອັລກໍຣິທຶມກະແຈ"

#: src/usr/local/www/services_dhcp.php:1189
msgid "Set the algorithm that OMAPI key will use."
msgstr "ຕັ້ງຄ່າອັລກໍຣິທຶມທີ່ກະແຈ OMAPI ຈະໃຊ້."

#: src/usr/local/www/services_dhcp.php:1193
msgid "Other Options"
msgstr "ຕົວເລືອກອື່ນໆ"

#: src/usr/local/www/services_dhcp.php:1201
msgid ""
"The default is to use the IP on this interface of the firewall as the "
"gateway. Specify an alternate gateway here if this is not the correct "
"gateway for the network. Type \"none\" for no gateway assignment."
msgstr ""
"ຄ່າເລີ່ມຕົ້ນແມ່ນການໃຊ້ IP ໃນອິນເຕີເຟດນີ້ຂອງໄຟວໍເປັນ gateway. ລະບຸ gateway ອື່ນຢູ່ທີ່ນີ້ ຖ້ານີ້ບໍ່ແມ່ນ gateway ທີ່ຖືກຕ້ອງສຳລັບເຄືອຂ່າຍ. ພິມ \"none\" ສຳລັບບໍ່ມີການມອບໝາຍ gateway."

#: src/usr/local/www/services_dhcp.php:1208
msgid ""
"The default is to use the domain name of this system as the default domain "
"name provided by DHCP. An alternate domain name may be specified here."
msgstr ""
"ຄ່າເລີ່ມຕົ້ນແມ່ນການໃຊ້ຊື່ໂດເມນຂອງລະບົບນີ້ເປັນຊື່ໂດເມນເລີ່ມຕົ້ນທີ່ສະໜອງໃຫ້ໂດຍ DHCP. ຊື່ໂດເມນອື່ນອາດຈະຖືກລະບຸຢູ່ທີ່ນີ້."

#: src/usr/local/www/services_dhcp.php:1222
msgid ""
"This is used for clients that do not ask for a specific expiration time. The "
"default is 7200 seconds."
msgstr ""
"ນີ້ແມ່ນໃຊ້ສຳລັບລູກຄ້າທີ່ບໍ່ໄດ້ຮ້ອງຂໍເວລາໝົດອາຍຸສະເພາະ. ຄ່າເລີ່ມຕົ້ນແມ່ນ 7200 ວິນາທີ."

#: src/usr/local/www/services_dhcp.php:1226
msgid "Maximum lease time"
msgstr "ເວລາເຊົ່າສູງສຸດ"

#: src/usr/local/www/services_dhcp.php:1229
#: src/usr/local/www/services_dhcp_edit.php:627
msgid ""
"This is the maximum lease time for clients that ask for a specific "
"expiration time. The default is 86400 seconds."
msgstr ""
"ນີ້ແມ່ນເວລາເຊົ່າສູງສຸດສຳລັບລູກຄ້າທີ່ຮ້ອງຂໍເວລາໝົດອາຍຸສະເພາະ. ຄ່າເລີ່ມຕົ້ນແມ່ນ 86400 ວິນາທີ."

#: src/usr/local/www/services_dhcp.php:1234
msgid "Failover peer IP"
msgstr "IP failover peer"

#: src/usr/local/www/services_dhcp.php:1237
msgid ""
"Leave blank to disable. Enter the interface IP address of the other machine. "
"Machines must be using CARP. Interface's advskew determines whether the "
"DHCPd process is Primary or Secondary. Ensure one machine's advskew &lt; 20 "
"(and the other is &gt; 20)."
msgstr ""
"ປ່ອຍຫວ່າງໄວ້ເພື່ອປິດใช้งาน. ໃສ່ທີ່ຢູ່ IP ອິນເຕີເຟດຂອງເຄື່ອງອື່ນ. ເຄື່ອງຈັກຕ້ອງໃຊ້ CARP. advskew ຂອງອິນເຕີເຟດກໍານົດວ່າຂະບວນການ DHCPd ເປັນຫຼັກຫຼືຮອງ. ໃຫ້ແນ່ໃຈວ່າ advskew ຂອງເຄື່ອງຈັກໜຶ່ງ < 20 (ແລະອີກເຄື່ອງໜຶ່ງແມ່ນ > 20)."

#: src/usr/local/www/services_dhcp.php:1242
#: src/usr/local/www/services_dhcp.php:1686
#: src/usr/local/www/widgets/widgets/wake_on_lan.widget.php:114
msgid "Static ARP"
msgstr "Static ARP"

#: src/usr/local/www/services_dhcp.php:1245
msgid ""
"This option persists even if DHCP server is disabled. Only the machines "
"listed below will be able to communicate with the firewall on this interface."
msgstr ""
"ຕົວເລືອກນີ້ຍັງຄົງຢູ່ເຖິງແມ່ນວ່າເຊີບເວີ DHCP ຈະຖືກປິດใช้งาน. ມີພຽງແຕ່ເຄື່ອງຈັກທີ່ລະບຸໄວ້ຂ້າງລຸ່ມເທົ່ານັ້ນທີ່ຈະສາມາດສື່ສານກັບໄຟວໍໃນອິນເຕີເຟດນີ້ໄດ້."

#: src/usr/local/www/services_dhcp.php:1249
msgid "Time format change"
msgstr "ປ່ຽນຮູບແບບເວລາ"

#: src/usr/local/www/services_dhcp.php:1252
msgid ""
"By default DHCP leases are displayed in UTC time.\tBy checking this box DHCP "
"lease time will be displayed in local time and set to the time zone selected."
" This will be used for all DHCP interfaces lease time."
msgstr ""
"ໂດຍຄ່າເລີ່ມຕົ້ນ, ການເຊົ່າ DHCP ຈະຖືກສະແດງໃນເວລາ UTC. ໂດຍການກວດສອບກ່ອງນີ້, ເວລາເຊົ່າ DHCP ຈະຖືກສະແດງໃນເວລາທ້ອງຖິ່ນ ແລະຕັ້ງເປັນເຂດເວລາທີ່ເລືອກ. ນີ້ຈະຖືກໃຊ້ສໍາລັບເວລາເຊົ່າອິນເຕີເຟດ DHCP ທັງໝົດ."

#: src/usr/local/www/services_dhcp.php:1257
msgid "Statistics graphs"
msgstr "ກຣາຟສະຖິຕິ"

#: src/usr/local/www/services_dhcp.php:1260
msgid ""
"Enable this to add DHCP leases statistics to the RRD graphs. Disabled by "
"default."
msgstr ""
"ເປີດใช้งานນີ້ເພື່ອເພີ່ມສະຖິຕິການເຊົ່າ DHCP ໃສ່ກຣາຟ RRD. ປິດใช้งานໂດຍຄ່າເລີ່ມຕົ້ນ."

#: src/usr/local/www/services_dhcp.php:1264
msgid "Ping check"
msgstr "ກວດສອບ Ping"

#: src/usr/local/www/services_dhcp.php:1267
msgid ""
"When enabled dhcpd sends a ping to the address being assigned, and if no "
"response has been heard, it assigns the address. Enabled by default."
msgstr ""
"ເມື່ອເປີດใช้งาน, dhcpd ຈະສົ່ງ ping ໄປຫາທີ່ຢູ່ທີ່ກຳລັງມອບໝາຍ, ແລະຖ້າບໍ່ມີການຕອບຮັບ, ມັນຈະມອບໝາຍທີ່ຢູ່. ເປີດใช้งานໂດຍຄ່າເລີ່ມຕົ້ນ."

#: src/usr/local/www/services_dhcp.php:1311
#: src/usr/local/www/services_dhcp_edit.php:671
msgid "Primary domain name server IP address for the dynamic domain name."
msgstr "ທີ່ຢູ່ IP ເຊີບເວີຊື່ໂດເມນຫຼັກສຳລັບຊື່ໂດເມນແບບໄດນາມິກ."

#: src/usr/local/www/services_dhcp.php:1318
#: src/usr/local/www/services_dhcp_edit.php:678
msgid "Secondary domain name server IP address for the dynamic domain name."
msgstr "ທີ່ຢູ່ IP ເຊີບເວີຊື່ໂດເມນຮອງສຳລັບຊື່ໂດເມນແບບໄດນາມິກ."

#: src/usr/local/www/services_dhcp.php:1322
msgid "DNS Domain key"
msgstr "ກະແຈໂດເມນ DNS"

#: src/usr/local/www/services_dhcp.php:1325
