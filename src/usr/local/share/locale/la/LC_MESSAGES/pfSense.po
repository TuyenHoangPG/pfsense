#: src/usr/local/www/services_router_advertisements.php:361
msgid "Default valid lifetime"
msgstr "ໄລຍະເວລາຄ່າເລີ່ມຕົ້ນທີ່ຖືກຕ້ອງ"

#: src/usr/local/www/services_router_advertisements.php:365
#, php-format
msgid ""
"The length of time in seconds (relative to the time the packet is sent) that "
"the prefix is valid for the purpose of on-link determination.%1$sThe default "
"is 86400 seconds."
msgstr "ໄລຍະເວລາໃນວິນາທີ (ໃນຄວາມສຳພັນກັບເວລາທີ່ສົ່ງແພັກເກັດ) ທີ່ຂຶ້ນຕົ້ນແມ່ນມີຜົນສໍາລັບຈຸດປະສົງຂອງການກຳນົດ on-link.%1$sຄ່າເລີ່ມຕົ້ນແມ່ນ 86400 ວິນາທີ."

#: src/usr/local/www/services_router_advertisements.php:370
msgid "Default preferred lifetime"
msgstr "ໄລຍະເວລາຄ່າເລີ່ມຕົ້ນທີ່ມັກ"

#: src/usr/local/www/services_router_advertisements.php:374
#, php-format
msgid ""
"Seconds. The length of time in seconds (relative to the time the packet is "
"sent) that addresses generated from the prefix via stateless address "
"autoconfiguration remain preferred.%1$sThe default is 14400 seconds."
msgstr "ວິນາທີ. ໄລຍະເວລາໃນວິນາທີ (ໃນຄວາມສຳພັນກັບເວລາທີ່ສົ່ງແພັກເກັດ) ທີ່ທີ່ຢູ່ທີ່ຖືກສ້າງຂຶ້ນຈາກຂຶ້ນຕົ້ນໂດຍການກຳນົດທີ່ຢູ່ແບບ stateless ຈະຖືກໃຫ້ຄວາມສໍາຄັນ.%1$sຄ່າເລີ່ມຕົ້ນແມ່ນ 14400 ວິນາທີ."

#: src/usr/local/www/services_router_advertisements.php:379
msgid "Minimum RA interval"
msgstr "ໄລຍະເວລາ RA ຕ່ຳສຸດ"

#: src/usr/local/www/services_router_advertisements.php:383
#, php-format
msgid ""
"The minimum time allowed between sending unsolicited multicast router "
"advertisements in seconds.%1$sThe default is 5 seconds."
msgstr "ເວລາຕ່ຳສຸດທີ່ອະນຸຍາດໃນການສົ່ງໂຄສະນາເສົາກວນ multicast ທີ່ບໍ່ໄດ້ຂໍໃນວິນາທີ.%1$sຄ່າເລີ່ມຕົ້ນແມ່ນ 5 ວິນາທີ."

#: src/usr/local/www/services_router_advertisements.php:388
msgid "Maximum RA interval"
msgstr "ໄລຍະເວລາ RA ສູງສຸດ"

#: src/usr/local/www/services_router_advertisements.php:392
#, php-format
msgid ""
"The maximum time allowed between sending unsolicited multicast router "
"advertisements in seconds.%1$sThe default is 20 seconds."
msgstr "ເວລາສູງສຸດທີ່ອະນຸຍາດໃນການສົ່ງໂຄສະນາເສົາກວນ multicast ທີ່ບໍ່ໄດ້ຂໍໃນວິນາທີ.%1$sຄ່າເລີ່ມຕົ້ນແມ່ນ 20 ວິນາທີ."

#: src/usr/local/www/services_router_advertisements.php:397
