msgstr ""
"ຄວາມຫຼາກຫຼາຍ"

#: src/usr/local/www/interfaces.php:3210 src/usr/local/www/interfaces.php:3219
msgid "#1"
msgstr ""
"#1"

#: src/usr/local/www/interfaces.php:3210 src/usr/local/www/interfaces.php:3219
