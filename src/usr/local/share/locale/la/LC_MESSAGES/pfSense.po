msgstr "ເສັ້ນໂຄ້ງ ECDH ທີ່ລະບຸບໍ່ຖືກຕ້ອງ."

#: src/usr/local/www/vpn_openvpn_server.php:519
msgid ""
"Using a tunnel network and server bridge settings together is not allowed."
msgstr ""
"ການໃຊ້ການຕັ້ງຄ່າເຄືອຂ່າຍອຸໂມງ ແລະ ຂົວເຊີບເວີຮ່ວມກັນບໍ່ໄດ້ຮັບອະນຸຍາດ."

#: src/usr/local/www/vpn_openvpn_server.php:523
msgid "Bridge Route Gateway requires a valid Bridge Interface."
msgstr "Bridge Route Gateway ຕ້ອງການ Bridge Interface ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/vpn_openvpn_server.php:527
msgid "Server Bridge DHCP Start and End must both be empty, or defined."
msgstr "Server Bridge DHCP Start ແລະ End ຕ້ອງຫວ່າງທັງຄູ່, ຫຼືຖືກກຳນົດ."

#: src/usr/local/www/vpn_openvpn_server.php:530
msgid "Server Bridge DHCP Start must be an IPv4 address."
msgstr "Server Bridge DHCP Start ຕ້ອງເປັນທີ່ຢູ່ IPv4."

#: src/usr/local/www/vpn_openvpn_server.php:533
msgid "Server Bridge DHCP End must be an IPv4 address."
msgstr "Server Bridge DHCP End ຕ້ອງເປັນທີ່ຢູ່ IPv4."

#: src/usr/local/www/vpn_openvpn_server.php:536
msgid "The Server Bridge DHCP range is invalid (start higher than end)."
msgstr "ຊ່ວງ Server Bridge DHCP ບໍ່ຖືກຕ້ອງ (ເລີ່ມຕົ້ນສູງກວ່າທ້າຍ)."

#: src/usr/local/www/vpn_openvpn_server.php:583
msgid "OCSP URL must be a valid URL address."
msgstr "OCSP URL ຕ້ອງເປັນທີ່ຢູ່ URL ທີ່ຖືກຕ້ອງ."

#: src/usr/local/www/vpn_openvpn_server.php:749
#, php-format
msgid "Updated OpenVPN server on %1$s:%2$s %3$s"
msgstr "ອັບເດດເຊີບເວີ OpenVPN ໃນ %1$s:%2$s %3$s ແລ້ວ"

#: src/usr/local/www/vpn_openvpn_server.php:752
#, php-format
msgid "Added OpenVPN server on %1$s:%2$s %3$s"
msgstr "ເພີ່ມເຊີບເວີ OpenVPN ໃນ %1$s:%2$s %3$s ແລ້ວ"

#: src/usr/local/www/vpn_openvpn_server.php:815
msgid ""
"Set this option to disable this server without removing it from the list."
msgstr ""
"ຕັ້ງຄ່າຕົວເລືອກນີ້ເພື່ອປິດໃຊ້ງານເຊີບເວີນີ້ໂດຍບໍ່ຕ້ອງເອົາມັນອອກຈາກລາຍຊື່."

#: src/usr/local/www/vpn_openvpn_server.php:845
msgid "*Backend for authentication"
msgstr "*Backend ສໍາລັບການກວດສອບຄວາມຖືກຕ້ອງ"

#: src/usr/local/www/vpn_openvpn_server.php:871
msgid ""
"The interface or Virtual IP address where OpenVPN will receive client "
"connections."
msgstr ""
"ອິນເຕີເຟດ ຫຼື ທີ່ຢູ່ IP ສະເໝືອນທີ່ OpenVPN ຈະໄດ້ຮັບການເຊື່ອມຕໍ່ລູກຄ້າ."

#: src/usr/local/www/vpn_openvpn_server.php:875
msgid "*Local port"
msgstr "*ພອດທ້ອງຖິ່ນ"

#: src/usr/local/www/vpn_openvpn_server.php:879
msgid "The port used by OpenVPN to receive client connections."
msgstr "ພອດທີ່ OpenVPN ໃຊ້ເພື່ອຮັບການເຊື່ອມຕໍ່ລູກຄ້າ."

#: src/usr/local/www/vpn_openvpn_server.php:969
msgid "OCSP Check"
msgstr "ການກວດສອບ OCSP"

#: src/usr/local/www/vpn_openvpn_server.php:976
msgid "OCSP URL"
msgstr "OCSP URL"

#: src/usr/local/www/vpn_openvpn_server.php:987
#: src/usr/local/www/vpn_openvpn_server.php:2179
msgid ""
"Warning: The selected server certificate was not created as an SSL/TLS "
"Server certificate and may not work as expected"
msgstr ""
"ຄຳເຕືອນ: ໃບຢັ້ງຢືນເຊີບເວີທີ່ເລືອກບໍ່ໄດ້ຖືກສ້າງເປັນໃບຢັ້ງຢືນ SSL/TLS Server ແລະອາດຈະບໍ່ເຮັດວຽກຕາມທີ່ຄາດໄວ້"

#: src/usr/local/www/vpn_openvpn_server.php:991
#, php-format
msgid "No Certificates defined. One may be created here: %1$s%2$s%3$s"
msgstr "ບໍ່ມີໃບຢັ້ງຢືນຖືກກຳນົດ. ອັນໜຶ່ງອາດຈະຖືກສ້າງຂຶ້ນທີ່ນີ້: %1$s%2$s%3$s"

#: src/usr/local/www/vpn_openvpn_server.php:991
msgid "System &gt; Cert. Manager"
msgstr "ລະບົບ &gt; ຕົວຈັດການໃບຢັ້ງຢືນ"

#: src/usr/local/www/vpn_openvpn_server.php:1001
msgid "*Server certificate"
msgstr "*ໃບຢັ້ງຢືນເຊີບເວີ"

#: src/usr/local/www/vpn_openvpn_server.php:1008
msgid "*DH Parameter Length"
msgstr "*ຄວາມຍາວພາລາມິເຕີ DH"

#: src/usr/local/www/vpn_openvpn_server.php:1013
msgid "Only DH parameter sets which exist in /etc/ are shown."
msgstr "ມີພຽງຊຸດພາລາມິເຕີ DH ທີ່ຢູ່ໃນ /etc/ ເທົ່ານັ້ນທີ່ສະແດງ."

#: src/usr/local/www/vpn_openvpn_server.php:1015
msgid ""
"Generating new or stronger DH parameters is CPU-intensive and must be "
"performed manually."
msgstr ""
"ການສ້າງພາລາມິເຕີ DH ໃໝ່ ຫຼື ແຂງແຮງກວ່າແມ່ນໃຊ້ CPU ຫຼາຍ ແລະ ຕ້ອງເຮັດດ້ວຍຕົນເອງ."

#: src/usr/local/www/vpn_openvpn_server.php:1016
#, php-format
msgid ""
"Consult %1$sthe doc wiki article on DH Parameters%2$sfor information on "
"generating new or stronger parameter sets."
msgstr ""
"ປຶກສາ %1$sບົດຄວາມ wiki doc ກ່ຽວກັບພາລາມິເຕີ DH%2$sສຳລັບຂໍ້ມູນກ່ຽວກັບການສ້າງຊຸດພາລາມິເຕີໃໝ່ ຫຼື ແຂງແຮງກວ່າ."

#: src/usr/local/www/vpn_openvpn_server.php:1011
#, php-format
msgid "Diffie-Hellman (DH) parameter set used for key exchange.%1$s%2$s%3$s"
msgstr "ຊຸດພາລາມິເຕີ Diffie-Hellman (DH) ທີ່ໃຊ້ສຳລັບການແລກປ່ຽນຄີ.%1$s%2$s%3$s"

#: src/usr/local/www/vpn_openvpn_server.php:1024
msgid "ECDH Curve"
msgstr "ເສັ້ນໂຄ້ງ ECDH"

#: src/usr/local/www/vpn_openvpn_server.php:1027
#, php-format
msgid ""
"The Elliptic Curve to use for key exchange. %1$sThe curve from the server "
"certificate is used by default when the server uses an ECDSA certificate. "
"Otherwise, secp384r1 is used as a fallback."
msgstr ""
"ເສັ້ນໂຄ້ງ Elliptic ທີ່ຈະໃຊ້ສໍາລັບການແລກປ່ຽນຄີ. %1$sເສັ້ນໂຄ້ງຈາກໃບຢັ້ງຢືນເຊີບເວີແມ່ນຖືກໃຊ້ໂດຍຄ່າເລີ່ມຕົ້ນເມື່ອເຊີບເວີໃຊ້ໃບຢັ້ງຢືນ ECDSA. ຖ້າບໍ່ດັ່ງນັ້ນ, secp384r1 ຈະຖືກໃຊ້ເປັນ fallback."

#: src/usr/local/www/vpn_openvpn_server.php:1100
#, php-format
msgid ""
"The algorithm used to authenticate data channel packets, and control channel "
"packets if a TLS Key is present.%1$sWhen an AEAD Encryption Algorithm mode "
"is used, such as AES-GCM, this digest is used for the control channel only, "
"not the data channel.%1$sThe server and all clients must have the same "
"setting. While SHA1 is the default for OpenVPN, this algorithm is insecure. "
msgstr ""
"ສູດການຄິດໄລ່ທີ່ໃຊ້ເພື່ອຢືນຢັນຄວາມຖືກຕ້ອງຂອງແພັກເກັດຊ່ອງຂໍ້ມູນ, ແລະແພັກເກັດຊ່ອງຄວບຄຸມຖ້າຄີ TLS ຢູ່. %1$sເມື່ອໃຊ້ໂໝດ AEAD Encryption Algorithm, ເຊັ່ນ AES-GCM, digest ນີ້ຖືກໃຊ້ສຳລັບຊ່ອງຄວບຄຸມເທົ່ານັ້ນ, ບໍ່ແມ່ນຊ່ອງຂໍ້ມູນ. %1$sເຊີບເວີ ແລະ ລູກຄ້າທັງໝົດຕ້ອງມີການຕັ້ງຄ່າດຽວກັນ. ໃນຂະນະທີ່ SHA1 ເປັນຄ່າເລີ່ມຕົ້ນສຳລັບ OpenVPN, ສູດການຄິດໄລ່ນີ້ບໍ່ປອດໄພ."

#: src/usr/local/www/vpn_openvpn_server.php:1116
msgid "Do Not Check"
msgstr "ຢ່າກວດສອບ"

#: src/usr/local/www/vpn_openvpn_server.php:1114
msgid "*Certificate Depth"
msgstr "*ຄວາມເລິກຂອງໃບຢັ້ງຢືນ"

#: src/usr/local/www/vpn_openvpn_server.php:1117
msgid ""
"When a certificate-based client logs in, do not accept certificates below "
"this depth. Useful for denying certificates made with intermediate CAs "
"generated from the same CA as the server."
msgstr ""
"ເມື່ອລູກຄ້າທີ່ອີງໃສ່ໃບຢັ້ງຢືນເຂົ້າສູ່ລະບົບ, ຢ່າຍອມຮັບໃບຢັ້ງຢືນຂ້າງລຸ່ມຄວາມເລິກນີ້. ເປັນປະໂຫຍດສໍາລັບການປະຕິເສດໃບຢັ້ງຢືນທີ່ສ້າງຂຶ້ນດ້ວຍ CAs ຂັ້ນກາງທີ່ສ້າງຂຶ້ນຈາກ CA ດຽວກັນກັບເຊີບເວີ."

#: src/usr/local/www/vpn_openvpn_server.php:1122
msgid "Strict User-CN Matching"
msgstr "ການຈັບຄູ່ຜູ້ໃຊ້-CN ຢ່າງເຂັ້ມງວດ"

#: src/usr/local/www/vpn_openvpn_server.php:1125
msgid ""
"When authenticating users, enforce a match between the common name of the "
"client certificate and the username given at login."
msgstr ""
"ເມື່ອຢືນຢັນຄວາມຖືກຕ້ອງຂອງຜູ້ໃຊ້, ບັງຄັບໃຫ້ກົງກັນລະຫວ່າງຊື່ທົ່ວໄປຂອງໃບຢັ້ງຢືນລູກຄ້າແລະຊື່ຜູ້ໃຊ້ທີ່ໃຫ້ໃນເວລາເຂົ້າສູ່ລະບົບ."

#: src/usr/local/www/vpn_openvpn_server.php:1136
msgid ""
"This is the IPv4 virtual network used for private communications between "
"this server and client hosts expressed using CIDR notation (e.g. 10.0.8.0/"
"24). The first usable address in the network will be assigned to the server "
"virtual interface. The remaining usable addresses will be assigned to "
"connecting clients."
msgstr ""
"ນີ້ແມ່ນເຄືອຂ່າຍສະເໝືອນ IPv4 ທີ່ໃຊ້ສຳລັບການສື່ສານສ່ວນຕົວລະຫວ່າງເຊີບເວີນີ້ ແລະ ໂຮສລູກຄ້າທີ່ສະແດງໂດຍໃຊ້ CIDR notation (ເຊັ່ນ: 10.0.8.0/24). ທີ່ຢູ່ທີ່ໃຊ້ງານໄດ້ທຳອິດໃນເຄືອຂ່າຍຈະຖືກມອບໝາຍໃຫ້ກັບອິນເຕີເຟດສະເໝືອນຂອງເຊີບເວີ. ທີ່ຢູ່ທີ່ໃຊ້ງານໄດ້ທີ່ເຫຼືອຈະຖືກມອບໝາຍໃຫ້ກັບລູກຄ້າທີ່ເຊື່ອມຕໍ່."

#: src/usr/local/www/vpn_openvpn_server.php:1146
msgid ""
"This is the IPv6 virtual network used for private communications between "
"this server and client hosts expressed using CIDR notation (e.g. fe80::/64). "
"The ::1 address in the network will be assigned to the server virtual "
"interface. The remaining addresses will be assigned to connecting clients."
msgstr ""
"ນີ້ແມ່ນເຄືອຂ່າຍສະເໝືອນ IPv6 ທີ່ໃຊ້ສຳລັບການສື່ສານສ່ວນຕົວລະຫວ່າງເຊີບເວີນີ້ແລະໂຮດລູກຄ້າທີ່ສະແດງໂດຍໃຊ້ CIDR notation (ເຊັ່ນ: fe80::/64). ທີ່ຢູ່ ::1 ໃນເຄືອຂ່າຍຈະຖືກມອບໝາຍໃຫ້ກັບອິນເຕີເຟດສະເໝືອນຂອງເຊີບເວີ. ທີ່ຢູ່ທີ່ເຫຼືອຈະຖືກມອບໝາຍໃຫ້ກັບລູກຄ້າທີ່ເຊື່ອມຕໍ່."

#: src/usr/local/www/vpn_openvpn_server.php:1153
msgid "Bridge DHCP"
msgstr "Bridge DHCP"

#: src/usr/local/www/vpn_openvpn_server.php:1160
msgid "Bridge Interface"
msgstr "ອິນເຕີເຟດຂົວ"

#: src/usr/local/www/vpn_openvpn_server.php:1163
msgid ""
"The interface to which this TAP instance will be bridged. This is not done "
"automatically. This interface must be assigned and the bridge created "
"separately. This setting controls which existing IP address and subnet mask "
"are used by OpenVPN for the bridge. Setting this to \"none\" will cause the "
"Server Bridge DHCP settings below to be ignored."
msgstr ""
"ອິນເຕີເຟດທີ່ instance TAP ນີ້ຈະຖືກ bridged. ນີ້ບໍ່ໄດ້ເຮັດໂດຍອັດຕະໂນມັດ. ອິນເຕີເຟດນີ້ຕ້ອງຖືກມອບໝາຍແລະຂົວຖືກສ້າງຂຶ້ນແຍກຕ່າງຫາກ. ການຕັ້ງຄ່ານີ້ຄວບຄຸມວ່າທີ່ຢູ່ IP ແລະ subnet mask ທີ່ມີຢູ່ອັນໃດທີ່ OpenVPN ໃຊ້ສໍາລັບຂົວ. ການຕັ້ງຄ່ານີ້ເປັນ \"none\" ຈະເຮັດໃຫ້ການຕັ້ງຄ່າ Server Bridge DHCP ຂ້າງລຸ່ມນີ້ຖືກບໍ່ສົນໃຈ."

#: src/usr/local/www/vpn_openvpn_server.php:1169
msgid "Bridge Route Gateway"
msgstr "Bridge Route Gateway"

#: src/usr/local/www/vpn_openvpn_server.php:1172
msgid ""
"When omitting the <b>IPv4 Tunnel Network</b> for a bridge, connecting "
"clients cannot automatically determine a server-side gateway for <b>IPv4 "
"Local Network(s)</b> or <b>Redirect IPv4 Gateway</b> traffic. When enabled, "
"this option sends the IPv4 address of the selected <b>Bridge Interface</b> "
"to clients which they can then use as a gateway for routing traffic outside "
"of the bridged subnet. OpenVPN does not currently support this mechanism for "
"IPv6."
msgstr ""
"ເມື່ອຂ້າມ <b>IPv4 Tunnel Network</b> ສໍາລັບຂົວ, ລູກຄ້າທີ່ເຊື່ອມຕໍ່ບໍ່ສາມາດກໍານົດ gateway ຝັ່ງເຊີບເວີສໍາລັບການຈະລາຈອນ <b>IPv4 Local Network(s)</b> ຫຼື <b>Redirect IPv4 Gateway</b> ໄດ້ໂດຍອັດຕະໂນມັດ. ເມື່ອເປີດໃຊ້ງານ, ຕົວເລືອກນີ້ຈະສົ່ງທີ່ຢູ່ IPv4 ຂອງ <b>Bridge Interface</b> ທີ່ເລືອກໃຫ້ກັບລູກຄ້າທີ່ພວກເຂົາສາມາດໃຊ້ເປັນ gateway ສໍາລັບການສົ່ງເສັ້ນທາງການຈະລາຈອນອອກຈາກ subnet ທີ່ bridged. OpenVPN ບໍ່ຮອງຮັບກົນໄກນີ້ສໍາລັບ IPv6 ໃນປັດຈຸບັນ."

#: src/usr/local/www/vpn_openvpn_server.php:1178
msgid "Server Bridge DHCP Start"
msgstr "Server Bridge DHCP Start"

#: src/usr/local/www/vpn_openvpn_server.php:1181
msgid ""
"When using TAP mode as a multi-point server, a DHCP range may optionally be "
"supplied to use on the interface to which this TAP instance is bridged. If "
"these settings are left blank, DHCP will be passed through to the LAN, and "
"the interface setting above will be ignored."
msgstr ""
"ເມື່ອໃຊ້ໂໝດ TAP ເປັນເຊີບເວີແບບຫຼາຍຈຸດ, ຊ່ວງ DHCP ອາດຈະຖືກສະໜອງໃຫ້ໃຊ້ໃນອິນເຕີເຟດທີ່ instance TAP ນີ້ຖືກ bridged. ຖ້າການຕັ້ງຄ່າເຫຼົ່ານີ້ຖືກປ່ອຍຫວ່າງໄວ້, DHCP ຈະຖືກສົ່ງຜ່ານໄປຫາ LAN, ແລະການຕັ້ງຄ່າອິນເຕີເຟດຂ້າງເທິງຈະຖືກບໍ່ສົນໃຈ."

#: src/usr/local/www/vpn_openvpn_server.php:1187
msgid "Server Bridge DHCP End"
msgstr "Server Bridge DHCP End"

#: src/usr/local/www/vpn_openvpn_server.php:1194
msgid "Redirect IPv4 Gateway"
msgstr "ປ່ຽນເສັ້ນທາງ IPv4 Gateway"

#: src/usr/local/www/vpn_openvpn_server.php:1200
msgid "Redirect IPv6 Gateway"
msgstr "ປ່ຽນເສັ້ນທາງ IPv6 Gateway"

#: src/usr/local/www/vpn_openvpn_server.php:1207
msgid "IPv4 Local network(s)"
msgstr "ເຄືອຂ່າຍທ້ອງຖິ່ນ IPv4"

#: src/usr/local/www/vpn_openvpn_server.php:1210
msgid ""
"IPv4 networks that will be accessible from the remote endpoint. Expressed as "
"a comma-separated list of one or more CIDR ranges. This may be left blank if "
"not adding a route to the local network through this tunnel on the remote "
"machine. This is generally set to the LAN network."
msgstr ""
"ເຄືອຂ່າຍ IPv4 ທີ່ຈະສາມາດເຂົ້າເຖິງໄດ້ຈາກ endpoint ຣີໂໝດ. ສະແດງເປັນລາຍຊື່ທີ່ຂັ້ນດ້ວຍເຄື່ອງໝາຍຈຸດຂອງໜຶ່ງ ຫຼືຫຼາຍກວ່າ CIDR ranges. ນີ້ອາດຈະຖືກປ່ອຍຫວ່າງໄວ້ຖ້າບໍ່ໄດ້ເພີ່ມເສັ້ນທາງໄປຫາເຄືອຂ່າຍທ້ອງຖິ່ນຜ່ານອຸໂມງນີ້ໃນເຄື່ອງຣີໂໝດ. ນີ້ແມ່ນຖືກຕັ້ງເປັນເຄືອຂ່າຍ LAN ໂດຍທົ່ວໄປ."

#: src/usr/local/www/vpn_openvpn_server.php:1217
msgid "IPv6 Local network(s)"
msgstr "ເຄືອຂ່າຍທ້ອງຖິ່ນ IPv6"

#: src/usr/local/www/vpn_openvpn_server.php:1220
msgid ""
"IPv6 networks that will be accessible from the remote endpoint. Expressed as "
"a comma-separated list of one or more IP/PREFIX. This may be left blank if "
"not adding a route to the local network through this tunnel on the remote "
"machine. This is generally set to the LAN network."
msgstr ""
"ເຄືອຂ່າຍ IPv6 ທີ່ຈະສາມາດເຂົ້າເຖິງໄດ້ຈາກ endpoint ຣີໂໝດ. ສະແດງເປັນລາຍຊື່ທີ່ຂັ້ນດ້ວຍເຄື່ອງໝາຍຈຸດຂອງໜຶ່ງ ຫຼືຫຼາຍກວ່າ IP/PREFIX. ນີ້ອາດຈະຖືກປ່ອຍຫວ່າງໄວ້ຖ້າບໍ່ໄດ້ເພີ່ມເສັ້ນທາງໄປຫາເຄືອຂ່າຍທ້ອງຖິ່ນຜ່ານອຸໂມງນີ້ໃນເຄື່ອງຣີໂໝດ. ນີ້ແມ່ນຖືກຕັ້ງເປັນເຄືອຂ່າຍ LAN ໂດຍທົ່ວໄປ."

#: src/usr/local/www/vpn_openvpn_server.php:1244
msgid "Concurrent connections"
msgstr "ການເຊື່ອມຕໍ່ພ້ອມກັນ"

#: src/usr/local/www/vpn_openvpn_server.php:1247
msgid ""
"Specify the maximum number of clients allowed to concurrently connect to "
"this server."
msgstr ""
"ລະບຸຈຳນວນລູກຄ້າສູງສຸດທີ່ອະນຸຍາດໃຫ້ເຊື່ອມຕໍ່ພ້ອມກັນກັບເຊີບເວີນີ້."

#: src/usr/local/www/vpn_openvpn_server.php:1275
msgid "Push Compression"
msgstr "ການບີບອັດ Push"

#: src/usr/local/www/vpn_openvpn_server.php:1289
msgid "Inter-client communication"
msgstr "ການສື່ສານລະຫວ່າງລູກຄ້າ"

#: src/usr/local/www/vpn_openvpn_server.php:1296
msgid "Duplicate Connection"
msgstr "ການເຊື່ອມຕໍ່ຊໍ້າກັນ"

#: src/usr/local/www/vpn_openvpn_server.php:1299
#, php-format
msgid ""
"When set, the same user may connect multiple times. When unset, a new "
"connection from a user will disconnect the previous session. %1$s%1$sUsers "
"are identified by their username or certificate properties, depending on the "
"VPN configuration. This practice is discouraged security reasons, but may be "
"necessary in some environments."
msgstr ""
"ເມື່ອຕັ້ງຄ່າ, ຜູ້ໃຊ້ຄົນດຽວກັນອາດຈະເຊື່ອມຕໍ່ໄດ້ຫຼາຍຄັ້ງ. ເມື່ອບໍ່ຕັ້ງຄ່າ, ການເຊື່ອມຕໍ່ໃໝ່ຈາກຜູ້ໃຊ້ຈະຕັດການເຊື່ອມຕໍ່ກ່ອນໜ້າ. %1$s%1$sຜູ້ໃຊ້ຖືກກໍານົດໂດຍຊື່ຜູ້ໃຊ້ ຫຼື ຄຸນສົມບັດໃບຢັ້ງຢືນຂອງພວກເຂົາ, ຂຶ້ນກັບການຕັ້ງຄ່າ VPN. ການປະຕິບັດນີ້ບໍ່ໄດ້ຖືກແນະນໍາສໍາລັບເຫດຜົນດ້ານຄວາມປອດໄພ, ແຕ່ອາດຈະມີຄວາມຈໍາເປັນໃນບາງສະພາບແວດລ້ອມ."

#: src/usr/local/www/vpn_openvpn_server.php:1311
msgid "Dynamic IP"
msgstr "IP ແບບໄດນາມິກ"

#: src/usr/local/www/vpn_openvpn_server.php:1321
#, php-format
msgid ""
"Specifies the method used to supply a virtual adapter IP address to clients "
"when using TUN mode on IPv4.%1$sSome clients may require this be set to "
"\"subnet\" even for IPv6, such as OpenVPN Connect (iOS/Android). Older "
"versions of OpenVPN (before 2.0.9) or clients such as Yealink phones may "
"require \"net30\"."
msgstr ""
"ລະບຸວິທີທີ່ໃຊ້ເພື່ອສະໜອງທີ່ຢູ່ IP ຕົວປັບສະເໝືອນໃຫ້ກັບລູກຄ້າເມື່ອໃຊ້ໂໝດ TUN ໃນ IPv4.%1$sລູກຄ້າບາງຄົນອາດຈະຕ້ອງການໃຫ້ຕັ້ງຄ່ານີ້ເປັນ \"subnet\" ເຖິງແມ່ນວ່າສໍາລັບ IPv6, ເຊັ່ນ: OpenVPN Connect (iOS/Android). OpenVPN ເວີຊັນເກົ່າ (ກ່ອນ 2.0.9) ຫຼືລູກຄ້າເຊັ່ນໂທລະສັບ Yealink ອາດຈະຕ້ອງການ \"net30\"."

#: src/usr/local/www/vpn_openvpn_server.php:1346
#, php-format
msgid ""
"keepalive helper uses interval and timeout parameters to define ping and "
"ping-restart values as follows:%1$sping = interval%1$sping-restart = "
"timeout*2%1$spush ping = interval%1$spush ping-restart = timeout%1$s"
msgstr ""
"keepalive helper ໃຊ້ພາລາມິເຕີ interval ແລະ timeout ເພື່ອກໍານົດຄ່າ ping ແລະ ping-restart ດັ່ງນີ້:%1$sping = interval%1$sping-restart = timeout*2%1$spush ping = interval%1$spush ping-restart = timeout%1$s"

#: src/usr/local/www/vpn_openvpn_server.php:1384
msgid "Push ping to client"
msgstr "Push ping ໄປຫາລູກຄ້າ"

#: src/usr/local/www/vpn_openvpn_server.php:1408
msgid "Push to client"
msgstr "Push ໄປຫາລູກຄ້າ"

#: src/usr/local/www/vpn_openvpn_server.php:1415
msgid "Advanced Client Settings"
msgstr "ການຕັ້ງຄ່າລູກຄ້າຂັ້ນສູງ"

#: src/usr/local/www/vpn_openvpn_server.php:1434
msgid "DNS Server enable"
msgstr "ເປີດໃຊ້ເຊີບເວີ DNS"

#: src/usr/local/www/vpn_openvpn_server.php:1441
msgid "DNS Server 1"
msgstr "ເຊີບເວີ DNS 1"

#: src/usr/local/www/vpn_openvpn_server.php:1448
msgid "DNS Server 2"
msgstr "ເຊີບເວີ DNS 2"

#: src/usr/local/www/vpn_openvpn_server.php:1455
msgid "DNS Server 3"
msgstr "ເຊີບເວີ DNS 3"

#: src/usr/local/www/vpn_openvpn_server.php:1462
msgid "DNS Server 4"
msgstr "ເຊີບເວີ DNS 4"

#: src/usr/local/www/vpn_openvpn_server.php:1469
msgid "Block Outside DNS"
msgstr "ບລັອກ DNS ພາຍນອກ"

#: src/usr/local/www/vpn_openvpn_server.php:1472
msgid ""
"Requires Windows 10 and OpenVPN 2.3.9 or later. Only Windows 10 is prone to "
"DNS leakage in this way, other clients will ignore the option as they are "
"not affected."
msgstr ""
"ຕ້ອງການ Windows 10 ແລະ OpenVPN 2.3.9 ຫຼືຫຼັງຈາກນັ້ນ. ມີພຽງແຕ່ Windows 10 ເທົ່ານັ້ນທີ່ມີແນວໂນ້ມທີ່ຈະຮົ່ວໄຫຼ DNS ໃນລັກສະນະນີ້, ລູກຄ້າອື່ນໆຈະບໍ່ສົນໃຈຕົວເລືອກເພາະວ່າພວກເຂົາບໍ່ໄດ້ຮັບຜົນກະທົບ."

#: src/usr/local/www/vpn_openvpn_server.php:1476
msgid "Force DNS cache update"
msgstr "ບັງຄັບການອັບເດດ cache DNS"

#: src/usr/local/www/vpn_openvpn_server.php:1479
msgid "This is known to kick Windows into recognizing pushed DNS servers."
msgstr "ນີ້ແມ່ນເປັນທີ່ຮູ້ຈັກທີ່ຈະ kick Windows ເຂົ້າໄປໃນການຮັບຮູ້ເຊີບເວີ DNS ທີ່ pushed."

#: src/usr/local/www/vpn_openvpn_server.php:1483
msgid "NTP Server enable"
msgstr "ເປີດໃຊ້ເຊີບເວີ NTP"

#: src/usr/local/www/vpn_openvpn_server.php:1504
msgid "NetBIOS enable"
msgstr "ເປີດໃຊ້ NetBIOS"

#: src/usr/local/www/vpn_openvpn_server.php:1507
msgid ""
"If this option is not set, all NetBIOS-over-TCP/IP options (including WINS) "
"will be disabled."
msgstr ""
"ຖ້າຕົວເລືອກນີ້ບໍ່ໄດ້ຕັ້ງຄ່າ, ຕົວເລືອກ NetBIOS-over-TCP/IP ທັງໝົດ (ລວມທັງ WINS) ຈະຖືກປິດໃຊ້ງານ."

#: src/usr/local/www/vpn_openvpn_server.php:1514
msgid ""
"Possible options: b-node (broadcasts), p-node (point-to-point name queries "
"to a WINS server), m-node (broadcast then query name server), and h-node "
"(query name server, then broadcast)"
msgstr ""
"ຕົວເລືອກທີ່ເປັນໄປໄດ້: b-node (ກະຈາຍສຽງ), p-node (ສອບຖາມຊື່ແບບຈຸດຕໍ່ຈຸດໄປຫາເຊີບເວີ WINS), m-node (ກະຈາຍສຽງຈາກນັ້ນສອບຖາມເຊີບເວີຊື່), ແລະ h-node (ສອບຖາມເຊີບເວີຊື່, ຈາກນັ້ນກະຈາຍສຽງ)"

#: src/usr/local/www/vpn_openvpn_server.php:1519
msgid "Scope ID"
msgstr "ID ຂອບເຂດ"

#: src/usr/local/www/vpn_openvpn_server.php:1522
msgid ""
"A NetBIOS Scope ID provides an extended naming service for NetBIOS over TCP/"
"IP. The NetBIOS scope ID isolates NetBIOS traffic on a single network to "
"only those nodes with the same NetBIOS scope ID"
msgstr ""
"NetBIOS Scope ID ໃຫ້ບໍລິການຕັ້ງຊື່ແບບຂະຫຍາຍສຳລັບ NetBIOS ຜ່ານ TCP/IP. NetBIOS scope ID ແຍກການຈະລາຈອນ NetBIOS ໃນເຄືອຂ່າຍດຽວໃຫ້ກັບໂນດທີ່ມີ NetBIOS scope ID ດຽວກັນເທົ່ານັ້ນ"

#: src/usr/local/www/vpn_openvpn_server.php:1528
msgid "WINS server enable"
msgstr "ເປີດໃຊ້ງານເຊີບເວີ WINS"

#: src/usr/local/www/vpn_openvpn_server.php:1535
msgid "WINS Server 1"
msgstr "ເຊີບເວີ WINS 1"

#: src/usr/local/www/vpn_openvpn_server.php:1542
msgid "WINS Server 2"
msgstr "ເຊີບເວີ WINS 2"

#: src/usr/local/www/vpn_openvpn_server.php:1559
#, php-format
msgid ""
"Enter any additional options to add to the OpenVPN server configuration "
"here, separated by semicolon.%1$sEXAMPLE: push \"route 10.0.0.0 255.255.255."
"0\""
msgstr ""
"ໃສ່ຕົວເລືອກເພີ່ມເຕີມໃດໆທີ່ຈະເພີ່ມເຂົ້າໃນການຕັ້ງຄ່າເຊີບເວີ OpenVPN ທີ່ນີ້, ແຍກດ້ວຍເຄື່ອງໝາຍຈຸດ.%1$sຕົວຢ່າງ: push \"route 10.0.0.0 255.255.255.0\""

#: src/usr/local/www/vpn_openvpn_server.php:1564
msgid "Username as Common Name"
msgstr "ຊື່ຜູ້ໃຊ້ເປັນ Common Name"

#: src/usr/local/www/vpn_openvpn_server.php:1567
msgid ""
"When a user authenticates, if this option is enabled then the username of "
"the client will be used in place of the certificate common name for purposes "
"such as determining Client Specific Overrides."
msgstr ""
"ເມື່ອຜູ້ໃຊ້ກວດສອບຄວາມຖືກຕ້ອງ, ຖ້າຕົວເລືອກນີ້ຖືກເປີດໃຊ້ງານ, ຊື່ຜູ້ໃຊ້ຂອງລູກຄ້າຈະຖືກໃຊ້ແທນທີ່ຊື່ທົ່ວໄປຂອງໃບຢັ້ງຢືນເພື່ອຈຸດປະສົງເຊັ່ນ: ການກໍານົດ Client Specific Overrides."

#: src/usr/local/www/vpn_openvpn_server.php:1583
msgid ""
"Send an explicit exit notification to connected clients/peers when "
"restarting or shutting down, so they may immediately disconnect rather than "
"waiting for a timeout. In SSL/TLS Server modes, clients may be directed to "
"reconnect or use the next server. In Peer-to-Peer Shared Key or with a /30 "
"Tunnel Network, this value controls how many times this instance will "
"attempt to send the exit notification."
msgstr ""
"ສົ່ງການແຈ້ງເຕືອນການອອກຢ່າງຊັດເຈນໃຫ້ກັບລູກຄ້າ/ເພື່ອນທີ່ເຊື່ອມຕໍ່ເມື່ອເລີ່ມຕົ້ນໃໝ່ ຫຼື ປິດເຄື່ອງ, ເພື່ອໃຫ້ພວກເຂົາສາມາດຕັດການເຊື່ອມຕໍ່ໄດ້ທັນທີແທນທີ່ຈະລໍຖ້າ timeout. ໃນໂໝດ SSL/TLS Server, ລູກຄ້າອາດຈະຖືກສັ່ງໃຫ້ເຊື່ອມຕໍ່ຄືນໃໝ່ ຫຼື ໃຊ້ເຊີບເວີຖັດໄປ. ໃນ Peer-to-Peer Shared Key ຫຼືກັບ /30 Tunnel Network, ຄ່ານີ້ຄວບຄຸມຈຳນວນຄັ້ງທີ່ instance ນີ້ຈະພະຍາຍາມສົ່ງການແຈ້ງເຕືອນການອອກ."

#: src/usr/local/www/vpn_openvpn_server.php:1624
msgid ""
"If you assign a virtual interface to this OpenVPN server, this setting "
