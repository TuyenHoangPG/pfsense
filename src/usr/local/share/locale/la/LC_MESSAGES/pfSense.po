msgid "State type"
msgstr "ປະເພດສະຖານະ"

#: src/usr/local/www/firewall_rules_edit.php:1676
#, php-format
msgid ""
"Select which type of state tracking mechanism to use. If in doubt, use keep "
"state.%1$s"
msgstr "ເລືອກປະເພດຂອງກົນໄກການຕິດຕາມສະຖານະທີ່ຈະໃຊ້. ຖ້າສົງໄສ, ໃຫ້ໃຊ້ສະຖານະຮັກສາໄວ້.%1$s"

#: src/usr/local/www/firewall_rules_edit.php:1684
msgid "This does NOT prevent the rule from being overwritten on Slave."
msgstr "ນີ້ບໍ່ໄດ້ປ້ອງກັນບໍ່ໃຫ້ກົດລະບຽບຖືກຂຽນທັບໃນ Slave."

#: src/usr/local/www/firewall_rules_edit.php:1688
#: src/usr/local/www/interfaces.php:2237 src/usr/local/www/interfaces.php:2466
msgid "VLAN Prio"
msgstr "VLAN Prio"

#: src/usr/local/www/firewall_rules_edit.php:1691
msgid "Choose 802.1p priority to match on."
msgstr "ເລືອກບູລິມະສິດ 802.1p ເພື່ອໃຫ້ກົງກັນ."

#: src/usr/local/www/firewall_rules_edit.php:1695
msgid "VLAN Prio Set"
msgstr "VLAN Prio Set"

#: src/usr/local/www/firewall_rules_edit.php:1698
msgid "Choose 802.1p priority to apply."
msgstr "ເລືອກບູລິມະສິດ 802.1p ເພື່ອໃຊ້."

#: src/usr/local/www/firewall_rules_edit.php:1712
msgid "Leave as 'none' to leave the rule enabled all the time."
msgstr "ປ່ອຍເປັນ 'none' ເພື່ອໃຫ້ກົດລະບຽບເປີດໃຊ້ງານຕະຫຼອດເວລາ."

#: src/usr/local/www/firewall_rules_edit.php:1741
#, php-format
msgid ""
"Leave as 'default' to use the system routing table. Or choose a gateway to "
"utilize policy based routing. %sGateway selection is not valid for "
"\"IPV4+IPV6\" address family."
msgstr "ປ່ອຍເປັນ 'default' ເພື່ອໃຊ້ຕາຕະລາງເສັ້ນທາງຂອງລະບົບ. ຫຼືເລືອກເກດເວເພື່ອໃຊ້ການເສັ້ນທາງຕາມນະໂຍບາຍ. %sການເລືອກເກດເວບໍ່ຖືກຕ້ອງສຳລັບຄອບຄົວທີ່ຢູ່ \"IPV4+IPV6\"."

#: src/usr/local/www/firewall_rules_edit.php:1744
