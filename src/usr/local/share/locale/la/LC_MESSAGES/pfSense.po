msgstr "ໝົດເວລາ"

#: src/usr/local/www/vpn_openvpn_client.php:1058
#: src/usr/local/www/vpn_openvpn_server.php:1378
#, php-format
msgid ""
"Ping remote over the TCP/UDP control channel if no packets have been sent "
"for at least n seconds.%1$s"
msgstr ""
"Ping ຫ່າງໄກຜ່ານຊ່ອງຄວບຄຸມ TCP/UDP ຖ້າບໍ່ມີແພັກເກັດຖືກສົ່ງເປັນເວລາຢ່າງໜ້ອຍ n ວິນາທີ.%1$s"

#: src/usr/local/www/vpn_openvpn_client.php:1064
