#: src/etc/inc/util.inc:122
msgid "WARNING: A name must be given as parameter to lock() function."
msgstr "ເຕືອນ: ຕ້ອງມີຊື່ເປັນພາລາເມັດຕໍ່ lock() function."

#: src/etc/inc/util.inc:140
