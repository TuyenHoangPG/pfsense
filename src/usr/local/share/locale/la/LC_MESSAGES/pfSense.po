msgstr "*ຕົວລະບຸຂອງຂ້ອຍ"

#: src/usr/local/www/vpn_ipsec_phase1.php:866
msgid "*Peer identifier"
msgstr "*ຕົວລະບຸເພື່ອນ"

#: src/usr/local/www/vpn_ipsec_phase1.php:884
msgid ""
"This is known as the \"group\" setting on some VPN client implementations"
msgstr "ນີ້ແມ່ນເປັນທີ່ຮູ້ຈັກກັນໃນນາມການຕັ້ງຄ່າ \"ກຸ່ມ\" ໃນການຈັດຕັ້ງປະຕິບັດລູກຄ້າ VPN ບາງອັນ"

#: src/usr/local/www/vpn_ipsec_phase1.php:894
#, php-format
msgid ""
"Enter the Pre-Shared Key string. This key must match on both peers. %1$sThis "
"key should be long and random to protect the tunnel and its contents. A weak "
"Pre-Shared Key can lead to a tunnel compromise.%1$s"
msgstr "ໃສ່ສະຕຣິງ Pre-Shared Key. ຄີນີ້ຕ້ອງກົງກັນໃນທັງສອງເພື່ອນ. %1$sຄີນີ້ຄວນຍາວ ແລະສຸ່ມເພື່ອປົກປ້ອງອຸໂມງ ແລະເນື້ອໃນຂອງມັນ. Pre-Shared Key ທີ່ອ່ອນແອສາມາດນໍາໄປສູ່ການປະນີປະນອມອຸໂມງໄດ້.%1$s"

#: src/usr/local/www/vpn_ipsec_phase1.php:898
msgid "*My Certificate"
msgstr "*ໃບຢັ້ງຢືນຂອງຂ້ອຍ"

#: src/usr/local/www/vpn_ipsec_phase1.php:901
msgid "Select a certificate previously configured in the Certificate Manager."
msgstr "ເລືອກໃບຢັ້ງຢືນທີ່ໄດ້ຕັ້ງຄ່າໄວ້ກ່ອນໜ້ານີ້ໃນຜູ້ຈັດການໃບຢັ້ງຢືນ."

#: src/usr/local/www/vpn_ipsec_phase1.php:905
msgid "*PKCS#11 Certificate"
msgstr "*ໃບຢັ້ງຢືນ PKCS#11"

#: src/usr/local/www/vpn_ipsec_phase1.php:908
msgid "Select a Certificate from an attached PKCS#11 token device"
msgstr "ເລືອກໃບຢັ້ງຢືນຈາກອຸປະກອນໂທເຄັນ PKCS#11 ທີ່ຕິດຄັດມາ"

#: src/usr/local/www/vpn_ipsec_phase1.php:912
msgid "*PKCS#11 PIN"
msgstr "*ລະຫັດ PIN PKCS#11"

#: src/usr/local/www/vpn_ipsec_phase1.php:915
