#: src/usr/local/www/services_unbound_domainoverride_edit.php:149
msgid "TLS Hostname"
msgstr "ຊື່ໂຮສ TLS"

#: src/usr/local/www/services_unbound_domainoverride_edit.php:152
msgid ""
