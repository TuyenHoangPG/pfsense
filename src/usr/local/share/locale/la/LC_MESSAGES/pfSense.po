#: src/usr/local/www/vpn_ipsec_phase1.php:786
msgid "*Key Exchange version"
msgstr "*ເວີຊັນການແລກປ່ຽນຄີ"

#: src/usr/local/www/vpn_ipsec_phase1.php:789
msgid ""
"Select the Internet Key Exchange protocol version to be used. Auto uses "
"IKEv2 when initiator, and accepts either IKEv1 or IKEv2 as responder."
msgstr "ເລືອກເວີຊັນໂປຣໂຕຄໍ Internet Key Exchange ທີ່ຈະໃຊ້. ອັດຕະໂນມັດໃຊ້ IKEv2 ເມື່ອເປັນ initiator, ແລະຍອມຮັບທັງ IKEv1 ຫຼື IKEv2 ເປັນ responder."

#: src/usr/local/www/vpn_ipsec_phase1.php:793
msgid "*Internet Protocol"
msgstr "*ໂປຣໂຕຄໍອິນເຕີເນັດ"

#: src/usr/local/www/vpn_ipsec_phase1.php:796
msgid "Select the Internet Protocol family."
msgstr "ເລືອກຄອບຄົວໂປຣໂຕຄໍອິນເຕີເນັດ."

#: src/usr/local/www/vpn_ipsec_phase1.php:803
msgid "Select the interface for the local endpoint of this phase1 entry."
msgstr "ເລືອກອິນເຕີເຟດສໍາລັບຈຸດສຸດທ້າຍໂລຄອນຂອງລາຍການ phase1 ນີ້."

#: src/usr/local/www/vpn_ipsec_phase1.php:806
msgid "*Remote Gateway"
msgstr "*ເກດເວຣີໂໝດຣີໂໝດ"

#: src/usr/local/www/vpn_ipsec_phase1.php:815
msgid ""
"Use '0.0.0.0' to allow connections from any IPv4 address or '::' to allow "
"connections from any IPv6 address.<br/>Responder Only must be set and Peer "
"IP Address cannot be used for Remote Identifier."
msgstr "ໃຊ້ '0.0.0.0' ເພື່ອອະນຸຍາດການເຊື່ອມຕໍ່ຈາກທີ່ຢູ່ IPv4 ໃດກໍໄດ້ ຫຼື '::' ເພື່ອອະນຸຍາດການເຊື່ອມຕໍ່ຈາກທີ່ຢູ່ IPv6 ໃດກໍໄດ້.<br/>ຕ້ອງຕັ້ງຄ່າ Responder Only ແລະບໍ່ສາມາດໃຊ້ Peer IP Address ສໍາລັບ Remote Identifier ໄດ້."

#: src/usr/local/www/vpn_ipsec_phase1.php:813
#, php-format
msgid ""
"Enter the public IP address or host name of the remote gateway.%1$s%2$s%3$s"
msgstr "ໃສ່ທີ່ຢູ່ IP ສາທາລະນະ ຫຼືຊື່ໂຮສຂອງເກດເວຣີໂໝດຣີໂໝດ.%1$s%2$s%3$s"

#: src/usr/local/www/vpn_ipsec_phase1.php:832
msgid "Phase 1 Proposal (Authentication)"
msgstr "ຂໍ້ສະເໜີ Phase 1 (ການກວດສອບ)"

#: src/usr/local/www/vpn_ipsec_phase1.php:839
msgid "Must match the setting chosen on the remote side."
msgstr "ຕ້ອງກົງກັບການຕັ້ງຄ່າທີ່ເລືອກໃນດ້ານຣີໂໝດ."

#: src/usr/local/www/vpn_ipsec_phase1.php:845
msgid "Main"
msgstr "ຫຼັກ"

#: src/usr/local/www/vpn_ipsec_phase1.php:843
