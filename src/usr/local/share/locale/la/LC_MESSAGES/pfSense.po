msgstr "ພອດ IKE/NAT-T ແບບກຳນົດເອງ"

#: src/usr/local/www/vpn_ipsec_phase1.php:1104
msgid "Remote IKE Port"
msgstr "ພອດ IKE ຣີໂໝດ"

#: src/usr/local/www/vpn_ipsec_phase1.php:1108
msgid ""
"UDP port for IKE on the remote gateway. Leave empty for default automatic "
