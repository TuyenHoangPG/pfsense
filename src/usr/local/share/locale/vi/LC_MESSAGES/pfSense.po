msgstr "Chỉ hiển thị các bộ tham số DH tồn tại trong /etc/."  

#: src/usr/local/www/vpn_openvpn_server.php:1015  
msgid ""  
"Generating new or stronger DH parameters is CPU-intensive and must be "  
