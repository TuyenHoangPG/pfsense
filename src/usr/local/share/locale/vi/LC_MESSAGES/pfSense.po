msgstr "*Cơ quan chứng nhận của peer"

#: src/usr/local/www/vpn_openvpn_client.php:798
#: src/usr/local/www/vpn_openvpn_client.php:804
#: src/usr/local/www/vpn_openvpn_server.php:956
#: src/usr/local/www/vpn_openvpn_server.php:962
