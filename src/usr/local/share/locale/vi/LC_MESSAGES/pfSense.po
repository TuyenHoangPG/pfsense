#: src/usr/local/www/services_router_advertisements.php:177
msgid "Valid lifetime must be an integer."
msgstr "Thời gian tồn tại hợp lệ phải là một số nguyên."

#: src/usr/local/www/services_router_advertisements.php:181
msgid "Minimum advertisement interval must be an integer."
msgstr "Khoảng thời gian quảng bá tối thiểu phải là một số nguyên."

#: src/usr/local/www/services_router_advertisements.php:184
msgid "Minimum advertisement interval must be no less than 3."
msgstr "Khoảng thời gian quảng bá tối thiểu không được nhỏ hơn 3."

#: src/usr/local/www/services_router_advertisements.php:187
msgid ""
"Minimum advertisement interval must be no greater than 0.75 * Maximum "
