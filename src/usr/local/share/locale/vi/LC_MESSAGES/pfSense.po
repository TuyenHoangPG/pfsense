#: src/usr/local/www/services_dhcpv6.php:758
#: src/usr/local/www/services_dhcp.php:1215
#: src/usr/local/www/services_dhcp_edit.php:613
msgid ""
"The DHCP server can optionally provide a domain search list. Use the "
"semicolon character as separator."
msgstr ""
"Máy chủ DHCP có thể tùy chọn cung cấp danh sách tìm kiếm tên miền. Sử dụng "
"ký tự dấu chấm phẩy làm dấu phân cách."

#: src/usr/local/www/services_dhcpv6.php:762
#: src/usr/local/www/services_dhcp.php:1219
msgid "Default lease time"
msgstr "Thời gian thuê mặc định"

#: src/usr/local/www/services_dhcpv6.php:765
#, php-format
msgid ""
"Lease time in seconds. Used for clients that do not ask for a specific "
"expiration time. %1$sThe default is 7200 seconds."
msgstr ""
"Thời gian thuê tính bằng giây. Được sử dụng cho các khách hàng không yêu cầu "
"thời gian hết hạn cụ thể. %1$sMặc định là 7200 giây."

#: src/usr/local/www/services_dhcpv6.php:770
msgid "Max lease time"
msgstr "Thời gian thuê tối đa"

#: src/usr/local/www/services_dhcpv6.php:773
#, php-format
msgid ""
"Maximum lease time for clients that ask for a specific expiration time. "
"%1$sThe default is 86400 seconds."
msgstr ""
"Thời gian thuê tối đa cho khách hàng yêu cầu thời gian hết hạn cụ thể."
"%1$sMặc định là 86400 giây."

#: src/usr/local/www/services_dhcpv6.php:778
msgid "Time Format Change"
msgstr "Thay đổi định dạng thời gian"

#: src/usr/local/www/services_dhcpv6.php:781
msgid ""
"By default DHCPv6 leases are displayed in UTC time. By checking this box "
"DHCPv6 lease time will be displayed in local time and set to time zone "
"selected. This will be used for all DHCPv6 interfaces lease time."
msgstr ""
"Theo mặc định, các hợp đồng thuê DHCPv6 được hiển thị theo giờ UTC. Bằng cách chọn hộp này "
"Thời gian thuê DHCPv6 sẽ được hiển thị theo giờ địa phương và được đặt thành múi giờ "
"đã chọn. Điều này sẽ được sử dụng cho tất cả thời gian thuê giao diện DHCPv6."

