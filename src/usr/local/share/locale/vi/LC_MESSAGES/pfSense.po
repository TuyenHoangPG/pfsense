msgstr "Băng thông phải được thiết lập. Thông thường đây là tốc độ của giao diện."

#: src/etc/inc/shaper.inc:781 src/etc/inc/shaper.inc:1568
#: src/etc/inc/shaper.inc:2295
msgid "Bandwidth must be an integer."
msgstr "Băng thông phải là một số nguyên."

#: src/etc/inc/shaper.inc:784 src/etc/inc/shaper.inc:1571
#: src/etc/inc/shaper.inc:2299
msgid "Bandwidth cannot be negative."
msgstr "Băng thông không thể là số âm."

#: src/etc/inc/shaper.inc:788 src/etc/inc/shaper.inc:1575
#: src/etc/inc/shaper.inc:2304
msgid "Bandwidth in percentage should be between 1 and 100."
msgstr "Băng thông dưới dạng phần trăm phải nằm trong khoảng từ 1 đến 100."

#: src/etc/inc/shaper.inc:795
msgid "Qlimit must be an integer."
msgstr "Qlimit phải là một số nguyên."

#: src/etc/inc/shaper.inc:798
msgid "Qlimit must be positive."
msgstr "Qlimit phải là một số dương."

#: src/etc/inc/shaper.inc:801
msgid "Tbrsize must be an integer."
msgstr "Tbrsize phải là một số nguyên."

#: src/etc/inc/shaper.inc:804
msgid "Tbrsize must be positive."
msgstr "Tbrsize phải là một số dương."

#: src/etc/inc/shaper.inc:1024
#, php-format
msgid "SHAPER: no default queue specified for interface %s."
msgstr "BỘ ĐỊNH HÌNH: không có hàng đợi mặc định nào được chỉ định cho giao diện %s."

#: src/etc/inc/shaper.inc:1024
msgid "The interface queue will be enforced as default."
msgstr "Hàng đợi của giao diện sẽ được áp dụng làm mặc định."

#: src/etc/inc/shaper.inc:1110
msgid "Remove shaper from this interface"
msgstr "Xóa bộ định hình khỏi giao diện này."

#: src/etc/inc/shaper.inc:1134 src/etc/inc/shaper.inc:1789
msgid "Enable/Disable"
msgstr "Bật/Tắt"

#: src/etc/inc/shaper.inc:1147
msgid "Scheduler Type"
msgstr "Loại bộ lập lịch"

#: src/etc/inc/shaper.inc:1154
msgid ""
"Changing this changes all child queues! Beware information can be lost."
msgstr "Thay đổi cài đặt này sẽ thay đổi tất cả các hàng đợi con! Cẩn thận, dữ liệu có thể bị mất."

#: src/etc/inc/shaper.inc:1180 src/etc/inc/shaper.inc:1821
msgid "Queue Limit"
msgstr "Giới hạn hàng đợi"

#: src/etc/inc/shaper.inc:1187
msgid "TBR Size"
msgstr "Kích thước TBR"

#: src/etc/inc/shaper.inc:1190
msgid ""
"Adjusts the size, in bytes, of the token bucket regulator. If not specified, "
"heuristics based on the interface bandwidth are used to determine the size."
msgstr ""
"Điều chỉnh kích thước, tính bằng byte, của bộ điều chỉnh token bucket. Nếu không được chỉ định, "
"thuật toán dựa trên băng thông của giao diện sẽ được sử dụng để xác định kích thước."

#: src/etc/inc/shaper.inc:1584
msgid "The priority must be an integer between 0 and 15."
msgstr "Độ ưu tiên phải là một số nguyên trong khoảng từ 0 đến 15."

#: src/etc/inc/shaper.inc:1587
msgid "The priority must be an integer between 0 and 7."
msgstr "Độ ưu tiên phải là một số nguyên trong khoảng từ 0 đến 7."

#: src/etc/inc/shaper.inc:1592
msgid "A queue with the same name already exists."
msgstr "Đã tồn tại một hàng đợi có cùng tên."

#: src/etc/inc/shaper.inc:1596
#, php-format
msgid "The priority %d is already used by queue %s."
msgstr "Độ ưu tiên %d đã được sử dụng bởi hàng đợi %s."

#: src/etc/inc/shaper.inc:1604 src/etc/inc/shaper.inc:3690
msgid "Queue limit must be an integer"
msgstr "Giới hạn hàng đợi phải là một số nguyên."

#: src/etc/inc/shaper.inc:1607
msgid "Queue limit must be positive"
msgstr "Giới hạn hàng đợi phải là số dương."

#: src/etc/inc/shaper.inc:1610 src/etc/inc/shaper.inc:1613
#: src/etc/inc/shaper.inc:3693 src/etc/inc/shaper.inc:3696
msgid "Queue names must be alphanumeric and _ or - only."
msgstr "Tên hàng đợi chỉ được chứa ký tự chữ, số, _ hoặc -."

#: src/etc/inc/shaper.inc:1617
msgid "Only one default queue per interface is allowed."
msgstr "Chỉ cho phép một hàng đợi mặc định trên mỗi giao diện."

#: src/etc/inc/shaper.inc:1800
msgid ""
"Enter the name of the queue here. Do not use spaces and limit the size to 15 "
"characters."
msgstr ""
"Nhập tên hàng đợi tại đây. Không sử dụng khoảng trắng và giới hạn độ dài tối đa 15 ký tự."

#: src/etc/inc/shaper.inc:1816
msgid ""
"For cbq and fairq the range is 0 to 7. The default is 1. For priq the range "
"is 0 to 15, queues with a higher priority are preferred in the case of "
"overload."
msgstr ""
"Đối với cbq và fairq, phạm vi là từ 0 đến 7. Mặc định là 1. Đối với priq, phạm vi "
"là từ 0 đến 15, các hàng đợi có độ ưu tiên cao hơn sẽ được ưu tiên trong trường hợp "
"quá tải."

#: src/etc/inc/shaper.inc:1824
msgid "Queue limit in packets."
msgstr "Giới hạn hàng đợi theo số gói tin."

#: src/etc/inc/shaper.inc:1826
msgid "Scheduler options"
msgstr "Tùy chọn bộ lập lịch."

