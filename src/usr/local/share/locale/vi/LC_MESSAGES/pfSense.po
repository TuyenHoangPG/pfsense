msgstr ""
"Số cổng OMAPI đã chỉ định không hợp lệ. Số cổng phải nằm trong khoảng từ 1024 "
"đến 65635."

#: src/usr/local/www/services_dhcp.php:270
msgid ""
"Specified port number for OMAPI is in use. Please choose another port or "
"consider using the default."
msgstr ""
"Số cổng OMAPI đã chỉ định đang được sử dụng. Vui lòng chọn một cổng khác hoặc "
"xem xét sử dụng cổng mặc định."

#: src/usr/local/www/services_dhcp.php:320
msgid "A key is required when OMAPI is enabled (port specified)."
msgstr "Một khóa là cần thiết khi OMAPI được bật (cổng đã chỉ định)."

#: src/usr/local/www/services_dhcp.php:327
msgid "Range begin"
msgstr "Bắt đầu phạm vi"

#: src/usr/local/www/services_dhcp.php:327
msgid "Range end"
msgstr "Kết thúc phạm vi"

#: src/usr/local/www/services_dhcp.php:333
msgid ""
"Ignore Denied Clients may not be used when a Failover Peer IP is defined."
msgstr ""
"Tuỳ chọn Bỏ qua các Máy khách Bị từ chối không thể được sử dụng khi một "
"IP của Peer dự phòng được định nghĩa."

#: src/usr/local/www/services_dhcp.php:337
msgid "A valid IPv4 address must be specified for range from."
msgstr "Một địa chỉ IPv4 hợp lệ phải được chỉ định cho phạm vi bắt đầu."

#: src/usr/local/www/services_dhcp.php:340
msgid "A valid IPv4 address must be specified for range to."
msgstr "Một địa chỉ IPv4 hợp lệ phải được chỉ định cho phạm vi kết thúc."

#: src/usr/local/www/services_dhcp.php:346
msgid "A valid IP address must be specified for the gateway."
msgstr "Một địa chỉ IP hợp lệ phải được chỉ định cho cổng gateway."

#: src/usr/local/www/services_dhcp.php:349
msgid ""
"A valid IP address must be specified for the primary/secondary WINS servers."
msgstr ""
"Một địa chỉ IP hợp lệ phải được chỉ định cho các máy chủ WINS chính/phụ."

#: src/usr/local/www/services_dhcp.php:355
#: src/usr/local/www/services_dhcp_edit.php:268
#, php-format
msgid ""
"The gateway address %s does not lie within the chosen interface's subnet."
msgstr ""
"Địa chỉ cổng %s không nằm trong phạm vi subnet của giao diện đã chọn."

#: src/usr/local/www/services_dhcp.php:360
msgid "A valid IP address must be specified for each of the DNS servers."
msgstr "Một địa chỉ IP hợp lệ phải được chỉ định cho mỗi máy chủ DNS."

#: src/usr/local/www/services_dhcp.php:386
#, php-format
msgid ""
"The Captive Portal zone (%1$s) has Hard Timeout parameter set to a value "
"bigger than Default lease time (%2$s)."
msgstr ""
"Khu vực của Cổng Captive (%1$s) có tham số Thời gian Timeout Cứng được thiết lập "
"với giá trị lớn hơn Thời gian thuê mặc định (%2$s)."

#: src/usr/local/www/services_dhcp.php:426
msgid ""
"If a mac allow list is specified, it must contain only valid partial MAC "
"addresses."
msgstr ""
" Nếu một danh sách MAC cho phép được chỉ định, nó phải chỉ chứa các địa chỉ "
"MAC một phần hợp lệ."

#: src/usr/local/www/services_dhcp.php:429
msgid ""
"If a mac deny list is specified, it must contain only valid partial MAC "
"addresses."
msgstr ""
" Nếu một danh sách MAC từ chối được chỉ định, nó phải chỉ chứa các địa chỉ "
"MAC một phần hợp lệ."

#: src/usr/local/www/services_dhcp.php:435
#: src/usr/local/www/services_dhcp_edit.php:317
msgid ""
"A valid IP address or hostname must be specified for the primary/secondary "
"NTP servers."
msgstr ""
"Một địa chỉ IP hợp lệ hoặc tên máy chủ phải được chỉ định cho các máy chủ "
"NTP chính/phụ."

#: src/usr/local/www/services_dhcp.php:441
msgid ""
"A valid IP address, hostname or URL must be specified for the TFTP server."
msgstr ""
"Một địa chỉ IP hợp lệ, tên máy chủ hoặc URL phải được chỉ định cho máy chủ TFTP."

#: src/usr/local/www/services_dhcp.php:444
msgid "A valid IP address must be specified for the network boot server."
msgstr ""
"Một địa chỉ IP hợp lệ phải được chỉ định cho máy chủ khởi động mạng."

#: src/usr/local/www/services_dhcp.php:448
msgid "The network address cannot be used in the starting subnet range."
msgstr ""
"Địa chỉ mạng không thể được sử dụng trong phạm vi bắt đầu của subnet."

#: src/usr/local/www/services_dhcp.php:451
msgid "The broadcast address cannot be used in the ending subnet range."
msgstr ""
"Địa chỉ phát sóng không thể được sử dụng trong phạm vi kết thúc của subnet."

#: src/usr/local/www/services_dhcp.php:459
#, php-format
msgid "The subnet range cannot overlap with virtual IP address %s."
msgstr ""
"Phạm vi subnet không thể chồng lấn với địa chỉ IP ảo %s."

#: src/usr/local/www/services_dhcp.php:475
msgid ""
"Cannot enable static ARP when there are static map entries without IP "
"addresses. Ensure all static maps have IP addresses and try again."
msgstr ""
"Không thể kích hoạt ARP tĩnh khi có các mục bản đồ tĩnh mà không có địa chỉ IP. "
"Hãy đảm bảo rằng tất cả các bản đồ tĩnh đều có địa chỉ IP và thử lại."

#: src/usr/local/www/services_dhcp.php:482
msgid "Text type cannot include quotation marks."
msgstr "Loại văn bản không thể bao gồm dấu ngoặc kép."

#: src/usr/local/www/services_dhcp.php:484
msgid ""
"String type must be enclosed in quotes like \"this\" or must be a series of "
"octets specified in hexadecimal, separated by colons, like 01:23:45:67:89:ab:"
"cd:ef"
msgstr ""
"Loại chuỗi phải được bao bọc trong dấu ngoặc kép như \"this\" hoặc phải là một "
"chuỗi các octet được chỉ định trong hệ thập lục phân, cách nhau bằng dấu hai chấm, "
"ví dụ 01:23:45:67:89:ab:cd:ef."

#: src/usr/local/www/services_dhcp.php:486
msgid "Boolean type must be true, false, on, or off."
msgstr "Loại boolean phải có giá trị true, false, on, hoặc off."

#: src/usr/local/www/services_dhcp.php:488
msgid "Unsigned 8-bit integer type must be a number in the range 0 to 255."
msgstr "Loại số nguyên 8 bit không dấu phải là một số trong phạm vi từ 0 đến 255."

#: src/usr/local/www/services_dhcp.php:490
msgid "Unsigned 16-bit integer type must be a number in the range 0 to 65535."
msgstr "Loại số nguyên 16 bit không dấu phải là một số trong phạm vi từ 0 đến 65535."

#: src/usr/local/www/services_dhcp.php:492
msgid ""
"Unsigned 32-bit integer type must be a number in the range 0 to 4294967295."
msgstr ""
"Loại số nguyên 32 bit không dấu phải là một số trong phạm vi từ 0 đến 4294967295."

#: src/usr/local/www/services_dhcp.php:494
msgid "Signed 8-bit integer type must be a number in the range -128 to 127."
msgstr "Loại số nguyên 8 bit có dấu phải là một số trong phạm vi từ -128 đến 127."


#: src/usr/local/www/services_dhcp.php:496
msgid ""
"Signed 16-bit integer type must be a number in the range -32768 to 32767."
msgstr ""
"Loại số nguyên 16 bit có dấu phải là một số trong phạm vi từ -32768 đến 32767."

#: src/usr/local/www/services_dhcp.php:498
msgid ""
"Signed 32-bit integer type must be a number in the range -2147483648 to "
"2147483647."
msgstr ""
"Loại số nguyên 32 bit có dấu phải là một số trong phạm vi từ -2147483648 đến "
"2147483647."

#: src/usr/local/www/services_dhcp.php:500
msgid "IP address or host type must be an IP address or host name."
msgstr "Loại địa chỉ IP hoặc tên máy chủ phải là một địa chỉ IP hoặc tên máy chủ."

#: src/usr/local/www/services_dhcp.php:534
msgid ""
"DHCP Registration features in the DNS Forwarder are active and require at "
"least one enabled DHCP Server."
msgstr ""
"Chức năng đăng ký DHCP trong DNS Forwarder đang hoạt động và yêu cầu ít nhất "
"một máy chủ DHCP được bật."

#: src/usr/local/www/services_dhcp.php:541
msgid ""
"DHCP Registration features in the DNS Resolver are active and require at "
"least one enabled DHCP Server."
msgstr ""
"Chức năng đăng ký DHCP trong DNS Resolver đang hoạt động và yêu cầu ít nhất "
"một máy chủ DHCP được bật."

#: src/usr/local/www/services_dhcp.php:565
msgid ""
"The specified range must not be within the DHCP range for this interface."
msgstr ""
"Phạm vi đã chỉ định không được nằm trong phạm vi DHCP của giao diện này."

#: src/usr/local/www/services_dhcp.php:578
msgid ""
"The specified range must not be within the range configured on a DHCP pool "
"for this interface."
msgstr ""
"Phạm vi đã chỉ định không được nằm trong phạm vi được cấu hình trên một "
"pool DHCP cho giao diện này."

#: src/usr/local/www/services_dhcp.php:768
msgid "DHCP Server - Settings changed for interface "
msgstr "Máy chủ DHCP - Cài đặt đã thay đổi cho giao diện"

