msgid "RFC 2307 User DN"
msgstr "DN người dùng RFC 2307"

#: src/usr/local/www/system_authservers.php:786
msgid "RFC 2307 user DN"
msgstr "DN người dùng RFC 2307"

#: src/usr/local/www/system_authservers.php:789
msgid ""
"Use DN for username search, i.e. \"(member=CN=Username,CN=Users,DC="
