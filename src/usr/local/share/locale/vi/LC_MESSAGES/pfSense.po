msgstr "Đường cong dịch vụ chia sẻ liên kết đã được định nghĩa nhưng thiếu giá trị (d)."

#: src/etc/inc/shaper.inc:2342
msgid ""
"linkshare service curve defined but missing initial bandwidth (m1) value"
msgstr ""
"Đường cong dịch vụ chia sẻ liên kết đã được định nghĩa nhưng thiếu giá trị băng thông ban đầu (m1)."

#: src/etc/inc/shaper.inc:2345
msgid "linkshare m1 value needs to be Kb, Mb, Gb, or %"
msgstr "Giá trị m1 của chia sẻ liên kết phải là Kb, Mb, Gb hoặc %."

#: src/etc/inc/shaper.inc:2348
msgid "linkshare d value needs to be numeric"
msgstr "Giá trị d của chia sẻ liên kết phải là số."

#: src/etc/inc/shaper.inc:2351
msgid "linkshare m2 value needs to be Kb, Mb, Gb, or %"
msgstr "Giá trị m2 của chia sẻ liên kết phải là Kb, Mb, Gb hoặc %."

