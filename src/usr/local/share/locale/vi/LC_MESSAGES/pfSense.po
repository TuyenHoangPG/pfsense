msgstr ""
"Sử dụng DN để tìm kiếm tên người dùng, ví dụ: \"(member=CN=Username,CN=Users,DC="
"example,DC=com)\"."

#: src/usr/local/www/system_authservers.php:795
msgid "Group Object Class"
msgstr "Lớp đối tượng nhóm"

#: src/usr/local/www/system_authservers.php:799
