#: src/usr/local/www/services_captiveportal_hostname.php:34
#, php-format
msgid ""
"Adding new hostnames will allow a DNS hostname access to/from the captive "
"portal without being taken to the portal page. This can be used for a web "
"server serving images for the portal page, or a DNS server on another "
"network, for example. By specifying %1$sfrom%2$s addresses, it may be used "
"to always allow pass-through access from a client behind the captive portal."
msgstr ""
"Thêm các tên máy chủ mới sẽ cho phép truy cập tên máy chủ DNS từ/đến "
"cổng captive mà không bị chuyển hướng đến trang cổng. Điều này có thể được "
"sử dụng cho một máy chủ web phục vụ hình ảnh cho trang cổng, hoặc một máy chủ DNS "
"trên mạng khác, ví dụ. Bằng cách chỉ định địa chỉ %1$sfrom%2$s, nó có thể được sử dụng "
"để luôn cho phép truy cập qua lại từ một client ở phía sau cổng captive."

