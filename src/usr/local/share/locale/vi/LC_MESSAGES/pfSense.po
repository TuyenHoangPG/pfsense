#: src/usr/local/www/diag_packet_capture.php:349
msgid "Promiscuous"
msgstr "Chế độ promiscuous"

#: src/usr/local/www/diag_packet_capture.php:352
#, php-format
msgid ""
"%1$sNon-promiscuous mode captures only traffic that is directly relevant to "
"the host (sent by it, sent or broadcast to it, or routed through it) and "
"does not show packets that are ignored at network adapter level."
"%2$s%3$sPromiscuous mode%4$s (\"sniffing\") captures all data seen by the "
"adapter, whether or not it is valid or related to the host, but in some "
"cases may have undesirable side effects and not all adapters support this "
"option. Click Info for details %5$sPromiscuous mode requires more kernel "
"processing of packets. This puts a slightly higher demand on system "
"resources, especially on very busy networks or low power processors. The "
"change in packet processing may allow a hostile host to detect that an "
"adapter is in promiscuous mode or to 'fingerprint' the kernel (see %6$s). "
"Some network adapters may not support or work well in promiscuous mode (see "
"%7$s).%8$s"
msgstr ""
"%1$s Chế độ không promiscuous chỉ ghi nhận lưu lượng mạng có liên quan "
"trực tiếp đến máy chủ (gửi từ nó, gửi hoặc phát sóng đến nó, hoặc được "
"định tuyến qua nó) và không hiển thị các gói tin bị bỏ qua ở mức bộ điều "
"hợp mạng.%2$s%3$sChế độ promiscuous%4$s (\"sniffing\") ghi nhận tất cả "
"dữ liệu mà bộ điều hợp nhìn thấy, dù có hợp lệ hay liên quan đến máy chủ "
"hay không, nhưng trong một số trường hợp có thể có tác dụng phụ không "
"mong muốn và không phải tất cả bộ điều hợp đều hỗ trợ tùy chọn này. Nhấn "
"Info để biết thêm chi tiết. %5$sChế độ promiscuous yêu cầu xử lý gói tin "
"nhiều hơn từ nhân hệ điều hành. Điều này tạo ra một yêu cầu cao hơn về "
"tài nguyên hệ thống, đặc biệt là trên các mạng bận rộn hoặc bộ xử lý có "
"công suất thấp. Thay đổi trong xử lý gói tin có thể cho phép một máy chủ "
"thù địch phát hiện rằng bộ điều hợp đang ở chế độ promiscuous hoặc có thể "
"nhận diện dấu vân tay của nhân hệ điều hành (xem %6$s). Một số bộ điều hợp "
"mạng có thể không hỗ trợ hoặc không hoạt động tốt ở chế độ promiscuous (xem "
"%7$s).%8$s"

