#, php-format
msgid "%1$sCodel Active Queue%2$s"
msgstr "%1$sHàng đợi hoạt động Codel%2$s"

#: src/etc/inc/shaper.inc:1866
msgid "Select options for this queue"
msgstr "Chọn tùy chọn cho hàng đợi này."

#: src/etc/inc/shaper.inc:1951
msgid "Delete Queue from this Interface"
msgstr "Xóa hàng đợi khỏi giao diện này."

