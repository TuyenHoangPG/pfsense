"Đường cong dịch vụ giới hạn trên đã được định nghĩa nhưng thiếu giá trị băng thông ban đầu (m1)."

#: src/etc/inc/shaper.inc:2316
msgid "upperlimit m1 value needs to be Kb, Mb, Gb, or %"
msgstr "Giá trị giới hạn trên của m1 phải là Kb, Mb, Gb hoặc %."

#: src/etc/inc/shaper.inc:2319
msgid "upperlimit d value needs to be numeric"
msgstr "Giá trị giới hạn trên của d phải là số."

#: src/etc/inc/shaper.inc:2322
msgid "upperlimit m2 value needs to be Kb, Mb, Gb, or %"
