msgid "A valid IPv6 address must be specified for each of the DNS servers."
msgstr ""
"Phải chỉ định một địa chỉ IPv6 hợp lệ cho mỗi máy chủ DNS."

#: src/usr/local/www/services_dhcpv6.php:311
#: src/usr/local/www/services_dhcp.php:364
#: src/usr/local/www/services_dhcp_edit.php:279
msgid "The default lease time must be at least 60 seconds."
msgstr "Thời gian thuê mặc định phải ít nhất là 60 giây."

#: src/usr/local/www/services_dhcpv6.php:314
#: src/usr/local/www/services_dhcp.php:392
#: src/usr/local/www/services_dhcp_edit.php:282
msgid ""
"The maximum lease time must be at least 60 seconds and higher than the "
"default lease time."
msgstr ""
"Thời gian thuê tối đa phải ít nhất là 60 giây và cao hơn "
"thời gian thuê mặc định."

#: src/usr/local/www/services_dhcpv6.php:318
#: src/usr/local/www/services_dhcp.php:396
#: src/usr/local/www/services_dhcp_edit.php:286
msgid ""
"A valid domain name must be specified for the dynamic DNS registration."
msgstr ""
"Tên miền hợp lệ phải được chỉ định cho đăng ký DNS động."

#: src/usr/local/www/services_dhcpv6.php:321
#: src/usr/local/www/services_dhcp.php:399
#: src/usr/local/www/services_dhcp_edit.php:289
msgid ""
"A valid primary domain name server IP address must be specified for the "
"dynamic domain name."
msgstr ""
"Địa chỉ IP máy chủ tên miền chính hợp lệ phải được chỉ định cho "
"tên miền động."

#: src/usr/local/www/services_dhcpv6.php:324
#: src/usr/local/www/services_dhcp.php:402
#: src/usr/local/www/services_dhcp_edit.php:292
msgid ""
"A valid secondary domain name server IP address must be specified for the "
"dynamic domain name."
msgstr ""
"Địa chỉ IP máy chủ tên miền phụ hợp lệ phải được chỉ định cho "
"tên miền động"

#: src/usr/local/www/services_dhcpv6.php:327
#: src/usr/local/www/services_dhcp.php:405
#: src/usr/local/www/services_dhcp_edit.php:295
msgid "A valid domain key name, algorithm and secret must be specified."
msgstr ""
"Phải chỉ định tên khóa miền, thuật toán và bí mật hợp lệ."

#: src/usr/local/www/services_dhcpv6.php:330
#: src/usr/local/www/services_dhcp.php:408
#: src/usr/local/www/services_dhcp_edit.php:298
msgid ""
"The domain key name may only contain the characters a-z, A-Z, 0-9, '-', '_' "
"and '.'"
msgstr ""
"Tên khóa miền chỉ có thể chứa các ký tự a-z, A-Z, 0-9, '-', '_' "
"và '.'"

#: src/usr/local/www/services_dhcpv6.php:333
#: src/usr/local/www/services_dhcp.php:411
#: src/usr/local/www/services_dhcp_edit.php:301
msgid "The domain key secret must be a Base64 encoded value."
msgstr "Bí mật khóa miền phải là giá trị được mã hóa Base64."

#: src/usr/local/www/services_dhcpv6.php:340
#: src/usr/local/www/services_router_advertisements.php:167
#: src/usr/local/www/services_dhcp.php:418
#: src/usr/local/www/services_dhcp_edit.php:308
msgid "A valid domain search list must be specified."
msgstr "Phải chỉ định danh sách tìm kiếm tên miền hợp lệ."

#: src/usr/local/www/services_dhcpv6.php:349
msgid ""
"A valid IPv6 address must be specified for the primary/secondary NTP servers."
""
msgstr ""
"Phải chỉ định địa chỉ IPv6 hợp lệ cho máy chủ NTP chính/phụ."

#: src/usr/local/www/services_dhcpv6.php:352
#: src/usr/local/www/services_dhcp.php:438
#: src/usr/local/www/services_dhcp_edit.php:320
msgid "A valid domain name must be specified for the DNS domain."
msgstr "Tên miền hợp lệ phải được chỉ định cho miền DNS."

#: src/usr/local/www/services_dhcpv6.php:355
msgid ""
"A valid IPv6 address or hostname must be specified for the TFTP server."
msgstr ""
"Phải chỉ định địa chỉ IPv6 hoặc tên máy chủ hợp lệ cho máy chủ TFTP."

#: src/usr/local/www/services_dhcpv6.php:358
msgid "A valid URL must be specified for the network bootfile."
msgstr "URL hợp lệ phải được chỉ định cho tệp khởi động mạng."

#: src/usr/local/www/services_dhcpv6.php:366
#, php-format
msgid "The subnet range cannot overlap with virtual IPv6 address %s."
msgstr "Phạm vi mạng con không thể chồng lấn với địa chỉ IPv6 ảo %s."

#: src/usr/local/www/services_dhcpv6.php:383
#: src/usr/local/www/services_dhcp.php:510
#, php-format
msgid ""
"The DHCP relay on the %s interface must be disabled before enabling the DHCP "
"server."
msgstr ""
"Chuyển tiếp DHCP trên giao diện %s phải bị vô hiệu hóa trước khi bật máy chủ DHCP"

#: src/usr/local/www/services_dhcpv6.php:395
#: src/usr/local/www/services_dhcp.php:555
msgid "The specified range lies outside of the current subnet."
msgstr "Phạm vi được chỉ định nằm ngoài mạng con hiện tại."

#: src/usr/local/www/services_dhcpv6.php:400
#: src/usr/local/www/services_dhcp.php:550
msgid "The range is invalid (first element higher than second element)."
msgstr ""
"Phạm vi không hợp lệ (phần tử đầu tiên cao hơn phần tử thứ hai)."

#: src/usr/local/www/services_dhcpv6.php:416
#: src/usr/local/www/services_dhcp.php:589
#, php-format
msgid "The DHCP range cannot overlap any static DHCP mappings."
msgstr "Phạm vi DHCP không được chồng lấn bất kỳ ánh xạ DHCP tĩnh nào."

