#: src/etc/inc/pfsense-utils.inc:217
msgid "The submitted Theme could not be found. Pick a different theme."
msgstr "Chủ đề đã gửi không được tìm thấy. Vui lòng chọn một chủ đề khác."

#: src/etc/inc/pfsense-utils.inc:236
