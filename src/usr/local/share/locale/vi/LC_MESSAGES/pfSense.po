msgid "Universally Unique Identifier"
msgstr "Định danh duy nhất toàn cầu (UUID)"

#: src/usr/local/www/system_advanced_network.php:218
msgid "Network Interfaces"
msgstr "Giao diện mạng"

#: src/usr/local/www/system_advanced_network.php:222
msgid "Hardware Checksum Offloading"
msgstr "Tắt kiểm tra tổng phần cứng"

#: src/usr/local/www/system_advanced_network.php:225
#, php-format
msgid ""
"Checking this option will disable hardware checksum offloading.%1$sChecksum "
"offloading is broken in some hardware, particularly some Realtek cards. "
"Rarely, drivers may have problems with checksum offloading and some specific "
"NICs. This will take effect after a machine reboot or re-configure of each "
"interface."
msgstr ""
"Bật tùy chọn này sẽ vô hiệu hóa tính năng tắt kiểm tra tổng phần cứng.%1$s "
"Một số phần cứng, đặc biệt là các card Realtek, có thể gặp lỗi khi tắt kiểm "
"tra tổng. Hiếm khi, một số trình điều khiển cũng có vấn đề với tính năng này "
"trên một số card mạng cụ thể. Thay đổi này sẽ có hiệu lực sau khi khởi động "
"lại hoặc cấu hình lại từng giao diện."

#: src/usr/local/www/system_advanced_network.php:233
msgid "Hardware TCP Segmentation Offloading"
msgstr "Tắt phân đoạn TCP phần cứng"

#: src/usr/local/www/system_advanced_network.php:236
msgid ""
"Checking this option will disable hardware TCP segmentation offloading (TSO, "
"TSO4, TSO6). This offloading is broken in some hardware drivers, and may "
"impact performance with some specific NICs. This will take effect after a "
"machine reboot or re-configure of each interface."
msgstr ""
"Bật tùy chọn này sẽ vô hiệu hóa tính năng tắt phân đoạn TCP phần cứng (TSO, "
"TSO4, TSO6). Một số trình điều khiển phần cứng có thể gặp lỗi với tính năng "
"này, ảnh hưởng đến hiệu suất của một số card mạng cụ thể. Thay đổi này sẽ có "
"hiệu lực sau khi khởi động lại hoặc cấu hình lại từng giao diện."

#: src/usr/local/www/system_advanced_network.php:243
msgid "Hardware Large Receive Offloading"
msgstr "Tắt tải nhận dữ liệu lớn phần cứng"

#: src/usr/local/www/system_advanced_network.php:246
msgid ""
"Checking this option will disable hardware large receive offloading (LRO). "
"This offloading is broken in some hardware drivers, and may impact "
"performance with some specific NICs. This will take effect after a machine "
"reboot or re-configure of each interface."
msgstr ""
"Kích hoạt tùy chọn này sẽ vô hiệu hóa tính năng giảm tải nhận lớn (LRO) của phần cứng. "
"Tính năng này bị lỗi trên một số trình điều khiển phần cứng và có thể ảnh hưởng "
"đến hiệu suất của một số card mạng (NIC) cụ thể. Thay đổi này sẽ có hiệu lực sau khi "
"máy khởi động lại hoặc cấu hình lại từng giao diện mạng."

#: src/usr/local/www/system_advanced_network.php:253
msgid "hn ALTQ support"
msgstr "Hỗ trợ hn ALTQ"

#: src/usr/local/www/system_advanced_network.php:256
msgid ""
"Checking this option will enable the ALTQ support for hn NICs. The ALTQ "
"support disables the multiqueue API and may reduce the system capability to "
"handle traffic. This will take effect after a machine reboot."
msgstr ""
"Kích hoạt tùy chọn này sẽ bật hỗ trợ ALTQ cho card mạng hn. Việc hỗ trợ ALTQ "
"sẽ vô hiệu hóa API đa hàng đợi và có thể làm giảm khả năng xử lý lưu lượng của hệ thống. "
"Thay đổi này sẽ có hiệu lực sau khi máy khởi động lại."

