#: src/usr/local/www/services_unbound_advanced.php:128
msgid "A valid value for Message Cache Size must be specified."
msgstr "Cần chỉ định một giá trị hợp lệ cho Kích thước bộ nhớ đệm tin nhắn."

#: src/usr/local/www/services_unbound_advanced.php:131
msgid "A valid value must be specified for Outgoing TCP Buffers."
msgstr "Cần chỉ định một giá trị hợp lệ cho Bộ đệm TCP gửi đi."

#: src/usr/local/www/services_unbound_advanced.php:134
msgid "A valid value must be specified for Incoming TCP Buffers."
msgstr "Cần chỉ định một giá trị hợp lệ cho Bộ đệm TCP đến."

#: src/usr/local/www/services_unbound_advanced.php:137
msgid "A valid value must be specified for EDNS Buffer Size."
msgstr "Cần chỉ định một giá trị hợp lệ cho Kích thước bộ đệm EDNS."

#: src/usr/local/www/services_unbound_advanced.php:140
msgid "A valid value must be specified for Number of Queries per Thread."
msgstr "Cần chỉ định một giá trị hợp lệ cho Số lượng truy vấn trên mỗi luồng."

#: src/usr/local/www/services_unbound_advanced.php:143
msgid "A valid value must be specified for Jostle Timeout."
msgstr "Cần chỉ định một giá trị hợp lệ cho Thời gian chờ Jostle."

#: src/usr/local/www/services_unbound_advanced.php:146
msgid "'Maximum TTL for RRsets and Messages' must be a positive integer."
msgstr "'TTL tối đa cho RRsets và Tin nhắn' phải là một số nguyên dương."

#: src/usr/local/www/services_unbound_advanced.php:149
msgid "'Minimum TTL for RRsets and Messages' must be a positive integer."
msgstr "'TTL tối thiểu cho RRsets và Tin nhắn' phải là một số nguyên dương."

#: src/usr/local/www/services_unbound_advanced.php:152
msgid "A valid value must be specified for TTL for Host Cache Entries."
msgstr "Cần chỉ định một giá trị hợp lệ cho TTL của các mục bộ nhớ đệm máy chủ."

#: src/usr/local/www/services_unbound_advanced.php:155
msgid "A valid value must be specified for Number of Hosts to Cache."
msgstr "Cần chỉ định một giá trị hợp lệ cho Số lượng máy chủ cần lưu vào bộ đệm."

#: src/usr/local/www/services_unbound_advanced.php:158
msgid "A valid value must be specified for Unwanted Reply Threshold."
msgstr "Cần chỉ định một giá trị hợp lệ cho Ngưỡng phản hồi không mong muốn."

#: src/usr/local/www/services_unbound_advanced.php:161
msgid "A valid value must be specified for Log Level."
msgstr "Cần chỉ định một giá trị hợp lệ cho Mức ghi nhật ký."

#: src/usr/local/www/services_unbound_advanced.php:164
msgid "Harden DNSSEC Data option can only be enabled if DNSSEC support is enabled."
msgstr "Tùy chọn Củng cố dữ liệu DNSSEC chỉ có thể được bật nếu hỗ trợ DNSSEC được kích hoạt."

#: src/usr/local/www/services_unbound_advanced.php:167
msgid "DNS64 Prefix must be valid IPv6 prefix."
msgstr "Tiền tố DNS64 phải là một tiền tố IPv6 hợp lệ."

#: src/usr/local/www/services_unbound_advanced.php:171
msgid "DNS64 subnet must be not more than 96 and not less than 1."
msgstr "Mạng con DNS64 không được lớn hơn 96 và không nhỏ hơn 1."

#: src/usr/local/www/services_unbound_advanced.php:291
msgid "Advanced Privacy Options"
msgstr "Tùy chọn bảo mật nâng cao"

#: src/usr/local/www/services_unbound_advanced.php:295
msgid "Hide Identity"
msgstr "Ẩn danh tính"

#: src/usr/local/www/services_unbound_advanced.php:302
msgid "Hide Version"
msgstr "Ẩn phiên bản"

#: src/usr/local/www/services_unbound_advanced.php:309
msgid "Query Name Minimization"
msgstr "Giảm thiểu tên truy vấn"

#: src/usr/local/www/services_unbound_advanced.php:312
#, php-format
msgid ""
"Only send minimum required labels of the QNAME and set QTYPE to A when "
"possible. Best effort approach; full QNAME and original QTYPE will be sent "
"when upstream replies with a RCODE other than NOERROR, except when receiving "
"NXDOMAIN from a DNSSEC signed zone. Default is off.%1$s Refer to %2$sRFC "
"7816%3$s for in-depth information on Query Name Minimization."
msgstr ""
"Chỉ gửi các nhãn cần thiết tối thiểu của QNAME và đặt QTYPE thành A khi có thể. "
"Cách tiếp cận tốt nhất có thể; QNAME đầy đủ và QTYPE gốc sẽ được gửi khi máy chủ "
"thượng nguồn phản hồi với mã RCODE khác NOERROR, ngoại trừ khi nhận NXDOMAIN "
"từ một vùng đã ký DNSSEC. Mặc định là tắt.%1$s Tham khảo %2$sRFC 7816%3$s để biết "
"thông tin chi tiết về Giảm thiểu tên truy vấn."

#: src/usr/local/www/services_unbound_advanced.php:316
msgid "Strict Query Name Minimization"
msgstr "Giảm thiểu tên truy vấn nghiêm ngặt"

#: src/usr/local/www/services_unbound_advanced.php:319
#, php-format
msgid ""
"QNAME minimization in strict mode. %1$sA significant number of domains will "
"fail to resolve when this option in enabled%2$s. Only use if you know what "
"you are doing. This option only has effect when Query Name Minimization is "
"enabled. Default is off."
msgstr ""
"Giảm thiểu tên truy vấn ở chế độ nghiêm ngặt. %1$sMột số lượng lớn tên miền sẽ "
"không thể phân giải khi bật tùy chọn này%2$s. Chỉ sử dụng nếu bạn biết rõ mình "
"đang làm gì. Tùy chọn này chỉ có hiệu lực khi Giảm thiểu tên truy vấn được bật. "
"Mặc định là tắt."

#: src/usr/local/www/services_unbound_advanced.php:323
msgid "Advanced Resolver Options"
msgstr "Tùy chọn phân giải nâng cao"

#: src/usr/local/www/services_unbound_advanced.php:327
msgid "Prefetch Support"
msgstr "Hỗ trợ tải trước"

#: src/usr/local/www/services_unbound_advanced.php:330
msgid ""
"When enabled, this option can cause an increase of around 10% more DNS "
"traffic and load on the server, but frequently requested items will not "
"expire from the cache."
msgstr ""
"Khi được bật, tùy chọn này có thể làm tăng khoảng 10% lưu lượng DNS và tải trên "
"máy chủ, nhưng các mục được yêu cầu thường xuyên sẽ không hết hạn trong bộ đệm."

#: src/usr/local/www/services_unbound_advanced.php:334
msgid "Prefetch DNS Key Support"
msgstr "Hỗ trợ tải trước khóa DNS"

#: src/usr/local/www/services_unbound_advanced.php:337
#, php-format
msgid ""
"This helps lower the latency of requests but does utilize a little more CPU. "
"See: %1$sWikipedia%2$s"
msgstr ""
"Điều này giúp giảm độ trễ của các yêu cầu nhưng sử dụng nhiều CPU hơn một chút. "
"Xem: %1$sWikipedia%2$s"

#: src/usr/local/www/services_unbound_advanced.php:341
msgid "Harden DNSSEC Data"
msgstr "Củng cố dữ liệu DNSSEC"

#: src/usr/local/www/services_unbound_advanced.php:344
msgid ""
"If such data is absent, the zone becomes bogus. If Disabled and no DNSSEC "
"data is received, then the zone is made insecure."
msgstr ""
"Nếu dữ liệu này bị thiếu, vùng sẽ trở thành giả mạo. Nếu bị vô hiệu hóa và không "
"nhận được dữ liệu DNSSEC, thì vùng sẽ không an toàn."

#: src/usr/local/www/services_unbound_advanced.php:348
msgid "Serve Expired"
msgstr "Phục vụ khi hết hạn"

#: src/usr/local/www/services_unbound_advanced.php:351
msgid ""
"When enabled, allows unbound to serve one query even with a TTL of 0, if TTL "
"is 0 then new record will be requested in the background when the cache is "
"served to ensure cache is updated without latency on service of the DNS "
"request."
msgstr ""
"Khi được bật, cho phép unbound phục vụ một truy vấn ngay cả khi TTL bằng 0. "
"Nếu TTL là 0, một bản ghi mới sẽ được yêu cầu trong nền khi bộ nhớ cache được "
"phục vụ để đảm bảo bộ nhớ cache được cập nhật mà không có độ trễ trong quá trình "
"xử lý yêu cầu DNS."

#: src/usr/local/www/services_unbound_advanced.php:355
msgid "Aggressive NSEC"
msgstr "NSEC tích cực"

#: src/usr/local/www/services_unbound_advanced.php:358
msgid ""
"When enabled, unbound uses the DNSSEC NSEC chain to synthesize NXDOMAIN and "
"other denials, using information from previous NXDOMAINs answers. It helps "
"to reduce the query rate towards targets that get a very high nonexistent "
"name lookup rate."
msgstr ""
"Khi được bật, unbound sử dụng chuỗi DNSSEC NSEC để tạo ra NXDOMAIN và các từ "
"chối khác, dựa trên thông tin từ các phản hồi NXDOMAIN trước đó. Điều này giúp "
"giảm tần suất truy vấn đến các mục tiêu có tỷ lệ tra cứu tên không tồn tại cao."

#: src/usr/local/www/services_unbound_advanced.php:364
msgid "Message Cache Size"
msgstr "Kích thước bộ nhớ đệm tin nhắn"

#: src/usr/local/www/services_unbound_advanced.php:367
msgid ""
"Size of the message cache. The message cache stores DNS response codes and "
"validation statuses. The Resource Record Set (RRSet) cache will "
"automatically be set to twice this amount. The RRSet cache contains the "
"actual RR data. The default is 4 megabytes."
msgstr ""
"Kích thước bộ nhớ đệm tin nhắn. Bộ nhớ đệm tin nhắn lưu trữ các mã phản hồi DNS "
"và trạng thái xác thực. Bộ nhớ đệm RRSet (Resource Record Set) sẽ tự động được "
"thiết lập gấp đôi kích thước này. Bộ nhớ đệm RRSet chứa dữ liệu RR thực tế. Mặc "
"định là 4MB."

#: src/usr/local/www/services_unbound_advanced.php:371
msgid "Outgoing TCP Buffers"
msgstr "Bộ đệm TCP gửi đi"

#: src/usr/local/www/services_unbound_advanced.php:374
msgid ""
"The number of outgoing TCP buffers to allocate per thread. The default value "
"is 10. If 0 is selected then TCP queries are not sent to authoritative "
"servers."
msgstr ""
"Số lượng bộ đệm TCP gửi đi được cấp phát cho mỗi luồng. Giá trị mặc định là 10. "
"Nếu chọn 0, thì các truy vấn TCP sẽ không được gửi đến các máy chủ có thẩm quyền."

#: src/usr/local/www/services_unbound_advanced.php:378
msgid "Incoming TCP Buffers"
msgstr "Bộ đệm TCP nhận vào"

#: src/usr/local/www/services_unbound_advanced.php:381
msgid ""
"The number of incoming TCP buffers to allocate per thread. The default value "
"is 10. If 0 is selected then TCP queries are not accepted from clients."
msgstr ""
"Số lượng bộ đệm TCP nhận vào được cấp phát cho mỗi luồng. Giá trị mặc định là 10. "
"Nếu chọn 0, thì các truy vấn TCP từ khách hàng sẽ không được chấp nhận."

#: src/usr/local/www/services_unbound_advanced.php:385
msgid "EDNS Buffer Size"
msgstr "Kích thước bộ đệm EDNS"

#: src/usr/local/www/services_unbound_advanced.php:389
#, php-format
msgid ""
"Number of bytes size to advertise as the EDNS reassembly buffer size. This "
"is the value that is used in UDP datagrams sent to peers.%1$sAuto mode sets "
"optimal buffer size by using the smallest MTU of active interfaces and "
"subtracting the IPv4/IPv6 header size.%1$sIf fragmentation reassemble "
"problems occur, usually seen as timeouts, then a value of 1432 should help."
"%1$sThe 512/1232 values bypasses most IPv4/IPv6 MTU path problems, but it "
"can generate an excessive amount of TCP fallback."
msgstr ""
"Số byte được quảng bá là kích thước bộ đệm tái lắp ráp EDNS. Đây là giá trị được "
"sử dụng trong các gói UDP gửi đến các máy ngang hàng.%1$sChế độ tự động thiết lập "
"kích thước bộ đệm tối ưu bằng cách sử dụng MTU nhỏ nhất của các giao diện đang "
"hoạt động và trừ đi kích thước tiêu đề IPv4/IPv6.%1$sNếu xảy ra sự cố tái lắp "
"ráp phân mảnh, thường thấy dưới dạng hết thời gian chờ, thì giá trị 1432 có thể "
"giúp khắc phục.%1$sCác giá trị 512/1232 giúp tránh hầu hết các sự cố đường dẫn "
"MTU của IPv4/IPv6, nhưng có thể tạo ra lượng lớn truy vấn dự phòng qua TCP."

#: src/usr/local/www/services_unbound_advanced.php:396
msgid "Number of Queries per Thread"
msgstr "Số lượng truy vấn trên mỗi luồng"

#: src/usr/local/www/services_unbound_advanced.php:399
msgid ""
"The number of queries that every thread will service simultaneously. If more "
"queries arrive that need to be serviced, and no queries can be jostled, then "
"these queries are dropped."
msgstr ""
"Số lượng truy vấn mà mỗi luồng có thể xử lý đồng thời. Nếu có nhiều truy vấn "
"đến hơn số lượng có thể xử lý và không thể đẩy lùi truy vấn nào, thì các truy "
"vấn này sẽ bị loại bỏ."

#: src/usr/local/www/services_unbound_advanced.php:403
msgid "Jostle Timeout"
msgstr "Thời gian chờ đẩy lùi"

#: src/usr/local/www/services_unbound_advanced.php:406
msgid ""
"This timeout is used for when the server is very busy. This protects against "
"denial of service by slow queries or high query rates. The default value is "
"200 milliseconds. "
msgstr ""
"Thời gian chờ này được sử dụng khi máy chủ quá tải. Nó giúp bảo vệ khỏi các "
"cuộc tấn công từ chối dịch vụ do truy vấn chậm hoặc tần suất truy vấn cao. "
"Giá trị mặc định là 200 mili-giây."

#: src/usr/local/www/services_unbound_advanced.php:410
msgid "Maximum TTL for RRsets and Messages"
msgstr "TTL tối đa cho RRsets và tin nhắn"

#: src/usr/local/www/services_unbound_advanced.php:413
msgid ""
"The Maximum Time to Live for RRsets and messages in the cache. The default "
"is 86400 seconds (1 day). When the internal TTL expires the cache item is "
"expired. This can be configured to force the resolver to query for data more "
"often and not trust (very large) TTL values."
msgstr ""
"Thời gian tồn tại tối đa cho RRsets và tin nhắn trong bộ nhớ đệm. Giá trị "
"mặc định là 86400 giây (1 ngày). Khi TTL nội bộ hết hạn, mục trong bộ nhớ đệm "
"cũng sẽ hết hạn. Cấu hình này có thể buộc bộ phân giải truy vấn dữ liệu "
"thường xuyên hơn và không tin tưởng vào các giá trị TTL quá lớn."

#: src/usr/local/www/services_unbound_advanced.php:418
msgid "Minimum TTL for RRsets and Messages"
msgstr "TTL tối thiểu cho RRsets và tin nhắn"

#: src/usr/local/www/services_unbound_advanced.php:421
msgid ""
"The Minimum Time to Live for RRsets and messages in the cache. The default "
"is 0 seconds. If the minimum value kicks in, the data is cached for longer "
"than the domain owner intended, and thus less queries are made to look up "
"the data. The 0 value ensures the data in the cache is as the domain owner "
"intended. High values can lead to trouble as the data in the cache might not "
"match up with the actual data anymore."
msgstr ""
"Thời gian tồn tại tối thiểu cho RRsets và tin nhắn trong bộ nhớ đệm. Giá trị "
"mặc định là 0 giây. Nếu giá trị tối thiểu có hiệu lực, dữ liệu sẽ được lưu "
"trong bộ nhớ đệm lâu hơn so với dự định của chủ sở hữu miền, dẫn đến ít truy "
"vấn tìm kiếm dữ liệu hơn. Giá trị 0 đảm bảo rằng dữ liệu trong bộ nhớ đệm "
"phù hợp với ý định của chủ sở hữu miền. Giá trị quá cao có thể gây ra vấn đề "
"vì dữ liệu trong bộ nhớ đệm có thể không còn khớp với dữ liệu thực tế."

#: src/usr/local/www/services_unbound_advanced.php:425
msgid "minutes"
msgstr "phút"

#: src/usr/local/www/services_unbound_advanced.php:428
msgid "TTL for Host Cache Entries"
msgstr "TTL cho các mục bộ nhớ đệm của máy chủ"

#: src/usr/local/www/services_unbound_advanced.php:431
msgid ""
"Time to Live, in seconds, for entries in the infrastructure host cache. The "
"infrastructure host cache contains round trip timing, lameness, and EDNS "
"support information for DNS servers. The default value is 15 minutes."
msgstr ""
"Thời gian tồn tại (TTL), tính bằng giây, cho các mục trong bộ nhớ đệm máy chủ "
"hạ tầng. Bộ nhớ đệm máy chủ hạ tầng chứa thông tin về thời gian khứ hồi, độ "
"bất ổn và hỗ trợ EDNS cho các máy chủ DNS. Giá trị mặc định là 15 phút."

#: src/usr/local/www/services_unbound_advanced.php:435
msgid "Number of Hosts to Cache"
msgstr "Số lượng máy chủ được lưu vào bộ nhớ đệm"

#: src/usr/local/www/services_unbound_advanced.php:438
msgid ""
"Number of infrastructure hosts for which information is cached. The default "
"is 10,000."
msgstr ""
"Số lượng máy chủ hạ tầng mà thông tin của chúng được lưu vào bộ nhớ đệm. Giá trị "
"mặc định là 10.000."

#: src/usr/local/www/services_unbound_advanced.php:440
msgid "million"
msgstr "triệu"

#: src/usr/local/www/services_unbound_advanced.php:443
msgid "Unwanted Reply Threshold"
msgstr "Ngưỡng phản hồi không mong muốn"

#: src/usr/local/www/services_unbound_advanced.php:447  
msgid ""  
"If enabled, a total number of unwanted replies is kept track of in every "  
"thread. When it reaches the threshold, a defensive action is taken and a "  
"warning is printed to the log file. This defensive action is to clear the "  
"RRSet and message caches, hopefully flushing away any poison. The default is "  
"disabled, but if enabled a value of 10 million is suggested."  
msgstr ""  
"Nếu được bật, tổng số phản hồi không mong muốn sẽ được theo dõi trong mỗi "  
"luồng. Khi đạt đến ngưỡng, một hành động phòng thủ sẽ được thực hiện và một "  
"cảnh báo sẽ được ghi vào tệp nhật ký. Hành động phòng thủ này là xóa bộ nhớ "  
"đệm RRSet và tin nhắn, hy vọng sẽ loại bỏ bất kỳ dữ liệu độc hại nào. Giá trị "  
"mặc định là tắt, nhưng nếu bật, giá trị đề xuất là 10 triệu."  

#: src/usr/local/www/services_unbound_advanced.php:451  
#, php-format  
msgid "Level %s"  
msgstr "Cấp độ %s"  

#: src/usr/local/www/services_unbound_advanced.php:465  
msgid "Log Level"  
msgstr "Mức độ ghi nhật ký"  

#: src/usr/local/www/services_unbound_advanced.php:468  
msgid ""  
"Select the level of detail to be logged. Each level also includes the "  
"information from previous levels. The default is basic operational "  
"information (level 1)"  
msgstr ""  
"Chọn mức độ chi tiết của thông tin được ghi lại. Mỗi cấp độ cũng bao gồm "  
"thông tin từ các cấp độ trước đó. Mặc định là thông tin vận hành cơ bản "  
"(cấp độ 1)."  

#: src/usr/local/www/services_unbound_advanced.php:472  
msgid "Disable Auto-added Access Control"  
msgstr "Tắt kiểm soát truy cập tự động thêm"  

#: src/usr/local/www/services_unbound_advanced.php:475  
msgid ""  
"By default, IPv4 and IPv6 networks residing on internal interfaces of this "  
"system are permitted. Allowed networks must be manually configured on the "  
"Access Lists tab if the auto-added entries are disabled."  
msgstr ""  
"Mặc định, các mạng IPv4 và IPv6 nằm trên các giao diện nội bộ của hệ thống "  
"này được cho phép. Các mạng được phép phải được cấu hình thủ công trong tab "  
"Danh sách Truy cập nếu các mục được thêm tự động bị tắt."  

#: src/usr/local/www/services_unbound_advanced.php:480  
msgid "Disable Auto-added Host Entries"  
msgstr "Tắt các mục nhập máy chủ tự động thêm"  

#: src/usr/local/www/services_unbound_advanced.php:483  
#, php-format  
msgid ""  
"By default, the primary IPv4 and IPv6 addresses of this firewall are added "  
"as records for the system domain of this firewall as configured in "  
"%1$sSystem: General Setup%2$s. This disables the auto generation of these "  
"entries."  
msgstr ""  
"Mặc định, các địa chỉ IPv4 và IPv6 chính của tường lửa này được thêm vào "  
"làm bản ghi cho miền hệ thống của tường lửa này như được cấu hình trong "  
"%1$sHệ thống: Cấu hình chung%2$s. Điều này sẽ tắt tính năng tạo tự động "  
"các mục nhập này."  

#: src/usr/local/www/services_unbound_advanced.php:487  
msgid "Experimental Bit 0x20 Support"  
msgstr "Hỗ trợ thử nghiệm Bit 0x20"  

#: src/usr/local/www/services_unbound_advanced.php:490  
#, php-format  
msgid "See the implementation %1$sdraft dns-0x20%2$s for more information."  
msgstr "Xem bản triển khai %1$sdraft dns-0x20%2$s để biết thêm thông tin."  

#: src/usr/local/www/services_unbound_advanced.php:494  
msgid "DNS64 Support"  
msgstr "Hỗ trợ DNS64"  

#: src/usr/local/www/services_unbound_advanced.php:497  
msgid ""  
"DNS64 is used with an IPv6/IPv4 translator to enable client-server "  
"communication between an IPv6-only client and an IPv4-only servers."  
msgstr ""  
"DNS64 được sử dụng với bộ dịch IPv6/IPv4 để cho phép giao tiếp giữa máy "  
"khách IPv6 và máy chủ chỉ hỗ trợ IPv4."  

#: src/usr/local/www/services_unbound_advanced.php:499  
#: src/usr/local/www/services_unbound_advanced.php:504  
msgid "DNS64 Prefix"  
msgstr "Tiền tố DNS64"  

#: src/usr/local/www/services_unbound_advanced.php:507  
msgid ""  
"IPv6 prefix used by IPv6 representations of IPv4 addresses. If this field is "  
"empty, default 64:ff9b::/96 prefix is used."  
msgstr ""  
"Tiền tố IPv6 được sử dụng để biểu diễn địa chỉ IPv4 dưới dạng IPv6. Nếu "  
"trường này để trống, tiền tố mặc định 64:ff9b::/96 sẽ được sử dụng."  

#: src/usr/local/www/interfaces_gif_edit.php:59  
msgid "gif remote address"  
msgstr "Địa chỉ từ xa GIF"  

#: src/usr/local/www/interfaces_gif_edit.php:59  
msgid "gif tunnel local address"  
msgstr "Địa chỉ cục bộ của đường hầm GIF"  

#: src/usr/local/www/interfaces_gif_edit.php:59  
msgid "gif tunnel remote address"  
msgstr "Địa chỉ từ xa của đường hầm GIF"  

#: src/usr/local/www/interfaces_gif_edit.php:59  
msgid "gif tunnel remote netmask"  
msgstr "Mặt nạ mạng từ xa của đường hầm GIF"  

#: src/usr/local/www/interfaces_gif_edit.php:66  
msgid ""  
"The tunnel local and tunnel remote fields must have valid IP addresses and "  
"must not contain CIDR masks or prefixes."  
msgstr ""  
"Các trường địa chỉ cục bộ và địa chỉ từ xa của đường hầm phải chứa địa chỉ "  
"IP hợp lệ và không được có mặt nạ CIDR hoặc tiền tố."  

#: src/usr/local/www/interfaces_gif_edit.php:70  
msgid "The gif tunnel subnet must be an integer."  
msgstr "Mạng con của đường hầm GIF phải là một số nguyên."  

#: src/usr/local/www/interfaces_gif_edit.php:75  
msgid ""  
"The gif tunnel remote address must be IPv4 where tunnel local address is "  
"IPv4."  
msgstr ""  
"Địa chỉ từ xa của đường hầm GIF phải là IPv4 nếu địa chỉ cục bộ của đường "  
"hầm là IPv4."  

#: src/usr/local/www/interfaces_gif_edit.php:78  
msgid "The gif tunnel subnet must be an integer between 1 and 32."  
msgstr "Mạng con của đường hầm GIF phải là một số nguyên từ 1 đến 32."  

#: src/usr/local/www/interfaces_gif_edit.php:84  
msgid ""  
"The gif tunnel remote address must be IPv6 where tunnel local address is "  
"IPv6."  
msgstr ""  
"Địa chỉ từ xa của đường hầm GIF phải là IPv6 nếu địa chỉ cục bộ của đường "  
"hầm là IPv6."  

#: src/usr/local/www/interfaces_gif_edit.php:87  
msgid "The gif tunnel subnet must be an integer between 1 and 128."  
msgstr "Mạng con của đường hầm GIF phải là một số nguyên từ 1 đến 128."  

#: src/usr/local/www/interfaces_gif_edit.php:94  
msgid ""  
"The alias IP address family has to match the family of the remote peer "  
"address."  
msgstr ""  
"Loại địa chỉ IP bí danh phải khớp với loại địa chỉ IP của đối tác từ xa."  

#: src/usr/local/www/interfaces_gif_edit.php:104  
#, php-format  
msgid "A gif with the network %s is already defined."  
msgstr "Một đường hầm GIF với mạng %s đã được xác định."  

#: src/usr/local/www/interfaces_gif_edit.php:170  
msgid "GIF Configuration"  
msgstr "Cấu hình GIF"  

#: src/usr/local/www/interfaces_gif_edit.php:177  
msgid ""  
"This interface serves as the local address to be used for the GIF tunnel."  
msgstr ""  
"Giao diện này đóng vai trò là địa chỉ cục bộ được sử dụng cho đường hầm GIF."  

#: src/usr/local/www/interfaces_gif_edit.php:181  
msgid "*GIF Remote Address"  
msgstr "*Địa chỉ từ xa GIF"  

#: src/usr/local/www/interfaces_gif_edit.php:183  
msgid "Peer address where encapsulated gif packets will be sent."  
msgstr ""  
"Địa chỉ đối tác nơi các gói GIF được đóng gói sẽ được gửi đến."  

#: src/usr/local/www/interfaces_gif_edit.php:187  
msgid "*GIF tunnel local address"  
msgstr "*Địa chỉ cục bộ của đường hầm GIF"  

#: src/usr/local/www/interfaces_gif_edit.php:189  
msgid "Local gif tunnel endpoint."  
msgstr "Điểm cuối đường hầm GIF cục bộ."  

#: src/usr/local/www/interfaces_gif_edit.php:193  
msgid "*GIF tunnel remote address"  
msgstr "*Địa chỉ từ xa của đường hầm GIF"  

#: src/usr/local/www/interfaces_gif_edit.php:195  
msgid "Remote GIF address endpoint."  
msgstr "Điểm cuối địa chỉ GIF từ xa."  

#: src/usr/local/www/interfaces_gif_edit.php:199  
msgid "*GIF tunnel subnet"  
msgstr "*Mạng con của đường hầm GIF"  

#: src/usr/local/www/interfaces_gif_edit.php:202  
msgid "The subnet is used for determining the network that is tunnelled."  
msgstr ""  
"Mạng con được sử dụng để xác định mạng nào được truyền qua đường hầm."  

#: src/usr/local/www/interfaces_gif_edit.php:206  
msgid "ECN friendly behavior"  
msgstr "Hành vi tương thích ECN"  

#: src/usr/local/www/interfaces_gif_edit.php:213  
msgid "Outer Source Filtering"  
msgstr "Lọc nguồn bên ngoài"  

#: src/usr/local/www/diag_ndp.php:52  
#, php-format  
msgid "The NDP entry for %s has been deleted."  
msgstr "Mục nhập NDP cho %s đã bị xóa."  

#: src/usr/local/www/diag_ndp.php:53  
#, php-format  
msgid "%s is not a valid IPv6 address or could not be deleted."  
msgstr ""  
"%s không phải là địa chỉ IPv6 hợp lệ hoặc không thể xóa."  

#: src/usr/local/www/diag_ndp.php:61  
msgid "NDP Table has been cleared."  
msgstr "Bảng NDP đã được xóa."  

#: src/usr/local/www/diag_ndp.php:64  
msgid "Unable to clear NDP Table."  
msgstr "Không thể xóa bảng NDP."  

#: src/usr/local/www/diag_ndp.php:165 src/usr/local/www/diag_ndp.php:192  
msgid "Expiration"  
msgstr "Hết hạn"  

#: src/usr/local/www/diag_ndp.php:228  
msgid "Delete NDP entry"  
msgstr "Xóa mục nhập NDP"  

#: src/usr/local/www/diag_ndp.php:242  
