#: src/etc/inc/gwlb.inc:1892
msgid "The low latency threshold needs to be a numeric value."
msgstr "Ngưỡng độ trễ thấp phải là một giá trị số."

#: src/etc/inc/gwlb.inc:1894
msgid "The low latency threshold needs to be positive."
msgstr "Ngưỡng độ trễ thấp phải là một giá trị dương."

#: src/etc/inc/gwlb.inc:1903
msgid "The high latency threshold needs to be a numeric value."
msgstr "Ngưỡng độ trễ cao phải là một giá trị số."

#: src/etc/inc/gwlb.inc:1905
msgid "The high latency threshold needs to be positive."
msgstr "Ngưỡng độ trễ cao phải là một giá trị dương."

#: src/etc/inc/gwlb.inc:1914
msgid "The low Packet Loss threshold needs to be a numeric value."
msgstr "Ngưỡng mất gói thấp phải là một giá trị số."

#: src/etc/inc/gwlb.inc:1916
msgid "The low Packet Loss threshold needs to be positive."
msgstr "Ngưỡng mất gói thấp phải là một giá trị dương."

#: src/etc/inc/gwlb.inc:1918
msgid "The low Packet Loss threshold needs to be less than 100."
msgstr "Ngưỡng mất gói thấp phải nhỏ hơn 100."

#: src/etc/inc/gwlb.inc:1927
msgid "The high Packet Loss threshold needs to be a numeric value."
msgstr "Ngưỡng mất gói cao phải là một giá trị số."

#: src/etc/inc/gwlb.inc:1929
msgid "The high Packet Loss threshold needs to be positive."
msgstr "Ngưỡng mất gói cao phải là một giá trị dương."

#: src/etc/inc/gwlb.inc:1931
msgid "The high Packet Loss threshold needs to be 100 or less."
msgstr "Ngưỡng mất gói cao phải nhỏ hơn hoặc bằng 100."

#: src/etc/inc/gwlb.inc:1940
msgid ""
"The time period over which results are averaged needs to be a numeric value."
msgstr ""
"Khoảng thời gian trong đó kết quả được tính trung bình phải là một giá trị số."

#: src/etc/inc/gwlb.inc:1942
msgid "The time period over which results are averaged needs to be positive."
msgstr ""
"Khoảng thời gian trong đó kết quả được tính trung bình phải là một giá trị dương."

#: src/etc/inc/gwlb.inc:1951
msgid "The probe interval needs to be a numeric value."
msgstr "Khoảng thời gian kiểm tra phải là một giá trị số."

#: src/etc/inc/gwlb.inc:1953
msgid "The probe interval needs to be positive."
msgstr "Khoảng thời gian kiểm tra phải là một giá trị dương."

#: src/etc/inc/gwlb.inc:1962
msgid "The loss interval needs to be a numeric value."
msgstr "Khoảng thời gian mất gói phải là một giá trị số."

#: src/etc/inc/gwlb.inc:1964
msgid "The loss interval setting needs to be positive."
msgstr "Cài đặt khoảng thời gian mất gói phải là một giá trị dương."

#: src/etc/inc/gwlb.inc:1973
msgid "The alert interval needs to be a numeric value."
msgstr "Khoảng thời gian cảnh báo phải là một giá trị số."

#: src/etc/inc/gwlb.inc:1975
msgid "The alert interval setting needs to be positive."
msgstr "Cài đặt khoảng thời gian cảnh báo phải là một giá trị dương."

#: src/etc/inc/gwlb.inc:1983
msgid ""
"The high latency threshold needs to be greater than the low latency "
"threshold"
msgstr ""
"Ngưỡng độ trễ cao phải lớn hơn ngưỡng độ trễ thấp."

#: src/etc/inc/gwlb.inc:1988
msgid ""
"The high packet loss threshold needs to be higher than the low packet loss "
"threshold"
msgstr ""
"Ngưỡng mất gói cao phải cao hơn ngưỡng mất gói thấp."

#: src/etc/inc/gwlb.inc:1994
msgid ""
"The loss interval needs to be greater than or equal to the high latency "
"threshold."
msgstr ""
"Khoảng thời gian mất gói phải lớn hơn hoặc bằng ngưỡng độ trễ cao."

#: src/etc/inc/gwlb.inc:1999
msgid ""
"The time period needs to be greater than twice the probe interval plus the "
"loss interval."
msgstr ""
"Khoảng thời gian phải lớn hơn hai lần khoảng thời gian kiểm tra cộng với khoảng thời gian mất gói."

#: src/etc/inc/gwlb.inc:2005
msgid ""
"The alert interval needs to be greater than or equal to the probe interval."
msgstr ""
"Khoảng thời gian cảnh báo phải lớn hơn hoặc bằng khoảng thời gian kiểm tra."

